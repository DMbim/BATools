<!-- File: BA_Tools/UI/BimHub/Views/BimHubWindow.xaml -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="BA.UI.BimHub.Views.BimHubWindow"
    Title="BA – BIM Hub"
    Width="560"
    MinHeight="400"
    MaxHeight="960"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#0F0F10"
    Foreground="#F2F2F2"
    FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Typography baseline -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
        </Style>

        <!-- Hub tool button -->
        <Style x:Key="HubButton" TargetType="{x:Type Button}">
            <Setter Property="Height"                         Value="40"/>
            <Setter Property="Padding"                        Value="10,0"/>
            <Setter Property="Background"                     Value="#1A1A1C"/>
            <Setter Property="Foreground"                     Value="#E8E8EE"/>
            <Setter Property="BorderBrush"                    Value="#2A2A2E"/>
            <Setter Property="BorderThickness"                Value="1"/>
            <Setter Property="FontSize"                       Value="13"/>
            <Setter Property="Cursor"                         Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"     Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#222226"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity"     Value="0.35"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2A2A2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section card -->
        <Style x:Key="SectionCard" TargetType="{x:Type Border}">
            <Setter Property="Background"      Value="#141416"/>
            <Setter Property="BorderBrush"     Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
        </Style>

        <!-- Section header strip -->
        <Style x:Key="SectionHeader" TargetType="{x:Type Border}">
            <Setter Property="Background"      Value="#111113"/>
            <Setter Property="BorderBrush"     Value="#1E1E22"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="12,8"/>
        </Style>

        <!-- Stat card -->
        <Style x:Key="StatCard" TargetType="{x:Type Border}">
            <Setter Property="Background"      Value="#0F0F10"/>
            <Setter Property="BorderBrush"     Value="#222226"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="10,8"/>
        </Style>

        <!-- Close button -->
        <Style x:Key="CloseButton" TargetType="{x:Type Button}">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Width"           Value="90"/>
            <Setter Property="Background"      Value="#1A1A1C"/>
            <Setter Property="Foreground"      Value="#8A8A92"/>
            <Setter Property="BorderBrush"     Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#222226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header -->
            <RowDefinition Height="Auto"/>
            <!-- health card -->
            <RowDefinition Height="*"/>
            <!-- scrollable sections -->
            <RowDefinition Height="Auto"/>
            <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="BA"
                       FontSize="26" FontWeight="Bold"
                       Foreground="#FFFFFF" Margin="0,0,8,0"/>
            <TextBlock Text="BIM Hub"
                       FontSize="17" Foreground="#8A8A92"
                       VerticalAlignment="Bottom"/>
        </DockPanel>

        <!-- ── Project Health Card ─────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <StackPanel>
                <Border Style="{StaticResource SectionHeader}" CornerRadius="10,10,0,0">
                    <TextBlock Text="PROJECT HEALTH"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#6B6B72"/>
                </Border>

                <Grid Margin="10,10,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="TxtParamsLoaded"
                                       Text="—" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#3DB87A"/>
                            <TextBlock Text="Params loaded"
                                       FontSize="10" Foreground="#6B6B72" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="TxtQaWarnings"
                                       Text="—" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#E8A030"/>
                            <TextBlock Text="QA warnings"
                                       FontSize="10" Foreground="#6B6B72" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="TxtQaErrors"
                                       Text="—" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#E05252"/>
                            <TextBlock Text="QA errors"
                                       FontSize="10" Foreground="#6B6B72" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="TxtTemplateVersion"
                                       Text="—" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#F2F2F2"/>
                            <TextBlock Text="Template ver."
                                       FontSize="10" Foreground="#6B6B72" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Margin="10,8,10,10">
                    <Ellipse x:Name="StatusDot"
                             Width="7" Height="7" Fill="#3DB87A"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtStatusSummary"
                               FontSize="11" Foreground="#8A8A92"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCheckedAt"
                               FontSize="11" Foreground="#6B6B72"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ── Scrollable Sections ─────────────────────────────── -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- STANDARDS ──────────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}" CornerRadius="10,10,0,0">
                            <TextBlock Text="STANDARDS"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#C8A84B"/>
                        </Border>
                        <UniformGrid Columns="2" Margin="10">
                            <Button x:Name="BtnSyncLineStyles"
                                    Style="{StaticResource HubButton}"
                                    Content="Line Style Manager"
                                    Margin="0,0,4,6"
                                    Click="BtnSyncLineStyles_Click"/>
                            <Button x:Name="BtnTextHub"
                                    Style="{StaticResource HubButton}"
                                    Content="Text Hub"
                                    Margin="4,0,0,6"
                                    Click="BtnTextHub_Click"/>
                            <Button x:Name="BtnTransferViewTemplate"
                                    Style="{StaticResource HubButton}"
                                    Content="Transfer View Template"
                                    Margin="0,0,4,0"
                                    Click="BtnTransferViewTemplate_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- FAMILIES ───────────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}" CornerRadius="10,10,0,0">
                            <TextBlock Text="FAMILIES"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#C8A84B"/>
                        </Border>
                        <UniformGrid Columns="2" Margin="10">
                            <Button x:Name="BtnSaveFamilies"
                                    Style="{StaticResource HubButton}"
                                    Content="Save Families"
                                    Margin="0,0,4,6"
                                    Click="BtnSaveFamilies_Click"/>
                            <Button x:Name="BtnSaveToolsHub"
                                    Style="{StaticResource HubButton}"
                                    Content="Save Tools Hub"
                                    Margin="4,0,0,6"
                                    Click="BtnSaveToolsHub_Click"/>
                            <Button x:Name="BtnContentBrowser"
                                    Style="{StaticResource HubButton}"
                                    Content="Content Browser"
                                    Margin="0,0,4,0"
                                    Click="BtnContentBrowser_Click"/>
                            <Button x:Name="BtnFamilyTools"
                                    Style="{StaticResource HubButton}"
                                    Content="Family Tools"
                                    IsEnabled="False"
                                    Margin="4,0,0,0"
                                    Click="BtnFamilyTools_Click"/>
                            <Button x:Name="BtnReportFamilySubcategories"
                                    Style="{StaticResource HubButton}"
                                    Content="Report Family Subcategories"
                                    Margin="0,0,4,0"
                                    Click="BtnReportFamilySubcategories_Click"/>
                            <Button x:Name="BtnSubcategoryManager"
                                    Style="{StaticResource HubButton}"
                                    Content="Subcategory Manager"
                                    Margin="4,0,0,0"
                                    Click="BtnSubcategoryManager_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ROOMS & CLASSIFICATION ─────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}" CornerRadius="10,10,0,0">
                            <TextBlock Text="ROOMS &amp; CLASSIFICATION"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#C8A84B"/>
                        </Border>
                        <UniformGrid Columns="2" Margin="10">
                            <Button x:Name="BtnAreasToRooms"
                                    Style="{StaticResource HubButton}"
                                    Content="Areas → Rooms"
                                    Margin="0,0,4,6"
                                    Click="BtnAreasToRooms_Click"/>
                            <Button x:Name="BtnColourScheme"
                                    Style="{StaticResource HubButton}"
                                    Content="Colour Scheme 2.0"
                                    Margin="4,0,0,6"
                                    Click="BtnColourScheme_Click"/>
                            <Button x:Name="BtnClassifyElements"
                                    Style="{StaticResource HubButton}"
                                    Content="Classify Elements"
                                    Margin="0,0,4,0"
                                    Click="BtnClassifyElements_Click"/>
                            <Button x:Name="BtnRoomClassificationImport"
                                    Style="{StaticResource HubButton}"
                                    Content="Import Room Classification"
                                    Margin="4,0,0,0"
                                    Click="BtnRoomClassificationImport_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- PROJECT ────────────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}" CornerRadius="10,10,0,0">
                            <TextBlock Text="PROJECT"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#C8A84B"/>
                        </Border>
                        <UniformGrid Columns="2" Margin="10">
                            <Button x:Name="BtnProjectMonitor"
                                    Style="{StaticResource HubButton}"
                                    Content="Project Monitor"
                                    Margin="0,0,4,6"
                                    Click="BtnProjectMonitor_Click"/>
                            <Button x:Name="BtnQaCenter"
                                    Style="{StaticResource HubButton}"
                                    Content="QA Center"
                                    Margin="4,0,0,6"
                                    Click="BtnQaCenter_Click"/>
                            <Button x:Name="BtnTemplateChecker"
                                    Style="{StaticResource HubButton}"
                                    Content="Template Checker"
                                    Margin="0,0,4,6"
                                    Click="BtnTemplateChecker_Click"/>
                            <Button x:Name="BtnScopeBoxManager"
                                    Style="{StaticResource HubButton}"
                                    Content="Scope Box Manager"
                                    Margin="4,0,0,6"
                                    Click="BtnScopeBoxManager_Click"/>
                            <Button x:Name="BtnCleanUp"
                                    Style="{StaticResource HubButton}"
                                    Content="Clean up &amp; Maintenance"
                                    IsEnabled="False"
                                    Margin="0,0,4,0"
                                    Click="BtnCleanUp_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- OUTCOME ────────────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}" CornerRadius="10,10,0,0">
                            <TextBlock Text="OUTCOME"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#C8A84B"/>
                        </Border>
                        <UniformGrid Columns="2" Margin="10">
                            <Button x:Name="BtnExportSchedule"
                                    Style="{StaticResource HubButton}"
                                    Content="Export Schedule"
                                    Margin="0,0,4,0"
                                    Click="BtnExportSchedule_Click"/>
                            <Button x:Name="BtnImportSchedule"
                                    Style="{StaticResource HubButton}"
                                    Content="Import Schedule"
                                    Margin="4,0,0,0"
                                    Click="BtnImportSchedule_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ISSUE REPORTER ──────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}" CornerRadius="10,10,0,0">
                            <TextBlock Text="ISSUE REPORTER"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#C8A84B"/>
                        </Border>
                        <UniformGrid Columns="2" Margin="10">
                            <Button x:Name="BtnSubmitIssue"
                                    Style="{StaticResource HubButton}"
                                    Content="Submit Issue"
                                    Margin="0,0,4,6"
                                    Click="BtnSubmitIssue_Click"/>
                            <Button x:Name="BtnManageIssues"
                                    Style="{StaticResource HubButton}"
                                    Content="Manage Issues"
                                    Margin="4,0,0,6"
                                    Click="BtnManageIssues_Click"/>
                            <Button x:Name="BtnIssueReporterSettings"
                                    Style="{StaticResource HubButton}"
                                    Content="Issue Reporter Settings"
                                    Margin="0,0,4,0"
                                    Click="BtnIssueReporterSettings_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer ──────────────────────────────────────────── -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource CloseButton}"
                    IsCancel="True"
                    Content="Close"
                    Click="BtnClose_Click"/>
            <TextBlock x:Name="TxtFooterStatus"
                       FontSize="11" Foreground="#4A4A52"
                       VerticalAlignment="Center"/>
        </DockPanel>

    </Grid>
</Window>
