<Window
    x:Class="BATools.SelectionManager.Views.PickFamilyTypeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowStyle="None"
    ResizeMode="CanResize"
    AllowsTransparency="False"
    Width="400" Height="460"
    MinWidth="320" MinHeight="320"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    FontFamily="Segoe UI"
    FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <Style x:Key="FamListItem" TargetType="ListBoxItem">
                <Setter Property="Padding"                    Value="10,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background"                 Value="Transparent"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Brush.WindowFg}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background"
                                Value="{StaticResource Brush.HoverDark}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background"
                                Value="{StaticResource Brush.DarkPanelBg}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource Brush.WindowBg}"
            BorderBrush="{StaticResource Brush.DarkPanelBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <!-- Title bar       -->
                <RowDefinition Height="1"/>
                <!-- Divider         -->
                <RowDefinition Height="Auto"/>
                <!-- Search + filter -->
                <RowDefinition Height="1"/>
                <!-- Divider         -->
                <RowDefinition Height="*"/>
                <!-- List            -->
                <RowDefinition Height="1"/>
                <!-- Divider         -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons         -->
            </Grid.RowDefinitions>

            <!-- ── Title bar ──────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource Brush.ControlBgDark}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="Add Family Type"
                               Foreground="{StaticResource Brush.WindowFg}"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Width="34"
                            Click="Cancel_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource Brush.MutedTextDarkShell}"/>
                                <Setter Property="FontSize"  Value="10"/>
                                <Setter Property="Cursor"    Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" Width="34">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{StaticResource Brush.Warning}"/>
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Brush.WindowFg}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource Brush.DarkPanelBorder}"/>

            <!-- ── Search + category filter ───────────────────────── -->
            <Border Grid.Row="2"
                    Background="{StaticResource Brush.ControlBgDark}"
                    Padding="8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search box -->
                    <TextBox Grid.Row="0"
                             x:Name="TxtSearch"
                             TextChanged="TxtSearch_TextChanged"
                             KeyDown="TxtSearch_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource BaDarkTextBox}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left"
                                                             AlignmentY="Center"
                                                             Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock
                                                            Text="Search family / type / category..."
                                                            Foreground="{StaticResource Brush.DarkPanelBorder}"
                                                            Margin="8,0" FontSize="11"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Category filter pills -->
                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Height="24">
                        <ItemsControl x:Name="CategoryPills">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Pill"
                                            CornerRadius="10"
                                            BorderThickness="1"
                                            Margin="0,0,4,0"
                                            Padding="8,2"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="Pill_Click"
                                            Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{StaticResource Brush.ControlBgDark}"/>
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource Brush.DarkPanelBorder}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource Brush.MutedTextDarkShell}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource Brush.DarkPanelBorder}"/>

            <!-- ── List ───────────────────────────────────────────── -->
            <Grid Grid.Row="4">
                <!-- Loading overlay -->
                <Border Background="{StaticResource Brush.WindowBg}"
                        Visibility="{Binding IsLoading,
                            RelativeSource={RelativeSource AncestorType=Window},
                            Converter={StaticResource BoolToVisibility}}"
                        Panel.ZIndex="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Loading families..."
                                   Foreground="{StaticResource Brush.MutedTextDarkShell}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Reading document..."
                                   Foreground="{StaticResource Brush.DarkPanelBorder}"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ListBox x:Name="FamilyList"
                         Background="{StaticResource Brush.WindowBg}"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource FamListItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="FamilyList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <!-- Icon     -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Names    -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Category -->
                                </Grid.ColumnDefinitions>

                                <!-- Icon placeholder -->
                                <Border Grid.Column="0"
                                        Width="20" Height="20"
                                        Background="{StaticResource Brush.DarkPanelBg}"
                                        BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IconChar}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource Brush.MutedTextDarkShell}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Family : Type -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Margin="6,0,0,0">
                                    <TextBlock Text="{Binding FamilyName}"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.WindowFg}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TypeName}"
                                               FontSize="9"
                                               Foreground="{StaticResource Brush.MutedTextDarkShell}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Category badge -->
                                <Border Grid.Column="2"
                                        Background="{StaticResource Brush.DarkPanelBg}"
                                        BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="5,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryName}"
                                               FontSize="9"
                                               Foreground="{StaticResource Brush.MutedTextDarkShell}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Row="5" Background="{StaticResource Brush.DarkPanelBorder}"/>

            <!-- ── Result count + buttons ─────────────────────────── -->
            <Border Grid.Row="6"
                    Background="{StaticResource Brush.ControlBgDark}"
                    Padding="12,10">
                <DockPanel>
                    <TextBlock x:Name="TxtCount"
                               DockPanel.Dock="Left"
                               Foreground="{StaticResource Brush.MutedTextDarkShell}"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Width="80"
                                Style="{StaticResource BaSecondaryButton}"
                                Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button Content="Add"
                                Width="80"
                                Style="{StaticResource BaPrimaryButton}"
                                Click="Ok_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>