<Window
    x:Class="BATools.SelectionManager.Views.QuickToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:BATools.SelectionManager.ViewModels"
    xmlns:conv="clr-namespace:BATools.SelectionManager.Converters"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    Width="240"
    SizeToContent="Height"
    MaxHeight="540"
    ResizeMode="CanResize"
    FontFamily="Segoe UI"
    FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter          x:Key="BoolToVisibility"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <conv:BoolToExpandArrowConverter       x:Key="BoolToArrow"/>

            <!-- ══ TAB BUTTON ══════════════════════════════════════════════ -->
            <Style x:Key="TabBtn" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource Brush.MutedTextDarkShell}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="10,6"/>
                <Setter Property="FontSize"        Value="11"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent"
                                    BorderThickness="0,0,0,2"
                                    BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource Brush.HoverDark}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource Brush.WindowFg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ MINI BUTTON ▲ ▼ + ✕ ⚙ ══════════════════════════════════ -->
            <Style x:Key="MiniBtn" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource Brush.MutedTextDarkShell}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width"           Value="20"/>
                <Setter Property="Height"          Value="20"/>
                <Setter Property="Padding"         Value="0"/>
                <Setter Property="FontSize"        Value="10"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource Brush.HoverDark}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource Brush.WindowFg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.25"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ CIRCLE BUTTON (add / remove pinned) ════════════════════ -->
            <Style x:Key="CircleBtn" TargetType="Button">
                <Setter Property="Width"           Value="14"/>
                <Setter Property="Height"          Value="14"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Ellipse x:Name="E" Fill="{TemplateBinding Background}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="E" Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="E" Property="Opacity" Value="0.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="E" Property="Opacity" Value="0.25"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ PINNED BUTTON (40×40) ═══════════════════════════════════ -->
            <Style x:Key="PinnedBtn" TargetType="Button">
                <Setter Property="Width"           Value="40"/>
                <Setter Property="Height"          Value="40"/>
                <Setter Property="Background"      Value="{StaticResource Brush.ControlBgDark}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource Brush.DarkPanelBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin"          Value="2"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    CornerRadius="{StaticResource CornerRadius.Panel}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="3">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource Brush.HoverDark}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{StaticResource Brush.WindowFg}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource Brush.WindowBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ FUNCTION ROW BUTTON ═════════════════════════════════════ -->
            <Style x:Key="FuncBtn" TargetType="Button">
                <Setter Property="Background"                 Value="Transparent"/>
                <Setter Property="BorderThickness"            Value="0"/>
                <Setter Property="HorizontalAlignment"        Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding"                    Value="10,5"/>
                <Setter Property="Cursor"                     Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource Brush.HoverDark}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource Brush.ControlBgDark}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════════
                 IMPLICIT DATA TEMPLATES
                 ContentPresenter picks template by runtime type of SelectedTab
                 ══════════════════════════════════════════════════════════════ -->

            <!-- ── Functions tab ──────────────────────────────────────────── -->
            <DataTemplate DataType="{x:Type vm:ToolbarTabViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- PINNED AREA -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.ControlBgDark}"
                            BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                            BorderThickness="0,0,0,1"
                            MinHeight="56" Padding="8,8">
                        <Grid>
                            <!-- Small + overlay in top-right corner of pinned area -->
                            <Button Content="＋"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,0,2,0"
                                    FontSize="11"
                                    Width="18" Height="18"
                                    Panel.ZIndex="1"
                                    Command="{Binding AddToPinnedCommand}"
                                    ToolTip="Add function to pinned area">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource MiniBtn}">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource Brush.MutedTextDarkShell}"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ListBox ItemsSource="{Binding PinnedButtons}"
                                     SelectedItem="{Binding SelectedPinned, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="0"
                                     SelectionMode="Single">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding"    Value="0"/>
                                        <Setter Property="Margin"     Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Sel"
                                                            CornerRadius="{StaticResource CornerRadius.Panel}"
                                                            BorderThickness="1"
                                                            BorderBrush="Transparent"
                                                            Margin="1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Sel" Property="BorderBrush"
                                                                    Value="{StaticResource Brush.WindowFg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QuickActionButtonViewModel}">
                                        <Button Style="{StaticResource PinnedBtn}"
                                                Command="{Binding ExecuteCommand}"
                                                IsEnabled="{Binding IsEnabled}"
                                                ToolTip="{Binding Label}">
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="8"
                                                       Foreground="{StaticResource Brush.WindowFg}"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       MaxWidth="34"/>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No pinned functions"
                                       FontSize="9"
                                       Foreground="{StaticResource Brush.DarkPanelBorder}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PinnedButtons.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- ●● ADD / REMOVE PINNED ROW -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Brush.WindowBg}"
                            BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource CircleBtn}"
                                    Background="{StaticResource Brush.Warning}"
                                    Command="{Binding RemovePinnedCommand}"
                                    ToolTip="Remove selected pinned function"
                                    Margin="0,0,6,0"/>
                            <Button Style="{StaticResource CircleBtn}"
                                    Background="{StaticResource Brush.Success}"
                                    Command="{Binding AddGroupCommand}"
                                    ToolTip="Add new group"
                                    Margin="0,0,6,0"/>
                            <Button Style="{StaticResource CircleBtn}"
                                    Background="{StaticResource Brush.Success}"
                                    Command="{Binding AddToPinnedCommand}"
                                    ToolTip="Add function to pinned area"/>
                        </StackPanel>
                    </Border>

                    <!-- GROUPS LIST -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="{StaticResource Brush.WindowBg}">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ToolbarGroupViewModel}">
                                    <StackPanel>

                                        <!-- Group header -->
                                        <Border Background="{StaticResource Brush.DarkPanelBg}"
                                                BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                                                BorderThickness="0,0,0,1"
                                                Padding="6,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Style="{StaticResource FuncBtn}"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="0"
                                                        Command="{Binding ToggleExpandCommand}">
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding IsExpanded,
                                                                Converter={StaticResource BoolToArrow}}"
                                                            FontSize="9"
                                                            Foreground="{StaticResource Brush.DarkPanelBorder}"
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center"/>
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            Foreground="{StaticResource Brush.MutedTextDarkShell}"
                                                            VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="▲" Style="{StaticResource MiniBtn}"
                                                            Command="{Binding MoveUpCommand}"
                                                            ToolTip="Move group up" Margin="0,0,1,0"/>
                                                    <Button Content="▼" Style="{StaticResource MiniBtn}"
                                                            Command="{Binding MoveDownCommand}"
                                                            ToolTip="Move group down" Margin="0,0,1,0"/>
                                                    <Button Content="+" Style="{StaticResource MiniBtn}"
                                                            Command="{Binding AddFunctionCommand}"
                                                            ToolTip="Add function to group"
                                                            FontSize="13"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Function items -->
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      Visibility="{Binding IsExpanded,
                                                          Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:QuickActionButtonViewModel}">
                                                    <Border x:Name="ItemRow" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0"
                                                                    Style="{StaticResource FuncBtn}"
                                                                    Command="{Binding ExecuteCommand}"
                                                                    IsEnabled="{Binding IsEnabled}"
                                                                    ToolTip="{Binding Label}">
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <Border Width="20" Height="20"
                                                                            Background="{StaticResource Brush.DarkPanelBg}"
                                                                            BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="3"
                                                                            Margin="0,0,8,0">
                                                                        <TextBlock
                                                                            Text="{Binding IconChar}"
                                                                            FontSize="9" FontWeight="Bold"
                                                                            Foreground="{StaticResource Brush.MutedTextDarkShell}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock
                                                                        Text="{Binding Label}"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource Brush.WindowFg}"
                                                                        VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- ✕ remove — appears on row hover -->
                                                            <Button Grid.Column="1"
                                                                    Content="✕"
                                                                    Command="{Binding RemoveCommand}"
                                                                    ToolTip="Remove from group"
                                                                    Margin="0,0,6,0"
                                                                    FontSize="9" Width="20" Height="20">
                                                                <Button.Style>
                                                                    <Style TargetType="Button"
                                                                           BasedOn="{StaticResource MiniBtn}">
                                                                        <Setter Property="Opacity" Value="0"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsMouseOver,
                                                                                    RelativeSource={RelativeSource
                                                                                    AncestorType=Border,
                                                                                    AncestorLevel=1}}"
                                                                                Value="True">
                                                                                <Setter Property="Opacity" Value="1"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DataTemplate>

            <!-- ── Sets tab ───────────────────────────────────────────────── -->
            <DataTemplate DataType="{x:Type vm:SetsToolbarTabViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Save row -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.ControlBgDark}"
                            BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <Button Content="＋  Save Current Selection"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SaveCurrentCommand}"
                                Style="{StaticResource FuncBtn}"
                                Padding="8,5"
                                Foreground="{StaticResource Brush.WindowFg}"/>
                    </Border>

                    <!-- Sets list -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="{StaticResource Brush.WindowBg}">
                        <StackPanel>
                            <TextBlock Text="No saved sets"
                                       FontSize="10"
                                       Foreground="{StaticResource Brush.DarkPanelBorder}"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sets.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Sets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SetRowViewModel}">
                                        <Border x:Name="SetRow"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0"
                                                         Width="5" Height="5"
                                                         Fill="{Binding HealthBrush}"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"
                                                         ToolTip="{Binding HealthTooltip}"/>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="0,6,0,6">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontSize="11"
                                                        Foreground="{StaticResource Brush.WindowFg}"
                                                        TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock
                                                        Text="{Binding ElementCount,
                                                               StringFormat='{}{0} element(s)'}"
                                                        FontSize="9"
                                                        Foreground="{StaticResource Brush.MutedTextDarkShell}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,6,0">
                                                    <!-- Recall -->
                                                    <Button Content="↩"
                                                            Command="{Binding RecallCommand}"
                                                            ToolTip="Recall this selection"
                                                            FontSize="13"
                                                            Width="24" Height="24"
                                                            Margin="0,0,2,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button"
                                                                   BasedOn="{StaticResource MiniBtn}">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Brush.WindowFg}"/>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <!-- Delete — appears on row hover -->
                                                    <Button Content="✕"
                                                            Command="{Binding DeleteCommand}"
                                                            ToolTip="Delete set"
                                                            FontSize="9"
                                                            Width="20" Height="20">
                                                        <Button.Style>
                                                            <Style TargetType="Button"
                                                                   BasedOn="{StaticResource MiniBtn}">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger
                                                                        Binding="{Binding IsMouseOver,
                                                                            RelativeSource={RelativeSource
                                                                            AncestorType=Border,
                                                                            AncestorLevel=1}}"
                                                                        Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Status bar -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.ControlBgDark}"
                            BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="8,4">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="9"
                                   Foreground="{StaticResource Brush.MutedTextDarkShell}"/>
                    </Border>
                </Grid>
            </DataTemplate>
            <!-- ── Families tab ──────────────────────────────────────── -->
            <DataTemplate DataType="{x:Type vm:FamiliesToolbarTabViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <!-- Groups list  -->
                        <RowDefinition Height="1"/>
                        <!-- Divider      -->
                        <RowDefinition Height="Auto"/>
                        <!-- Footer       -->
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="{StaticResource Brush.WindowBg}">
                        <StackPanel>

                            <!-- Empty state -->
                            <TextBlock Text="No groups yet — use + to add one"
                                       FontSize="10"
                                       Foreground="{StaticResource Brush.DarkPanelBorder}"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Groups.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Groups -->
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FamilyFavGroupViewModel}">
                                        <StackPanel>

                                            <!-- Group header -->
                                            <Border Background="{StaticResource Brush.DarkPanelBg}"
                                                    BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="6,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Expand + name (or rename editor) -->
                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Command="{Binding ToggleExpandCommand}"
                                                                Style="{StaticResource MiniBtn}"
                                                                Width="14"
                                                                Content="{Binding IsExpanded,
                                                                    Converter={StaticResource BoolToArrow}}"
                                                                FontSize="9"
                                                                Foreground="{StaticResource Brush.DarkPanelBorder}"
                                                                Margin="0,0,4,0"/>

                                                        <!-- Normal name -->
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.MutedTextDarkShell}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsRenaming,
                                                                       Converter={StaticResource InverseBoolToVisibility}}"/>

                                                        <!-- Rename editor -->
                                                        <TextBox Text="{Binding Name,
                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="11"
                                                                 Style="{StaticResource BaDarkTextBox}"
                                                                 Height="20" Padding="4,0" Width="120"
                                                                 Visibility="{Binding IsRenaming,
                                                                     Converter={StaticResource BoolToVisibility}}"
                                                                 LostFocus="GroupRenameBox_LostFocus"
                                                                 KeyDown="GroupRenameBox_KeyDown"
                                                                 Tag="{Binding}"/>
                                                    </StackPanel>

                                                    <!-- ▲ ▼ ✎ + controls -->
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Content="▲" Style="{StaticResource MiniBtn}"
                                                                Command="{Binding MoveUpCommand}"
                                                                ToolTip="Move group up"
                                                                Margin="0,0,1,0"/>
                                                        <Button Content="▼" Style="{StaticResource MiniBtn}"
                                                                Command="{Binding MoveDownCommand}"
                                                                ToolTip="Move group down"
                                                                Margin="0,0,1,0"/>
                                                        <Button Content="✎" Style="{StaticResource MiniBtn}"
                                                                Command="{Binding BeginRenameCommand}"
                                                                ToolTip="Rename group"
                                                                FontSize="11"
                                                                Margin="0,0,1,0"/>
                                                        <Button Content="+" Style="{StaticResource MiniBtn}"
                                                                Command="{Binding AddFamilyCommand}"
                                                                ToolTip="Add family type to group"
                                                                FontSize="13"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Family entries -->
                                            <ItemsControl ItemsSource="{Binding Entries}"
                                                          Visibility="{Binding IsExpanded,
                                                              Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FamilyTypeEntryViewModel}">
                                                        <Border x:Name="EntryRow"
                                                                Background="Transparent"
                                                                BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Place button (full row) -->
                                                                <Button Grid.Column="0"
                                                                        Style="{StaticResource FuncBtn}"
                                                                        Command="{Binding PlaceCommand}"
                                                                        IsEnabled="{Binding IsAvailable}"
                                                                        ToolTip="{Binding UnavailableTooltip}">
                                                                    <StackPanel Orientation="Horizontal"
                                                                                VerticalAlignment="Center">
                                                                        <!-- Icon -->
                                                                        <Border Width="20" Height="20"
                                                                                Background="{StaticResource Brush.DarkPanelBg}"
                                                                                BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="3"
                                                                                Margin="0,0,8,0">
                                                                            <TextBlock
                                                                                Text="{Binding IconChar}"
                                                                                FontSize="9" FontWeight="Bold"
                                                                                Foreground="{StaticResource Brush.MutedTextDarkShell}"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <!-- Family : Type -->
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock
                                                                                Text="{Binding FamilyName}"
                                                                                FontSize="11"
                                                                                Foreground="{StaticResource Brush.WindowFg}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                MaxWidth="130"/>
                                                                            <TextBlock
                                                                                Text="{Binding TypeName}"
                                                                                FontSize="9"
                                                                                Foreground="{StaticResource Brush.MutedTextDarkShell}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                MaxWidth="130"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- ✕ remove — hover reveal -->
                                                                <Button Grid.Column="1"
                                                                        Content="✕"
                                                                        Command="{Binding RemoveCommand}"
                                                                        ToolTip="Remove from favourites"
                                                                        FontSize="9"
                                                                        Width="20" Height="20"
                                                                        Margin="0,0,6,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button"
                                                                               BasedOn="{StaticResource MiniBtn}">
                                                                            <Setter Property="Opacity" Value="0"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding IsMouseOver,
                                                                                        RelativeSource={RelativeSource
                                                                                        AncestorType=Border,
                                                                                        AncestorLevel=1}}"
                                                                                    Value="True">
                                                                                    <Setter Property="Opacity" Value="1"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Background="{StaticResource Brush.DarkPanelBorder}"/>

                    <!-- Footer: status + Add Group -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.ControlBgDark}"
                            BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                            BorderThickness="0,0,0,0"
                            Padding="8,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="+ Group"
                                    Command="{Binding AddGroupCommand}"
                                    Style="{StaticResource BaSecondaryButton}"
                                    Height="{StaticResource Size.SmallButtonHeight}"
                                    Padding="8,2"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="9"
                                       Foreground="{StaticResource Brush.MutedTextDarkShell}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════ OUTER SHELL -->
    <Border BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius"  Value="{StaticResource CornerRadius.Panel}"/>
                <Setter Property="Background"    Value="{StaticResource Brush.WindowBg}"/>
                <Setter Property="BorderBrush"   Value="{StaticResource Brush.DarkPanelBorder}"/>
                <Style.Triggers>
                    <!-- White outline while frozen — clear B&W feedback -->
                    <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.WindowFg}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Opacity="0.75" ShadowDepth="3" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═════════════════════════════════════════════ TAB STRIP -->
            <Border Grid.Row="0"
                    Background="{StaticResource Brush.ControlBgDark}"
                    BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Command="{Binding DataContext.SelectTabCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource TabBtn}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource Brush.WindowFg}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent"
                                                                            BorderThickness="0,0,0,2"
                                                                            BorderBrush="{StaticResource Brush.WindowFg}"
                                                                            Padding="10,6">
                                                                        <ContentPresenter
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- + ⚙ ✕ -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="4,0,6,0">
                        <Button Content="+" Style="{StaticResource MiniBtn}"
                                Command="{Binding AddTabCommand}"
                                ToolTip="Add new tab"
                                FontSize="14" Margin="0,0,2,0"/>
                        <Button Content="⚙" Style="{StaticResource MiniBtn}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="Toolbar settings"
                                Margin="0,0,4,0"/>
                        <Button Content="✕" Style="{StaticResource MiniBtn}"
                                Command="{Binding DismissCommand}"
                                ToolTip="Close  (Double Shift)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═════════════════════════════════════════ TAB CONTENT -->
            <ContentPresenter Grid.Row="1"
                              Content="{Binding SelectedTab}"
                              MinHeight="80"/>
        </Grid>
    </Border>
</Window>