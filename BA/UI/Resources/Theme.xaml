 <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =========================================================
         BA UI THEME
         Single flat dark theme.
         ========================================================= -->

    <!-- =========================================================
         Brushes
         ========================================================= -->

    <SolidColorBrush x:Key="Brush.WindowBg" Color="#0F0F10"/>
    <SolidColorBrush x:Key="Brush.WindowFg" Color="#F2F2F2"/>

    <SolidColorBrush x:Key="Brush.PanelBg" Color="#17181A"/>
    <SolidColorBrush x:Key="Brush.PanelFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#3A3A3D"/>

    <SolidColorBrush x:Key="Brush.DarkPanelBg" Color="#17181A"/>
    <SolidColorBrush x:Key="Brush.DarkPanelFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.DarkPanelBorder" Color="#3A3A3D"/>

    <SolidColorBrush x:Key="Brush.ControlBg" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Brush.ControlFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#3A3A3D"/>

    <SolidColorBrush x:Key="Brush.ControlBgDark" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Brush.ControlFgDark" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.ControlBorderDark" Color="#3A3A3D"/>

    <SolidColorBrush x:Key="Brush.PrimaryButtonBg" Color="#242426"/>
    <SolidColorBrush x:Key="Brush.PrimaryButtonFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.PrimaryButtonBorder" Color="#55575C"/>

    <SolidColorBrush x:Key="Brush.SecondaryButtonBg" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Brush.SecondaryButtonFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.SecondaryButtonBorder" Color="#3A3A3D"/>

    <SolidColorBrush x:Key="Brush.PanelButtonBg" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Brush.PanelButtonFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.PanelButtonBorder" Color="#3A3A3D"/>

    <SolidColorBrush x:Key="Brush.HoverLight" Color="#2A2C30"/>
    <SolidColorBrush x:Key="Brush.HoverDark" Color="#2A2C30"/>
    <SolidColorBrush x:Key="Brush.Selected" Color="#24466B"/>
    <SolidColorBrush x:Key="Brush.SelectedBorder" Color="#5A8FD6"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#4A8FE0"/>

    <SolidColorBrush x:Key="Brush.MutedTextLightPanel" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush.MutedTextDarkShell" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#E5484D"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#4CAF50"/>

    <SolidColorBrush x:Key="Brush.GridAltRow" Color="#17181A"/>
    <SolidColorBrush x:Key="Brush.GridHeaderBg" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Brush.GridHeaderBorder" Color="#3A3A3D"/>

    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="#0B0C0D"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#3A3A3D"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#55575C"/>

    <!-- =========================================================
         Dimensions
         ========================================================= -->

    <Thickness x:Key="Thickness.WindowMargin">10</Thickness>
    <Thickness x:Key="Thickness.SectionPadding">10</Thickness>
    <CornerRadius x:Key="CornerRadius.Panel">4</CornerRadius>

    <sys:Double x:Key="Size.InputHeight">26</sys:Double>
    <sys:Double x:Key="Size.ButtonHeight">30</sys:Double>
    <sys:Double x:Key="Size.SmallButtonHeight">24</sys:Double>

    <!-- =========================================================
         Text styles
         ========================================================= -->

    <Style x:Key="BaLabelText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BaPanelText" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaLabelText}"/>

    <Style x:Key="BaDarkPanelText" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaLabelText}"/>

    <Style x:Key="BaSectionTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaLabelText}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="BaDarkSectionTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaSectionTitleText}"/>

    <Style x:Key="BaMutedTextDark"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaLabelText}">
        <Setter Property="Foreground" Value="{StaticResource Brush.MutedTextDarkShell}"/>
    </Style>

    <Style x:Key="BaMutedTextPanel"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaMutedTextDark}"/>

    <!-- =========================================================
         ComboBoxItem
         ========================================================= -->

    <Style x:Key="BaDarkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =========================================================
         Window style
         DynamicResource on root Window only, never StaticResource.
         ========================================================= -->

    <Style x:Key="BaWindow" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource Brush.WindowBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- =========================================================
         Panel borders
         ========================================================= -->

    <Style x:Key="BaPanelBorder" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="{StaticResource Thickness.SectionPadding}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Panel}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
        <Setter Property="Background" Value="{StaticResource Brush.PanelBg}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="BaDarkPanelBorder" TargetType="{x:Type Border}"
           BasedOn="{StaticResource BaPanelBorder}"/>

    <!-- =========================================================
         GroupBox
         New. Previously entirely unstyled, meaning the native
         GroupBox chrome (light border, white-ish header notch)
         showed through in every window that used one. Flat design,
         no notch, header rendered as a bold label bar above the
         content, matching BaPanelBorder's visual language.
         ========================================================= -->

    <Style x:Key="BaGroupBox" TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
        <Setter Property="Background" Value="{StaticResource Brush.PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0"
                                              ContentSource="Header"
                                              TextBlock.Foreground="{StaticResource Brush.MutedTextDarkShell}"
                                              TextBlock.FontWeight="SemiBold"
                                              TextBlock.FontSize="12"
                                              Margin="0,0,0,6"/>
                            <ContentPresenter Grid.Row="1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         TextBox
         ========================================================= -->

    <Style x:Key="BaTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{StaticResource Size.InputHeight}"/>
        <Setter Property="Padding" Value="6,2,6,2"/>
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.ControlFg}"/>
    </Style>

    <Style x:Key="BaReadOnlyTextBox"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource BaTextBox}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="#222224"/>
    </Style>

    <Style x:Key="BaDarkTextBox" TargetType="{x:Type TextBox}"
       BasedOn="{StaticResource BaTextBox}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="White"/>
    </Style>

    <!-- =========================================================
         ComboBox
         ========================================================= -->

    <Style x:Key="BaComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="{StaticResource Size.InputHeight}"/>
        <Setter Property="Padding" Value="6,2,4,2"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource BaDarkComboBoxItem}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>

                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Margin="{TemplateBinding Padding}"
                                         Foreground="{TemplateBinding Foreground}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"
                                         Focusable="True"
                                         Visibility="Hidden"/>

                                <Path Grid.Column="1"
                                      x:Name="Arrow"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{StaticResource Brush.ControlFg}"/>

                                <ToggleButton Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen,
                                                          RelativeSource={RelativeSource TemplatedParent},
                                                          Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              OverridesDefaultStyle="True"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropBorder"
                                    Background="{StaticResource Brush.ControlBg}"
                                    BorderBrush="{StaticResource Brush.ControlBorder}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="#5A5A60"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaDarkComboBox" TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource BaComboBox}"/>

    <!-- =========================================================
         CheckBox / RadioButton
         ========================================================= -->

    <Style x:Key="BaCheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                CornerRadius="3"
                                BorderBrush="{StaticResource Brush.ControlBorder}"
                                BorderThickness="1"
                                Background="{StaticResource Brush.ControlBg}"
                                VerticalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M 2,7 L 6,11 L 13,3"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Check" Property="Data" Value="M 3,7 L 13,7"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaPanelCheckBox" TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource BaCheckBox}"/>

    <Style x:Key="BaDarkPanelCheckBox" TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource BaCheckBox}"/>

    <Style x:Key="BaRadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Dot"
                                Width="16" Height="16"
                                CornerRadius="8"
                                BorderBrush="{StaticResource Brush.ControlBorder}"
                                BorderThickness="1"
                                Background="{StaticResource Brush.ControlBg}"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Fill"
                                     Width="8" Height="8"
                                     Fill="{StaticResource Brush.Accent}"
                                     Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaPanelRadioButton" TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource BaRadioButton}"/>

    <Style x:Key="BaDarkPanelRadioButton" TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource BaRadioButton}"/>

    <!-- =========================================================
         TabControl / TabItem
         ========================================================= -->

    <Style x:Key="BaTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.MutedTextDarkShell}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="6,6,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PanelBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{StaticResource Brush.PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource BaTabItem}"/>
    </Style>

    <!-- =========================================================
         Buttons
         ========================================================= -->

    <Style x:Key="BaButtonBase" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{StaticResource Size.ButtonHeight}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.HoverDark}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#101012"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaPrimaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaButtonBase}">
        <Setter Property="Background" Value="{StaticResource Brush.PrimaryButtonBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryButtonFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryButtonBorder}"/>
    </Style>

    <Style x:Key="BaSecondaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaButtonBase}">
        <Setter Property="Background" Value="{StaticResource Brush.SecondaryButtonBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.SecondaryButtonFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SecondaryButtonBorder}"/>
    </Style>

    <Style x:Key="BaPanelButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaButtonBase}">
        <Setter Property="Background" Value="{StaticResource Brush.PanelButtonBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.PanelButtonFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelButtonBorder}"/>
    </Style>

    <Style x:Key="BaSmallPanelButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaPanelButton}">
        <Setter Property="Height" Value="{StaticResource Size.SmallButtonHeight}"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <!-- =========================================================
         ListBox
         ========================================================= -->

    <Style x:Key="BaListBox" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="BaDarkListBox" TargetType="{x:Type ListBox}"
           BasedOn="{StaticResource BaListBox}"/>

    <Style x:Key="BaListBoxItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =========================================================
         DataGrid
         ========================================================= -->

    <Style x:Key="BaDataGridColumnHeader" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource Brush.GridHeaderBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.GridHeaderBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BaDataGridCell" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaDataGridRow" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaDataGrid" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.GridAltRow}"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="CellStyle" Value="{StaticResource BaDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource BaDataGridRow}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource BaDataGridColumnHeader}"/>
    </Style>

    <!-- =========================================================
         ScrollViewer / ScrollBar
         ========================================================= -->

    <Style x:Key="BaScrollViewer" TargetType="{x:Type ScrollViewer}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="BaScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Background="{StaticResource Brush.ScrollThumb}"
                            CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource Brush.ScrollThumbHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{StaticResource Brush.ScrollTrack}"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource BaScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource BaScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource BaScrollBarThumb}" MinHeight="24" MinWidth="24"/>
                            </Track.Thumb>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10"/>
                            <Setter Property="MinHeight" Value="10"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- =========================================================
     Slider
     New. Previously unstyled, the default WPF thumb is a small
     light/system-colored square, that's what showed up as a
     stray white box on ColorPickerDialog's R/G/B sliders.
     Implicit (TargetType only) so every Slider in the app picks
     this up automatically. Flat track, circular accent thumb,
     matching the CheckBox/RadioButton accent dot elsewhere.
     ========================================================= -->

    <Style TargetType="{x:Type Slider}">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4"
                            CornerRadius="2"
                            Background="{StaticResource Brush.ControlBg}"
                            BorderBrush="{StaticResource Brush.ControlBorder}"
                            BorderThickness="1"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource BaScrollBarPageButton}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource BaScrollBarPageButton}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Ellipse Fill="{StaticResource Brush.Accent}"
                                                 Stroke="{StaticResource Brush.WindowBg}"
                                                 StrokeThickness="1.5"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- =========================================================
         ToolTip
         ========================================================= -->

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         TreeView
         ========================================================= -->

    <Style x:Key="BaTreeView" TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="BaTreeViewItem" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="2"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.HoverDark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>