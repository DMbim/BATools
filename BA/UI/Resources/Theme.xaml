<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =========================================================
         BA UI THEME
         Single flat dark theme.
         Consolidated from the previous light panel / dark shell
         split. All former "light" and "Dark" key pairs are kept
         for backward compatibility with existing XAML, but now
         resolve to the same values, so nothing needs to change
         in windows that already reference the old keys.
         ========================================================= -->

    <!-- =========================================================
         Brushes
         ========================================================= -->

    <!-- Window / shell -->
    <SolidColorBrush x:Key="Brush.WindowBg" Color="#0F0F10"/>
    <SolidColorBrush x:Key="Brush.WindowFg" Color="#F2F2F2"/>

    <!-- Panel (formerly split into light and dark, now one) -->
    <SolidColorBrush x:Key="Brush.PanelBg" Color="#17181A"/>
    <SolidColorBrush x:Key="Brush.PanelFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#3A3A3D"/>

    <!-- Kept as aliases so BaDarkPanelBorder, BaDarkPanelText, etc still resolve -->
    <SolidColorBrush x:Key="Brush.DarkPanelBg" Color="#17181A"/>
    <SolidColorBrush x:Key="Brush.DarkPanelFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.DarkPanelBorder" Color="#3A3A3D"/>

    <!-- Standard control colors -->
    <SolidColorBrush x:Key="Brush.ControlBg" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Brush.ControlFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#3A3A3D"/>

    <!-- Aliases, same values as above -->
    <SolidColorBrush x:Key="Brush.ControlBgDark" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Brush.ControlFgDark" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.ControlBorderDark" Color="#3A3A3D"/>

    <!-- Buttons, flat look matching the settings window, kept as
         three semantic keys so callers do not need to change which
         key they reference, only the visual result changes -->
    <SolidColorBrush x:Key="Brush.PrimaryButtonBg" Color="#242426"/>
    <SolidColorBrush x:Key="Brush.PrimaryButtonFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.PrimaryButtonBorder" Color="#55575C"/>

    <SolidColorBrush x:Key="Brush.SecondaryButtonBg" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Brush.SecondaryButtonFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.SecondaryButtonBorder" Color="#3A3A3D"/>

    <SolidColorBrush x:Key="Brush.PanelButtonBg" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Brush.PanelButtonFg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush.PanelButtonBorder" Color="#3A3A3D"/>

    <!-- Interaction -->
    <SolidColorBrush x:Key="Brush.HoverLight" Color="#2A2C30"/>
    <SolidColorBrush x:Key="Brush.HoverDark" Color="#2A2C30"/>
    <SolidColorBrush x:Key="Brush.Selected" Color="#24466B"/>
    <SolidColorBrush x:Key="Brush.SelectedBorder" Color="#5A8FD6"/>

    <!-- Text helpers -->
    <SolidColorBrush x:Key="Brush.MutedTextLightPanel" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush.MutedTextDarkShell" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#E5484D"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#4CAF50"/>

    <!-- Grid -->
    <SolidColorBrush x:Key="Brush.GridAltRow" Color="#17181A"/>
    <SolidColorBrush x:Key="Brush.GridHeaderBg" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Brush.GridHeaderBorder" Color="#3A3A3D"/>

    <!-- =========================================================
         Dimensions
         ========================================================= -->

    <Thickness x:Key="Thickness.WindowMargin">10</Thickness>
    <Thickness x:Key="Thickness.SectionPadding">10</Thickness>
    <CornerRadius x:Key="CornerRadius.Panel">4</CornerRadius>

    <sys:Double x:Key="Size.InputHeight">26</sys:Double>
    <sys:Double x:Key="Size.ButtonHeight">30</sys:Double>
    <sys:Double x:Key="Size.SmallButtonHeight">24</sys:Double>

    <!-- =========================================================
         Text styles
         ========================================================= -->

    <Style x:Key="BaLabelText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BaPanelText" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaLabelText}"/>

    <Style x:Key="BaDarkPanelText" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaLabelText}"/>

    <Style x:Key="BaSectionTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaLabelText}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="BaDarkSectionTitleText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaSectionTitleText}"/>

    <Style x:Key="BaMutedTextDark"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaLabelText}">
        <Setter Property="Foreground" Value="{StaticResource Brush.MutedTextDarkShell}"/>
    </Style>

    <Style x:Key="BaMutedTextPanel"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BaMutedTextDark}"/>

    <!-- =========================================================
         ComboBoxItem
         Previously hardcoded black on white, which is a bug on a
         dark theme. Fixed to use theme colors.
         ========================================================= -->

    <Style x:Key="BaDarkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =========================================================
         Window style
         NOTE: Do NOT put WindowStartupLocation here.
         ========================================================= -->

    <Style x:Key="BaWindow" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource Brush.WindowBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- =========================================================
         Panel borders
         ========================================================= -->

    <Style x:Key="BaPanelBorder" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="{StaticResource Thickness.SectionPadding}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Panel}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
        <Setter Property="Background" Value="{StaticResource Brush.PanelBg}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="BaDarkPanelBorder" TargetType="{x:Type Border}"
           BasedOn="{StaticResource BaPanelBorder}"/>

    <!-- =========================================================
         TextBox
         ========================================================= -->

    <Style x:Key="BaTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{StaticResource Size.InputHeight}"/>
        <Setter Property="Padding" Value="6,2,6,2"/>
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.ControlFg}"/>
    </Style>

    <Style x:Key="BaReadOnlyTextBox"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource BaTextBox}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="#222224"/>
    </Style>

    <Style x:Key="BaDarkTextBox" TargetType="{x:Type TextBox}"
       BasedOn="{StaticResource BaTextBox}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="White"/>
    </Style>

    <!-- =========================================================
         ComboBox
         Single template, used by both BaComboBox and BaDarkComboBox.
         The custom template is required because the default WPF
         ComboBox popup ignores app theme and renders white
         regardless of window background.
         ========================================================= -->

    <Style x:Key="BaComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="{StaticResource Size.InputHeight}"/>
        <Setter Property="Padding" Value="6,2,4,2"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource BaDarkComboBoxItem}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>

                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Margin="{TemplateBinding Padding}"
                                         Foreground="{TemplateBinding Foreground}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"
                                         Focusable="True"
                                         Visibility="Hidden"/>

                                <Path Grid.Column="1"
                                      x:Name="Arrow"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{StaticResource Brush.ControlFg}"/>

                                <ToggleButton Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen,
                                                          RelativeSource={RelativeSource TemplatedParent},
                                                          Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              OverridesDefaultStyle="True"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropBorder"
                                    Background="{StaticResource Brush.ControlBg}"
                                    BorderBrush="{StaticResource Brush.ControlBorder}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="#5A5A60"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaDarkComboBox" TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource BaComboBox}"/>

    <!-- =========================================================
         CheckBox / RadioButton
         ========================================================= -->

    <Style x:Key="BaCheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="BaPanelCheckBox" TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource BaCheckBox}"/>

    <Style x:Key="BaDarkPanelCheckBox" TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource BaCheckBox}"/>

    <Style x:Key="BaRadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource Brush.WindowFg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="BaPanelRadioButton" TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource BaRadioButton}"/>

    <Style x:Key="BaDarkPanelRadioButton" TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource BaRadioButton}"/>

    <!-- =========================================================
         Buttons
         Flat look matching the settings window. Three semantic
         keys retained for callers, visually close to each other
         by design, distinguished only by a subtle background and
         border shift so hierarchy still reads without looking
         like the previous heavier button chrome.
         ========================================================= -->

    <Style x:Key="BaButtonBase" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{StaticResource Size.ButtonHeight}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.HoverDark}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#101012"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaPrimaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaButtonBase}">
        <Setter Property="Background" Value="{StaticResource Brush.PrimaryButtonBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryButtonFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryButtonBorder}"/>
    </Style>

    <Style x:Key="BaSecondaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaButtonBase}">
        <Setter Property="Background" Value="{StaticResource Brush.SecondaryButtonBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.SecondaryButtonFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SecondaryButtonBorder}"/>
    </Style>

    <Style x:Key="BaPanelButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaButtonBase}">
        <Setter Property="Background" Value="{StaticResource Brush.PanelButtonBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.PanelButtonFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelButtonBorder}"/>
    </Style>

    <Style x:Key="BaSmallPanelButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaPanelButton}">
        <Setter Property="Height" Value="{StaticResource Size.SmallButtonHeight}"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <!-- =========================================================
         ListBox
         ========================================================= -->

    <Style x:Key="BaListBox" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="BaDarkListBox" TargetType="{x:Type ListBox}"
           BasedOn="{StaticResource BaListBox}"/>

    <Style x:Key="BaListBoxItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =========================================================
         DataGrid
         CellStyle, RowStyle, and ColumnHeaderStyle are now baked
         in via Setters. Any window using Style="{StaticResource
         BaDataGrid}" gets correct theming with no further wiring
         required. This is the fix for the Sheet Updater bug: that
         window's DataGrid never had CellStyle/RowStyle applied,
         so it fell back to default WPF white row background with
         inherited window foreground text.
         ========================================================= -->

    <Style x:Key="BaDataGridColumnHeader" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource Brush.GridHeaderBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.GridHeaderBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BaDataGridCell" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaDataGridRow" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaDataGrid" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.GridAltRow}"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="CellStyle" Value="{StaticResource BaDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource BaDataGridRow}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource BaDataGridColumnHeader}"/>
    </Style>

    <!-- =========================================================
         ScrollViewer
         ========================================================= -->

    <Style x:Key="BaScrollViewer" TargetType="{x:Type ScrollViewer}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- =========================================================
         TreeView
         ========================================================= -->

    <Style x:Key="BaTreeView" TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="{StaticResource Brush.ControlBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="BaTreeViewItem" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="2"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selected}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ControlFg}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.HoverDark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>