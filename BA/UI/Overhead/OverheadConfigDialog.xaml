<Window x:Class="BA.UI.Overhead.OverheadConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overhead Auto-Dash – Settings"
        Width="560" Height="520"
        MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
            Background="#0F0F10" Foreground="#F2F2F2" FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Presets:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Architecture" Click="PresetArchitecture_Click"  Margin="0,0,6,0" Background="Black" Foreground="White" BorderBrush="#FFFFDCDC"/>
            <Button Content="MEP" Background="Black" Foreground="White" BorderBrush="#FFFFDCDC" Click="PresetMEP_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Categories" Margin="0,0,8,0">
                <DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                             ToolTip="Type to filter categories..." />
                    <ListBox x:Name="CategoryList"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"/>
                </DockPanel>
            </GroupBox>

            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <GroupBox Header="Overhead Band" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <RadioButton x:Name="UseNextLevelRadio"
                                     Content="Top = next level above (clamped)"
                                     Margin="0,0,0,4" Background="White" Foreground="White"/>
                        <RadioButton x:Name="UseViewTopRadio"
                                     Content="Top = view top" Foreground="White"/>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Fallback Cut (mm)" Width="140" VerticalAlignment="Center"/>
                            <TextBox x:Name="FallbackCutBox" Width="90" Foreground="Black"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Other">
                    <StackPanel Margin="8">
                        <DockPanel>
                            <TextBlock Text="Tiny threshold (mm)" Width="140" VerticalAlignment="Center"/>
                            <TextBox x:Name="TinyThresholdBox" Width="90" Foreground="Black"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Overhead Enable / Disable&#xD;&#xA;">
                    <StackPanel Margin="8">
                        <DockPanel>
                            <Button x:Name="TurnOffButton"
                                    Content="Turn off Overhead lines"
                                    Width="150" Margin="0,0,0,6"
                                    Background="Black" Foreground="White" BorderBrush="#FFFFDCDC"
                                    Click="TurnOff_Click"/>
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="TurnOnButton"
                                    Content="Turn on Overhead lines"
                                    Width="150"
                                    Background="Black" Foreground="White" BorderBrush="#FFFFDCDC"
                                    Click="TurnOn_Click"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Text="Tip: Hold Shift on the command to open settings."/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Width="90" Background="Black" Foreground="White" BorderBrush="#FFFFDCDC" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="OK" Width="120" Background="Black" Foreground="White" BorderBrush="#FFFFDCDC" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>