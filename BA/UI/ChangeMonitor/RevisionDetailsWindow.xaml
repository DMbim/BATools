<Window x:Class="BA.UI.RevisionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revision details"
        Height="180"
        Width="420"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="LblHeader"
                       FontWeight="Bold"
                       Foreground="#F2F2F2"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Description:"
                       Foreground="#A0A8B4"
                       Margin="0,0,0,2"/>
            <TextBox x:Name="TxtDescription"
                     Style="{StaticResource BaDarkTextBox}"
                     Margin="0,0,0,8"/>

            <TextBlock Text="Date (text shown in Revision Date column):"
                       Foreground="#A0A8B4"
                       Margin="0,0,0,2"/>
            <TextBox x:Name="TxtDate"
                     Style="{StaticResource BaDarkTextBox}"
                     Margin="0,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="OK"
                    Width="80" Margin="0,0,8,0"
                    Style="{StaticResource BaPrimaryButton}"
                    Click="OnOkClick"/>
            <Button Content="Cancel"
                    Width="80"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
