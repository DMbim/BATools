<Window x:Class="BA.UI.LiveReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Change Monitor (Live Review)" Height="560" Width="1140"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Topmost="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters + options -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Text="Recorded Changes" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Text="  (double-click a row or use actions below)" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <Button Content="Refresh" Width="80" Margin="12,0,0,0" Click="OnRefreshClick"/>
            <CheckBox x:Name="ChkFollow" Content="Follow live" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"/>

            <TextBlock Text="   Type:" Margin="18,0,4,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbType" Width="120" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="(All)" IsSelected="True"/>
                <ComboBoxItem Content="Added"/>
                <ComboBoxItem Content="Deleted"/>
                <ComboBoxItem Content="Moved"/>
                <ComboBoxItem Content="Modified"/>
            </ComboBox>

            <TextBlock Text="   Category:" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtCategory" Width="160" TextChanged="OnFilterChanged"/>

            <TextBlock Text="   Param contains:" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtParam" Width="200" TextChanged="OnFilterChanged"/>

            <TextBlock Text="   Group:" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbGroupMode" Width="150" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="None" IsSelected="True"/>
                <ComboBoxItem Content="Transaction"/>
                <ComboBoxItem Content="Time (per minute)"/>
            </ComboBox>
        </StackPanel>

        <!-- Grid -->
        <DataGrid x:Name="GridChanges"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  MouseDoubleClick="GridChanges_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Done"
                                        Binding="{Binding IsDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="60" />
                <DataGridTextColumn Header="When"         Binding="{Binding When}" Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="Type"         Binding="{Binding ChangeType}" Width="90"  IsReadOnly="True"/>
                <DataGridTextColumn Header="ElementId"    Binding="{Binding ElementId}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Category"     Binding="{Binding Category}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="View"         Binding="{Binding ViewName}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="ViewId"       Binding="{Binding ViewId}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="User"         Binding="{Binding Username}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Transactions" Binding="{Binding Transactions}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Param Changes" Binding="{Binding ParamSummary}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Add Revision Cloud(s)" Width="160" Margin="0,0,8,0" Click="OnAddCloudsClick"/>
            <Button Content="Show in Revit" Width="120" Margin="0,0,8,0" Click="OnShowClick"/>
            <Button Content="Close" Width="90" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
