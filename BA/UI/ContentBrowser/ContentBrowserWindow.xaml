<Window x:Class="BA.UI.ContentBrowser.ContentBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BA Content Browser"
        Width="1450"
        Height="850"
        WindowStartupLocation="CenterOwner"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#121722" BorderBrush="#2E3545" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         VerticalContentAlignment="Center"
                         Padding="8,4"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}" Background="Black" />

                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding ApprovalStates}"
                          SelectedItem="{Binding SelectedApprovalState}" Background="Black" />

                <ComboBox Grid.Column="6"
                          ItemsSource="{Binding Roots}"
                          SelectedItem="{Binding SelectedRoot}" Background="Black" />

                <CheckBox Grid.Column="8"
                          VerticalAlignment="Center"
                          IsChecked="{Binding FavoritesOnly}"
                          Content="Favorites" Foreground="#FFFFF9F9" Height="16"/>

                <Button Grid.Column="13"
                        Content="Rebuild Index"
                        Command="{Binding RefreshIndexCommand}" Margin="159,-1,-279,1" />

                <Button Grid.Column="11"
                        Content="Open Folder"
                        Command="{Binding OpenFolderCommand}" Grid.ColumnSpan="3" Margin="0,0,-2,0" />


            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#121722" BorderBrush="#2E3545" BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowBackground="#121722"
                          AlternatingRowBackground="#151B27"
                          Background="White"
                          Foreground="#FF121111"
                          BorderThickness="0"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2.5*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                        <DataGridTextColumn Header="State" Binding="{Binding ApprovalState}" Width="*" />
                        <DataGridTextColumn Header="Root" Binding="{Binding RootName}" Width="*" />
                        <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="#121722" BorderBrush="#2E3545" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="260"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#2E3545" BorderThickness="1" Background="#0E1118" CornerRadius="8">
                        <Grid>
                            <TextBlock Text="No Preview"
                                       Foreground="#7F8A9A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="20" />
                            <Image Source="{Binding SelectedPreviewPath}" Stretch="Uniform" Margin="8"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Text="{Binding SelectedItem.DisplayName}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="4" Text="{Binding SelectedItem.FullPath}" TextWrapping="Wrap" Foreground="#BFC7D5"/>
                    <TextBlock Grid.Row="6" Text="{Binding SelectedItem.Description}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="8" Text="{Binding SelectedItem.Category}" FontWeight="SemiBold"/>

                    <StackPanel Grid.Row="10" Orientation="Vertical">
                        <WrapPanel Margin="0,0,0,8">
                            <Button Width="120" Height="34" Margin="0,0,8,0" Content="Load" Command="{Binding LoadSelectedCommand}" />
                            <Button Width="140" Height="34" Margin="0,0,8,0" Content="Load + Place" Command="{Binding LoadAndPlaceCommand}" />
                            <Button Width="120" Height="34" Margin="0,0,8,0" Content="Favorite" Command="{Binding ToggleFavoriteCommand}" />
                            <Button Width="140" Height="34" Margin="0,0,8,0" Content="Export Preview" Command="{Binding ExportPreviewCommand}" />
                        </WrapPanel>

                        <TextBlock Text="Metadata" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,6"/>
                        <TextBlock Text="{Binding SelectedItem.RootName, StringFormat=Root: {0}}" Margin="0,0,0,4" Background="#FFF9F2F2" Foreground="#FF2F2E2E"/>
                        <TextBlock Text="{Binding SelectedItem.ApprovalState, StringFormat=Approval: {0}}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedItem.Manufacturer, StringFormat=Manufacturer: {0}}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedItem.FileName, StringFormat=File: {0}}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedItem.FileSizeBytes, StringFormat=Size: {0:N0} bytes}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedItem.ModifiedUtc, StringFormat=Modified UTC: {0:yyyy-MM-dd HH:mm}}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#121722" BorderBrush="#2E3545" BorderThickness="1" CornerRadius="8" Padding="8">
            <TextBlock Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>