<Window x:Class="BA.UI.AddSharedParamsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d"
 Title="Add Shared Parameters" Height="560" Width="960"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <DockPanel Margin="10">
        <!-- Top: search + sets -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBox x:Name="TxtSearch" Width="250" Margin="0,0,6,0"/>
            <Button Content="Search" Width="80" Click="BtnSearch_Click"/>
            <Button Content="Load Set" Width="90" Margin="8,0,0,0" Click="BtnLoadSet_Click"/>
            <Button Content="Save Set" Width="90" Margin="8,0,0,0" Click="BtnSaveSet_Click"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left: Shared parameters (read-only) -->
            <DataGrid x:Name="DgShared"
 AutoGenerateColumns="False"
 SelectionMode="Extended"
 CanUserAddRows="False"
 IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Shared Name" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Spec" Binding="{Binding Spec}" IsReadOnly="True" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Right: Selected items to add (editable Group/Instance) -->
            <DataGrid x:Name="DgSelected"
 Grid.Column="2"
 AutoGenerateColumns="False"
 SelectionMode="Extended"
 CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Shared Name" Binding="{Binding SharedName}" IsReadOnly="True" Width="*"/>
                    <DataGridComboBoxColumn Header="Group" SelectedItemBinding="{Binding Group, Mode=TwoWay}" Width="160"/>
                    <DataGridCheckBoxColumn Header="Instance" Binding="{Binding IsInstance}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bottom buttons -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="&lt;&lt; Add" Width="90" Margin="8,0,0,0" Click="BtnAdd_Click"/>
                <Button Content="Remove" Width="90" Margin="8,0,0,0" Click="BtnRemove_Click"/>
                <Button Content="Apply to Family" Width="150" Margin="16,0,0,0" Click="BtnApply_Click"/>
                <Button Content="Close" Width="90" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>