<Window x:Class="BA.UI.CustomReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Replace"
        Width="800" Height="250"
        Background="#0F0F10" Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <DockPanel Margin="10">

        <!-- Top search bar -->
        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Top"
                    Margin="0,0,0,6">
            <TextBox x:Name="TxtSearch" Width="250" Margin="0,0,6,0" />
            <Button Content="Search" Width="80" Click="BtnSearch_Click" />
        </StackPanel>

        <!-- Main content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Left grid -->
            <DataGrid x:Name="DgFamily"
                      Grid.Row="0" Grid.Column="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Family Param"
                                        Binding="{Binding Name}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTextColumn Header="Spec"
                                        Binding="{Binding Spec}"
                                        IsReadOnly="True"
                                        Width="160" />
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMapped}" Value="True">
                                <Setter Property="Background" Value="#FF2A2F33" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Right grid -->
            <DataGrid x:Name="DgShared"
                      Grid.Row="0" Grid.Column="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Shared Name"
                                        Binding="{Binding Name}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTextColumn Header="Spec"
                                        Binding="{Binding Spec}"
                                        IsReadOnly="True"
                                        Width="160" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bottom buttons -->
            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Map" Width="100" Margin="0,0,10,0" Click="BtnMap_Click" />
                <Button Content="Close" Width="100" IsCancel="True" />
            </StackPanel>

        </Grid>
    </DockPanel>
</Window>