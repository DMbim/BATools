<Window x:Class="BA.UI.CustomReplaceDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Custom Replace" Height="450" Width="800">
    <DockPanel Margin="10">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBox x:Name="TxtSearch" Width="250" Margin="0,0,6,0" />
            <Button Content="Search" Width="80" Click="BtnSearch_Click" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="DgFamily" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Family Param" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Spec" Binding="{Binding Spec}" IsReadOnly="True" Width="160" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="DgShared" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Shared Name" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Spec" Binding="{Binding Spec}" IsReadOnly="True" Width="160" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Map" Width="100" Margin="0,0,10,0" Click="BtnMap_Click" />
                <Button Content="Close" Width="100" IsCancel="True" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>