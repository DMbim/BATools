<Window x:Class="BA.UI.FamilyParametersUI"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Harmonizer"
        WindowStartupLocation="CenterOwner"
        Width="1800"
        Height="600"
        MinWidth="1600"
        MinHeight="500"
        SizeToContent="Manual"
        ResizeMode="CanResize">

    <DockPanel Margin="10">

        <!-- Bottom bar: SP path + prefix tools + buttons -->
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,8,0,0">

            <!-- Left: shared parameter file -->
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left">
                <TextBlock Text="Shared Parameter File:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBox x:Name="TxtSharedParamPath"
                         Width="320"
                         Margin="0,0,6,0"
                         IsReadOnly="True" />
                <Button x:Name="BtnBrowseSP"
                        Content="Browse..."
                        Width="90"
                        Click="BtnBrowseSP_Click" />
            </StackPanel>

            <!-- Middle: prefix tools -->
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left"
                        Margin="20,0,0,0">
                <TextBlock Text="Prefix:"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <TextBox x:Name="TxtPrefixOld"
                         Width="80"
                         Margin="0,0,4,0"
                         ToolTip="Old prefix (for remove/replace)" />
                <TextBox x:Name="TxtPrefixNew"
                         Width="80"
                         Margin="0,0,4,0"
                         ToolTip="New prefix (for add/replace)" />
                <Button x:Name="BtnApplyPrefix"
                        Content="Apply Prefix"
                        Width="100"
                        Click="BtnApplyPrefix_Click" />
            </StackPanel>

            <!-- Right: action buttons -->
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right">
                <Button x:Name="BtnExportCsv"
                        Content="Export CSV"
                        Width="100"
                        Margin="8,0,0,0"
                        Click="BtnExportCsv_Click" />

                <Button x:Name="BtnMetric"
                        Content="Metric Units"
                        Width="110"
                        Margin="8,0,0,0"
                        Click="BtnMetric_Click" />


                <Button x:Name="BtnCustom"
                        Content="Custom Replace"
                        Width="130"
                        Margin="8,0,0,0"
                        Click="BtnCustom_Click" />

                <Button x:Name="BtnAddShared"
                        Content="Add Shared Params"
                        Width="150"
                        Margin="8,0,0,0"
                        Click="BtnAddShared_Click" />

                <Button x:Name="BtnPreview"
                        Content="Preview Matches"
                        Width="140"
                        Margin="8,0,0,0"
                        Click="BtnPreview_Click" />

                <Button Content="Cancel"
                        Width="90"
                        Margin="8,0,0,0"
                        IsCancel="True" />
                
                <Button x:Name="BtnRun"
                        Content="Run Harmonize"
                        Width="130"
                        Margin="8,0,0,0"
                        Click="BtnRun_Click" />
                
            </StackPanel>
        </DockPanel>

        <!-- Data Grid fills remaining space -->
        <DataGrid x:Name="DgParameters"
                  ItemsSource="{Binding Parameters}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Margin="0,0,0,10"
                  MinHeight="380"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"
                                    Width="150" />

                <DataGridCheckBoxColumn Header="Instance"
                                        Binding="{Binding IsInstance}"
                                        IsReadOnly="True"
                                        Width="40" />

                <DataGridCheckBoxColumn Header="Shared"
                                        Binding="{Binding IsShared}"
                                        IsReadOnly="True"
                                        Width="40" />

                <DataGridTextColumn Header="Spec"
                                    Binding="{Binding Spec}"
                                    IsReadOnly="True"
                                    Width="80" />

                <DataGridTextColumn Header="Proposed Shared"
                                    Binding="{Binding MatchedShared}"
                                    IsReadOnly="True"
                                    Width="150" />

                <DataGridTextColumn Header="Score"
                                    Binding="{Binding MatchScore, StringFormat=0.00}"
                                    IsReadOnly="True"
                                    Width="40" />

                <!-- Action combo with your working ElementStyle approach -->
                <DataGridComboBoxColumn Header="Action"
                                        Width="120"
                                        SelectedItemBinding="{Binding Action,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource"
                                    Value="{Binding RelativeSource={RelativeSource FindAncestor,
                                                                                     AncestorType={x:Type Window}},
                                                    Path=DataContext.ActionOptions}" />
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource"
                                    Value="{Binding RelativeSource={RelativeSource FindAncestor,
                                                                                     AncestorType={x:Type Window}},
                                                    Path=DataContext.ActionOptions}" />
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>

                <DataGridTextColumn Header="New Name"
                                    Binding="{Binding NewName,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
