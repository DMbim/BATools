<Window x:Class="BA.UI.FamilyParametersUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Parameter Manager"
        Height="780"
        Width="1450"
        WindowStartupLocation="CenterOwner"
        Background="#111111"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>

        <SolidColorBrush x:Key="BgWindow" Color="#111111"/>
        <SolidColorBrush x:Key="BgPanel" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#3A3A3A"/>

        <SolidColorBrush x:Key="FgMain" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="FgDim" Color="#B8B8B8"/>

        <SolidColorBrush x:Key="DgBg" Color="#111111"/>
        <SolidColorBrush x:Key="DgAltBg" Color="#161616"/>
        <SolidColorBrush x:Key="DgHoverBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DgGridLine" Color="#2A2A2A"/>

        <SolidColorBrush x:Key="DgHeaderBg" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="DgHeaderFg" Color="#F2F2F2"/>

        <SolidColorBrush x:Key="DgSelBg" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="DgSelFg" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="EditBg" Color="#101010"/>
        <SolidColorBrush x:Key="EditFg" Color="#FFFFFF"/>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="GridEditingTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource EditFg}"/>
            <Setter Property="Background" Value="{StaticResource EditBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{StaticResource DgBg}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource DgBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource DgAltBg}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DgGridLine}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource DgGridLine}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource DgHeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource DgHeaderFg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="MinHeight" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DgHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource DgGridLine}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource DgSelBg}"/>
                    <Setter Property="Foreground" Value="{StaticResource DgSelFg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <DockPanel Margin="10" LastChildFill="True" Background="{StaticResource BgWindow}">

        <!-- TOP -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0">
                    <Button Content="Preview match" Width="140" Click="BtnPreview_Click"/>
                    <Button Content="Run apply" Width="120" Click="BtnRun_Click"/>
                    <Button Content="Toggle Delete" Width="140" Click="BtnToggleDeleteSelected_Click"/>
                    <Button Content="Set Instance" Width="120" Click="BtnSetInstanceSelected_Click"/>
                    <Button Content="Set Type" Width="120" Click="BtnSetTypeSelected_Click"/>
                    <Button Content="Add shared params" Width="160" Click="BtnAddShared_Click"/>
                    <Button Content="Metric Units" Width="140" Click="BtnMetric_Click"/>
                </WrapPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Shared param file:"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgDim}"/>

                    <TextBox Grid.Column="1" x:Name="TxtSharedParamPath"/>

                    <Button Grid.Column="2"
                            Content="Browse"
                            Width="110"
                            Margin="10,0,0,0"
                            Click="BtnBrowseSP_Click"/>

                    <TextBlock Grid.Column="4"
                               Text="Prefix:"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgDim}"/>

                    <TextBox Grid.Column="5" x:Name="TxtPrefixNew"/>

                    <Button Grid.Column="6"
                            Content="Apply Prefix"
                            Width="120"
                            Margin="10,0,0,0"
                            Click="BtnApplyPrefix_Click"/>

                    <Button Grid.Column="7"
                            Content="Export CSV"
                            Width="120"
                            Margin="10,0,0,0"
                            Click="BtnExportCsv_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- BOTTOM -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0">
            <TextBlock Text="Target Name: leave empty = Keep, leave suggested shared name = Replace, type a different name = Rename. Delete is explicit."
                       Foreground="{StaticResource FgDim}"/>
        </Border>

        <!-- MAIN GRID -->
        <DataGrid x:Name="DgParameters"
                  ItemsSource="{Binding Parameters}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  KeyDown="DgParameters_KeyDown">

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Sel" Width="45">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource GridCheckBoxStyle}"
                                      Click="SelCheckBox_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Name"
                                    Width="240"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Spec"
                                    Width="160"
                                    Binding="{Binding Spec}"
                                    IsReadOnly="True"/>

                <DataGridCheckBoxColumn Header="Shared"
                                        Width="70"
                                        Binding="{Binding IsShared}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource GridCheckBoxStyle}"/>

                <DataGridCheckBoxColumn Header="Built-in"
                                        Width="75"
                                        Binding="{Binding IsBuiltIn}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource GridCheckBoxStyle}"/>

                <DataGridTextColumn Header="Scope"
                                    Width="90"
                                    Binding="{Binding Scope}"
                                    IsReadOnly="True"/>

                <DataGridCheckBoxColumn Header="Del"
                                        Width="45"
                                        Binding="{Binding DeleteRequested, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource GridCheckBoxStyle}"/>

                <DataGridTextColumn Header="Decision"
                                    Width="90"
                                    Binding="{Binding EffectiveActionDisplay}"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Target Name"
                                    Width="260"
                                    Binding="{Binding TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource GridEditingTextBox}"/>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Matched Shared"
                                    Width="240"
                                    Binding="{Binding MatchedShared}"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Score"
                                    Width="70"
                                    Binding="{Binding MatchScore}"
                                    IsReadOnly="True"/>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>