<Window x:Class="BA.UI.Rooms.ElementToRoomSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Element → Room Settings"
        Height="280" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Category -->
            <RowDefinition Height="Auto"/>
            <!-- Link (optional) -->
            <RowDefinition Height="Auto"/>
            <!-- Source -->
            <RowDefinition Height="Auto"/>
            <!-- Dest -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Category:"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox x:Name="E2RCategories"
                  Grid.Row="0" Grid.Column="1"
                  Margin="0,0,0,8"/>

        <!-- Link row -->
        <TextBlock x:Name="LblLink"
                   Grid.Row="1" Grid.Column="0"
                   Text="Revit Link Instance:"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox x:Name="E2RLinks"
                  Grid.Row="1" Grid.Column="1"
                  Margin="0,0,0,8"
                  DisplayMemberPath="Name"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Source Parameter (Room):"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="E2RLocalSourceCB"
                 Grid.Row="2" Grid.Column="1"
                 Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Destination Parameter (Element):"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="E2RTargetCB"
                 Grid.Row="3" Grid.Column="1"
                 Margin="0,0,0,8"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0"
                    Content="OK"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button Width="90"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
