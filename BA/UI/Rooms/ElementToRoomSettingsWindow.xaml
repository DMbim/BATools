<Window x:Class="BA.UI.Rooms.ElementToRoomSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Element → Room Settings"
        Height="260" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#161B22"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="CaretBrush" Value="#F2F2F2"/>
            </Style>

            <Style x:Key="DarkRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="Margin" Value="0,0,16,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="DarkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1A1A1D"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#222226"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#17171A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Mode radio buttons -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Category label -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Category combo -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Link label -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Link combo -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Source label -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Source textbox -->
            <RowDefinition Height="Auto"/>
            <!-- 7: Destination label -->
            <RowDefinition Height="Auto"/>
            <!-- 8: Destination textbox -->
            <RowDefinition Height="*"/>
            <!-- 9: spacer -->
            <RowDefinition Height="Auto"/>
            <!-- 10: OK/Cancel -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Mode:" Foreground="#A0A8B4" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton x:Name="RbLocal"
                         Content="Local"
                         GroupName="E2RMode"
                         Style="{StaticResource DarkRadioButtonStyle}"
                         Checked="ModeRadio_Checked"/>
            <RadioButton x:Name="RbLink"
                         Content="Link"
                         GroupName="E2RMode"
                         Style="{StaticResource DarkRadioButtonStyle}"
                         Checked="ModeRadio_Checked"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Category:"
                   Foreground="#A0A8B4"
                   Margin="0,0,0,4"/>
        <ComboBox x:Name="E2RCategories"
                  Grid.Row="2"
                  Style="{StaticResource BaDarkComboBox}"
                  Margin="0,0,0,10"/>

        <TextBlock x:Name="LblLink"
                   Grid.Row="3"
                   Text="Revit Link Instance:"
                   Foreground="#A0A8B4"
                   Margin="0,0,0,4"/>
        <ComboBox x:Name="E2RLinks"
                  Grid.Row="4"
                  Style="{StaticResource BaDarkComboBox}"
                  Margin="0,0,0,10"
                  DisplayMemberPath="Name"/>

        <TextBlock Grid.Row="5"
                   Text="Source Parameter (Room):"
                   Foreground="#A0A8B4"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="E2RLocalSourceCB"
                 Grid.Row="6"
                 Style="{StaticResource DarkTextBoxStyle}"
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="7"
                   Text="Destination Parameter (Element):"
                   Foreground="#A0A8B4"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="E2RTargetCB"
                 Grid.Row="8"
                 Style="{StaticResource DarkTextBoxStyle}"
                 Margin="0,0,0,10"/>

        <StackPanel Grid.Row="10"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0"
                    Content="OK"
                    IsDefault="True"
                    Style="{StaticResource DarkButtonStyle}"
                    Click="OkButton_Click"/>
            <Button Width="90"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource DarkButtonStyle}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
