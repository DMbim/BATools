<Window x:Class="BA.UI.Rooms.AxisToRoomSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Axis to Room (Link)"
        Height="220" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Revit Link Instance:"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>

        <ComboBox x:Name="AxisLinksComboBox"
                  Grid.Row="0" Grid.Column="1"
                  Margin="0,0,0,8"
                  MinWidth="280"
                  DisplayMemberPath="Name"/>

        <CheckBox x:Name="DimensionCheckbox"
                  Grid.Row="1" Grid.Column="1"
                  Margin="0,0,0,10"
                  Content="Use BA_Axis_Dim (otherwise BA_Axis)"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0"
                    Content="OK"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button Width="90"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
