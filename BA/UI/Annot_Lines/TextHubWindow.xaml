<Window x:Class="BA.UI.TextHub.TextHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Annotation Hub"
        Width="1100" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A0A"
        Foreground="White"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">

    <Window.Resources>

        <CollectionViewSource x:Key="CvsParameters" Source="{Binding Parameters}">
            <!-- GroupDescriptions are set in code-behind/VM (recommended) -->
        </CollectionViewSource>

        <!-- Group header look -->
        <Style x:Key="ParamGroupHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- =========================
             Dark shell palette
             ========================= -->
        <SolidColorBrush x:Key="ShellBg" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="PanelBg" Color="#111214"/>
        <SolidColorBrush x:Key="PanelBg2" Color="#14151A"/>
        <SolidColorBrush x:Key="ShellBorder" Color="#2A2A2C"/>
        <SolidColorBrush x:Key="ShellTextDim" Color="#B8B8B8"/>

        <!-- =========================
             Light grid palette
             ========================= -->
        <SolidColorBrush x:Key="GridBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="GridAltBg" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="GridHeaderBg" Color="#ECEEF2"/>
        <SolidColorBrush x:Key="GridLine" Color="#D5D7DD"/>

        <SolidColorBrush x:Key="GridText" Color="#111111"/>
        <SolidColorBrush x:Key="GridTextDim" Color="#333333"/>

        <SolidColorBrush x:Key="SelBg" Color="#2A5A9E"/>
        <SolidColorBrush x:Key="SelFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HoverBg" Color="#E6F0FF"/>

        <!-- =========================
             Top controls (scoped styles)
             ========================= -->
        <Style x:Key="TopTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F0F12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#23232A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2B2B34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- =========================
             DataGrid styles (SCOPED, explicit)
             ========================= -->
        <Style x:Key="LightDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource GridBg}"/>
            <Setter Property="Foreground" Value="{StaticResource GridText}"/>
            <Setter Property="RowBackground" Value="{StaticResource GridBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource GridAltBg}"/>

            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLine}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridLine}"/>

            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>

            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Extended"/>

            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="RowHeight" Value="28"/>

            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style x:Key="LightColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource GridHeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource GridTextDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GridLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LightRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource GridText}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBg}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelBg}"/>
                    <Setter Property="Foreground" Value="{StaticResource SelFg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LightCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource GridText}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SelFg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text in display mode -->
        <Style x:Key="GridTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GridText}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Text in edit mode (DataGridTextColumn uses TextBox) -->
        <Style x:Key="GridEditTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource GridText}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#9FB7DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="CaretBrush" Value="{StaticResource GridText}"/>
        </Style>

        <!-- Checkbox alignment -->
        <Style x:Key="GridCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

    </Window.Resources>

    <DockPanel Margin="12" Background="{StaticResource ShellBg}">

        <!-- ===== Top bar ===== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource ShellBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Search:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource ShellTextDim}"/>

                <TextBox x:Name="TxtSearch"
                         Grid.Column="1"
                         Style="{StaticResource TopTextBoxStyle}"
                         TextChanged="TxtSearch_TextChanged"/>

                <CheckBox x:Name="ChkShowOnlyEditable"
                          Grid.Column="2"
                          Style="{StaticResource TopCheckBoxStyle}"
                          Content="Only editable"
                          VerticalAlignment="Center"
                          Margin="12,0,12,0"
                          Checked="ChkShowOnlyEditable_Changed"
                          Unchecked="ChkShowOnlyEditable_Changed"/>

                <Button Grid.Column="3"
                        Style="{StaticResource TopButtonStyle}"
                        Content="Reload"
                        Width="110"
                        Margin="0,0,8,0"
                        Click="BtnReload_Click"/>

                <Button Grid.Column="4"
                        Style="{StaticResource TopButtonStyle}"
                        Content="Apply changes"
                        Width="140"
                        Margin="0,0,8,0"
                        Click="BtnApply_Click"/>

                <Button Grid.Column="5"
                        Style="{StaticResource TopButtonStyle}"
                        Content="Close"
                        Width="110"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ===== Grid area ===== -->
        <Border Background="{StaticResource PanelBg2}"
                BorderBrush="{StaticResource ShellBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- White sheet -->
                <Border Grid.Row="0"
                        Background="{StaticResource GridBg}"
                        BorderBrush="{StaticResource ShellBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0">

                    <DataGrid x:Name="GridTypes"
                              Style="{StaticResource LightDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource LightColumnHeaderStyle}"
                              RowStyle="{StaticResource LightRowStyle}"
                              CellStyle="{StaticResource LightCellStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" IsReadOnly="True" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextBlockStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Family" Binding="{Binding FamilyName}" IsReadOnly="True" Width="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextBlockStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Type name" Binding="{Binding TypeName}" IsReadOnly="True" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextBlockStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Text size (mm)"
                                                Binding="{Binding TextSizeMm, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                IsReadOnly="{Binding IsTextSizeReadOnly}"
                                                Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextBlockStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource GridEditTextBoxStyle}"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Font"
                                                Binding="{Binding TextFont, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="{Binding IsTextFontReadOnly}"
                                                Width="260">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextBlockStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource GridEditTextBoxStyle}"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridCheckBoxColumn Header="Editable"
                                                    Binding="{Binding IsEditable}"
                                                    IsReadOnly="True"
                                                    Width="90"
                                                    ElementStyle="{StaticResource GridCheckBoxStyle}"/>

                            <DataGridTemplateColumn Header="Notes" Width="260" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Notes}"
                                                   Foreground="{StaticResource GridTextDim}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Grid.Row="1"
                           Margin="6,10,6,2"
                           Foreground="{StaticResource ShellTextDim}"
                           Text="{Binding StatusText}"/>
            </Grid>
        </Border>

    </DockPanel>
</Window>