<Window x:Class="BA.UI.InputTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="70"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptTextBlock"
                   Grid.Row="0"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap" />
        <TextBox x:Name="InputTextBox"
                 Grid.Row="1"
                 MinWidth="300"
                 MinHeight="70"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 PreviewKeyDown="InputTextBox_PreviewKeyDown" />
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Width="75" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OkButton_Click">OK</Button>
            <Button Width="75"
                    IsCancel="True"
                    Click="CancelButton_Click">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>