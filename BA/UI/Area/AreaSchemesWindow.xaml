<Window x:Class="BA.UI.AreaSchemes.AreaSchemesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Area Schemes"
        Width="640" Height="520"
        MinWidth="500" MinHeight="400"
                Background="#0F0F10"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        FontSize="12"
        >


    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource Thickness.WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Area Schemes"
                       FontSize="18" FontWeight="Bold"
                       Style="{StaticResource BaLabelText}"/>
            <TextBlock Text="ČSN EN 15221 — LA / NLA / GFA / ECA / IFA / ICA / NFA / PWA / NRA"
                       FontSize="11"
                       Style="{StaticResource BaMutedTextDark}"/>
        </StackPanel>

        <!-- Level selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Level:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Style="{StaticResource BaLabelText}"/>
            <ComboBox ItemsSource="{Binding Levels}"
                      SelectedItem="{Binding SelectedLevel}"
                      DisplayMemberPath="Name"
                      Width="220"
                      Style="{StaticResource BaDarkComboBox}"/>
        </StackPanel>

        <!-- Step content -->
        <Border Grid.Row="2" Style="{StaticResource BaDarkPanelBorder}">
            <StackPanel>

                <!-- Step indicator -->
                <TextBlock Style="{StaticResource BaMutedTextDark}"
                           FontSize="11"
                           Margin="0,0,0,6">
                    <Run Text="Step "/>
                    <Run Text="{Binding CurrentStepNumber, Mode=OneWay}"/>
                    <Run Text=" out of "/>
                    <Run Text="{Binding TotalSteps, Mode=OneWay}"/>
                </TextBlock>

                <!-- Scheme name -->
                <TextBlock Text="{Binding CurrentDefinition.DisplayName}"
                           FontSize="16" FontWeight="SemiBold"
                           Style="{StaticResource BaDarkPanelText}"
                           Margin="0,0,0,4"/>

                <!-- Code + description -->
                <TextBlock Style="{StaticResource BaDarkPanelText}">
                    <Run Text="{Binding CurrentDefinition.Code, Mode=OneWay}"
                         FontWeight="Bold"/>
                    <Run Text=" — "/>
                    <Run Text="{Binding CurrentDefinition.Description, Mode=OneWay}"/>
                </TextBlock>

                <Separator Background="{StaticResource Brush.DarkPanelBorder}"
                           Margin="0,12"/>

                <!-- View status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource BaDarkPanelText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <!-- Computed step notice -->
                <Border Background="#22FFAA00"
                        CornerRadius="4"
                        Padding="10,6"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsComputed,
                            Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Tento krok se vypočítá automaticky z předchozích kroků."
                               Foreground="#FFFFAA44"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Create View"
                            Command="{Binding CreateViewCommand}"
                            Style="{StaticResource BaSecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Open View"
                            Command="{Binding OpenViewCommand}"
                            Style="{StaticResource BaSecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Pick Elements"
                            Command="{Binding PickElementsCommand}"
                            Style="{StaticResource BaSecondaryButton}"
                            Visibility="{Binding CanPickElements,
                                Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Navigation -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <Button Content="← Back"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource BaSecondaryButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Next →"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource BaPrimaryButton}"
                    Margin="0,0,8,0"/>
            <Button Content="✓  Finish and apply"
                    Command="{Binding FinishCommand}"
                    Style="{StaticResource BaPrimaryButton}"
                    Visibility="{Binding IsLastStep,
                        Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Busy indicator -->
        <Border Grid.Row="4"
                Style="{StaticResource BaDarkPanelBorder}"
                Margin="0,8,0,0"
                Visibility="{Binding IsBusy,
                    Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Načítám..."
                       Style="{StaticResource BaMutedTextDark}"
                       FontSize="11"/>
        </Border>

    </Grid>
</Window>