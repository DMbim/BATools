<Window x:Class="BA.UI.Views.AreaMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BA.UI.Converters"
        Title="Czech Area Compliance — Výpočet ploch"
        Width="900" Height="640"
        MinWidth="720" MinHeight="480"
        Background="#FF1E1E2E"
        Foreground="#FFCDD6F4"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <conv:BoolToVisibilityConverter   x:Key="BoolToVis"/>
        <conv:StatusToColorConverter      x:Key="StatusToColor"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Czech Area Compliance"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#FFCDD6F4"/>
            <TextBlock Text="Výpočet ploch dle platné české legislativy"
                       FontSize="11" Foreground="#FF6C7086"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Area type selection -->
            <Border Grid.Column="0"
                    Background="#FF181825"
                    CornerRadius="6"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Typy ploch"
                               FontWeight="SemiBold"
                               Foreground="#FF9399B2"
                               FontSize="11"
                               Margin="0,0,0,8"/>

                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <Button Content="Vše"
                                Command="{Binding SelectAllCommand}"
                                Background="#FF313244"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="8,4"
                                Margin="0,0,6,0"
                                FontSize="11"/>
                        <Button Content="Nic"
                                Command="{Binding SelectNoneCommand}"
                                Background="#FF313244"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="8,4"
                                FontSize="11"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding AreaTypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2"
                                        Padding="8"
                                        CornerRadius="5"
                                        Background="#FF24273A">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="#FFCDD6F4"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LegalCitation}"
                                                   Foreground="#FF6C7086"
                                                   FontSize="10"
                                                   Margin="22,3,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ValidFrom, StringFormat='Platné od: {0}'}"
                                                   Foreground="#FF585B70"
                                                   FontSize="10"
                                                   Margin="22,1,0,0"/>
                                        <Border Background="#22FFAA00"
                                                CornerRadius="3"
                                                Padding="5,2"
                                                Margin="22,4,0,0"
                                                Visibility="{Binding HasScopeNote,
                                                    Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ScopeNote}"
                                                       Foreground="#FFFFAA44"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="#FF313244"/>

            <!-- Right: Results -->
            <Border Grid.Column="2"
                    Background="#FF181825"
                    CornerRadius="6"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Výsledky výpočtu"
                               FontWeight="SemiBold"
                               Foreground="#FF9399B2"
                               FontSize="11"
                               Margin="0,0,0,8"/>

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding ResultSummary}"
                               Foreground="#FF6C7086"
                               FontSize="11"
                               Margin="0,6,0,0"/>

                    <!-- Detail panel -->
                    <Border DockPanel.Dock="Bottom"
                            Background="#FF24273A"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,6,0,0"
                            MinHeight="70"
                            Visibility="{Binding SelectedResult,
                                Converter={StaticResource BoolToVis},
                                TargetNullValue=Collapsed}">
                        <StackPanel>
                            <TextBlock Text="Detail výpočtu"
                                       FontWeight="SemiBold"
                                       Foreground="#FF9399B2"
                                       FontSize="10"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedResult.DeductionSummary}"
                                       Foreground="#FFCDD6F4"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#FF6C7086">
                                <Run Text="Norma: "/>
                                <Run Text="{Binding SelectedResult.NormCitation}"/>
                                <Run Text=" | Platné od: "/>
                                <Run Text="{Binding SelectedResult.NormValidFrom}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Progress -->
                    <ProgressBar DockPanel.Dock="Top"
                                 Height="3"
                                 Margin="0,0,0,6"
                                 Background="#FF313244"
                                 Foreground="#FF1E66F5"
                                 Value="{Binding ProgressValue}"
                                 Maximum="100"
                                 Visibility="{Binding IsComputing,
                                     Converter={StaticResource BoolToVis}}"/>

                    <!-- Results grid -->
                    <DataGrid ItemsSource="{Binding Results}"
                              SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              Background="Transparent"
                              Foreground="#FFCDD6F4"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#FF313244"
                              RowBackground="#FF24273A"
                              AlternatingRowBackground="#FF1E2030"
                              ColumnHeaderHeight="32"
                              RowHeight="28"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Prvek"
                                                Binding="{Binding ElementName}"
                                                Width="140"/>
                            <DataGridTextColumn Header="Typ plochy"
                                                Binding="{Binding AreaTypeName}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Plocha"
                                                Binding="{Binding AreaM2}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Podlaží"
                                                Binding="{Binding FloorClassText}"
                                                Width="80"/>
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding Result.Status,
                                                       Converter={StaticResource StatusToColor}}"
                                                   VerticalAlignment="Center"
                                                   Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Action bar -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,4">
            <Button Content="▶  Vypočítat"
                    Command="{Binding ComputeCommand}"
                    Background="#FF1E66F5"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="14,7"
                    Margin="0,0,6,0"/>
            <Button Content="✕  Zrušit"
                    Command="{Binding CancelCommand}"
                    Background="#FFDF3F5A"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="14,7"
                    Margin="0,0,6,0"
                    Visibility="{Binding IsComputing,
                        Converter={StaticResource BoolToVis}}"/>
            <Button Content="🎨  Vizualizovat"
                    Command="{Binding VisualizeCommand}"
                    Background="#FF40A02B"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="14,7"
                    Margin="0,0,6,0"/>
            <Button Content="✕  Smazat vizualizace"
                    Command="{Binding ClearVizCommand}"
                    Background="#FFDF8E1D"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="14,7"
                    Margin="0,0,6,0"/>
            <Button Content="💾  Zapsat parametry"
                    Command="{Binding WriteParamsCommand}"
                    Background="#FF8839EF"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="14,7"/>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="#FF181825"
                CornerRadius="4"
                Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#FF6C7086"
                       FontSize="11"/>
        </Border>
    </Grid>
</Window>