<Window x:Class="BA.UI.Management.TemplateCheckerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Template Checker"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F10"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Primary / Secondary Buttons -->
        <Style x:Key="BaPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F0F10"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaSecondaryButton" TargetType="Button" BasedOn="{StaticResource BaPrimaryButton}">
            <Setter Property="Background" Value="#1A1A1C"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
        </Style>

        <!-- Inputs -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#101012"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#141416"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202024"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Makes the dropdown panel itself dark (Popup/List) -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#101012"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D6D6DA"/>
        </Style>

        <!-- Card -->
        <Style x:Key="BaCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#141416"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#101012"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#101012"/>
            <Setter Property="AlternatingRowBackground" Value="#141416"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#141416"/>
            <Setter Property="Foreground" Value="#CFCFD6"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=RowBackground}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A2A2E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202024"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A2A2E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="BA"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       Margin="0,0,8,0"/>
            <TextBlock Text="Template Checker"
                       FontSize="18"
                       Foreground="#B7B7BC"
                       VerticalAlignment="Bottom"/>
        </DockPanel>

        <!-- Controls -->
        <Border Grid.Row="1" Style="{StaticResource BaCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="View Template"
                           FontWeight="SemiBold"
                           Foreground="#F2F2F2"
                           Margin="0,0,0,6"/>
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CmbTemplates"/>

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="Standard File"
                           FontWeight="SemiBold"
                           Foreground="#F2F2F2"
                           Margin="12,0,0,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtFile" Margin="12,0,12,0"/>

                <StackPanel Grid.Row="1" Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Browse..." Width="90" Margin="0,0,8,0"
                            Style="{StaticResource BaSecondaryButton}"
                            Click="BtnBrowse_Click"/>
                    <Button Content="Save Standard" Width="120" Margin="0,0,8,0"
                            Style="{StaticResource BaPrimaryButton}"
                            Click="BtnSave_Click"/>
                    <Button Content="Check" Width="90" Margin="0,0,8,0"
                            Style="{StaticResource BaPrimaryButton}"
                            Click="BtnCheck_Click"/>
                    <Button Content="Apply" Width="90"
                            Style="{StaticResource BaPrimaryButton}"
                            Click="BtnApply_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Diff grid -->
        <Border Grid.Row="2" Style="{StaticResource BaCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtSummary"
                               Text="No check performed."
                               Foreground="#B7B7BC"/>
                    <CheckBox x:Name="ChkOnlyMismatches"
                              Content="Only mismatches"
                              Margin="16,0,0,0"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Checked="ChkOnlyMismatches_Changed"
                              Unchecked="ChkOnlyMismatches_Changed"/>
                </DockPanel>

                <DataGrid Grid.Row="1" x:Name="GridDiff"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          ColumnWidth="*">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="110"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="1.5*"/>
                        <DataGridTextColumn Header="Standard" Binding="{Binding StandardValue}" Width="*"/>
                        <DataGridTextColumn Header="Current" Binding="{Binding CurrentValue}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Mismatch" Binding="{Binding IsMismatch}" Width="90"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Width="90" IsCancel="True" Style="{StaticResource BaSecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
