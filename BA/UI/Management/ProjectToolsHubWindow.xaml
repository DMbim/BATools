<Window x:Class="BA.UI.Management.ProjectToolsHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Project Tools"
        Width="420" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Project Utilities"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <Button Height="44" Margin="0,0,0,10"
                    Content="Parameter Manager"
                    Click="BtnParameterManager_Click"/>

            <Button Height="44" Margin="0,0,0,10"
                    Content="Template Tools (placeholder)"
                    Click="BtnTemplateTools_Click"/>

            <Button Height="44"
                    Content="Family Tools (placeholder)"
                    Click="BtnFamilyTools_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="90" IsCancel="True" Content="Close"/>
        </StackPanel>
    </Grid>
</Window>
