<Window x:Class="BA.UI.Finishes.ApplyFinishesByRoomsWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
            xmlns:core="clr-namespace:BA.Core" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            Title="Apply Finishes by Rooms"
            Height="720" Width="980"
            WindowStartupLocation="CenterScreen"
            Background="#0F0F10" Foreground="#F2F2F2"
            FontFamily="Segoe UI">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnRefreshRooms" Content="Refresh rooms" Width="140" Margin="0,0,8,0" Click="BtnRefreshRooms_Click"/>
            <Button x:Name="BtnPickRooms" Content="Pick in model (Rooms/Tags)" Width="220" Margin="0,0,8,0" Click="BtnPickRooms_Click"/>
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="8,0,6,0"/>
            <TextBox x:Name="TxtSearch" Width="240" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Rooms list -->
            <GroupBox Header="Rooms" Grid.Column="0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6"
                                   Text="Select one or more rooms. Use Ctrl/Shift for multi-select."/>
                    <ListBox x:Name="ListRooms" SelectionMode="Extended"
                                 DisplayMemberPath="Display"/>
                </DockPanel>
            </GroupBox>

            <!-- Options -->
            <GroupBox Header="Finish Options" Grid.Column="2" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Apply to:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkWalls" Content="Walls" IsChecked="True" Margin="0,0,16,0" Foreground="#FFFBF3F3"/>
                            <CheckBox x:Name="ChkFloors" Content="Floors" IsChecked="False" Margin="0,0,16,0" Foreground="#FFF9F4F4"/>
                            <CheckBox x:Name="ChkCeilings" Content="Ceilings" IsChecked="False" Foreground="#FFF9F4F4"/>
                        </StackPanel>

                        <Separator Margin="0,2,0,10"/>

                        <TextBlock Text="Finish Types:" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <TextBlock Text="Finish wall type" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbWallType" MinWidth="260" Margin="0,0,0,10"/>

                        <TextBlock Text="Finish floor type" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbFloorType" MinWidth="260" Margin="0,0,0,10"/>

                        <TextBlock Text="Finish ceiling type" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbCeilingType" MinWidth="260" Margin="0,0,0,10"/>

                        <Separator Margin="0,2,0,10"/>

                        <TextBlock Text="Wall height controls:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkUseTopOffset" Content="Use top offset (subtract from room height)" IsChecked="True" Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Top offset (mm)" Width="140" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTopOffsetMm" Width="120" Text="100"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Base offset (mm)" Width="140" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtBaseOffsetMm" Width="120" Text="0"/>
                        </StackPanel>

                        <Separator Margin="0,2,0,10"/>

                        <TextBlock Text="Created element parameters:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="This tool writes:" Margin="0,0,0,4"/>
                        <TextBlock Text="• Mark = Room Number" Margin="0,0,0,2"/>
                        <TextBlock Text="• Comments = Finish by room: &lt;Number&gt; - &lt;Name&gt;" Margin="0,0,0,10"/>

                        <Button x:Name="BtnRun" Content="Create finishes" Height="42" Click="BtnRun_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>