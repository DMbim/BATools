<Window x:Class="BA.UI.Parameters.CreateSharedParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Bind Shared Parameters"
        Width="1080"
        Height="900"
        MinWidth="980"
        MinHeight="900"
        Style="{StaticResource BaWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA.UI;A_Templ/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource BaLabelText}"
                       Margin="0,0,8,0"
                       Text="Shared file:"/>

            <TextBox Grid.Column="1"
                     x:Name="TxtPath"
                     Style="{StaticResource BaReadOnlyTextBox}"/>

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Width="90"
                    Style="{StaticResource BaSecondaryButton}"
                    Content="Browse..."
                    Click="BtnBrowse_Click"/>
        </Grid>

        <!-- Main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="TxtFilter"
                             Width="340"
                             Style="{StaticResource BaTextBox}"
                             TextChanged="TxtFilter_TextChanged"
                             ToolTip="Filter by name, group, GUID"/>

                    <TextBlock Margin="10,0,0,0"
                               Style="{StaticResource BaMutedTextDark}"
                               Text="Tip: Ctrl/Shift for multi-select"/>
                </StackPanel>

                <ListBox x:Name="ListDefs"
                         Style="{StaticResource BaListBox}"
                         ItemContainerStyle="{StaticResource BaListBoxItem}"
                         SelectionMode="Extended"
                         DisplayMemberPath="Display"
                         SelectionChanged="ListDefs_SelectionChanged"/>
            </DockPanel>

            <Separator Grid.Column="1"
                       Margin="0"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Center"
                       Width="1"/>

            <!-- Right -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Preview -->
                <Border Grid.Row="0"
                        Style="{StaticResource BaPanelBorder}"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BaSectionTitleText}"
                                   Text="Selection preview"/>

                        <TextBlock x:Name="TxtSelectedDefs"
                                   Style="{StaticResource BaPanelText}"
                                   Text="Selected: 0"/>

                        <TextBlock x:Name="TxtSelectedFamilies"
                                   Style="{StaticResource BaPanelText}"
                                   Margin="0,2,0,0"
                                   Text="Families selected: 0"/>

                        <TextBlock x:Name="TxtAlreadyBound"
                                   Style="{StaticResource BaPanelText}"
                                   Margin="0,2,0,0"
                                   Text="Already bound in project: 0"/>

                        <TextBlock Style="{StaticResource BaPanelText}"
                                   Margin="0,8,0,4"
                                   Text="Bound items (project):"/>

                        <ListBox x:Name="ListBoundPreview"
                                 Height="90"
                                 Style="{StaticResource BaListBox}"
                                 ItemContainerStyle="{StaticResource BaListBoxItem}"/>
                    </StackPanel>
                </Border>

                <!-- Settings -->
                <Border Grid.Row="1"
                        Style="{StaticResource BaPanelBorder}"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BaSectionTitleText}"
                                   Text="Binding settings"/>

                        <TextBlock Style="{StaticResource BaPanelText}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"
                                   Text="Mode"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="RbBindToCategories"
                                         Style="{StaticResource BaPanelCheckBox}"
                                         Content="Bind to Categories (Project Parameter)"
                                         IsChecked="True"
                                         Margin="0,0,14,0"
                                         Checked="Mode_Checked"/>

                            <RadioButton x:Name="RbInjectIntoFamilies"
                                         Style="{StaticResource BaPanelCheckBox}"
                                         Content="Inject into Families (Family Instance Parameter)"
                                         Checked="Mode_Checked"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Width="120"
                                       Style="{StaticResource BaPanelText}"
                                       Text="Instance/Type:"/>
                            <ComboBox x:Name="CmbInstanceType"
                                      Width="200"
                                      Style="{StaticResource BaComboBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Width="120"
                                       Style="{StaticResource BaPanelText}"
                                       Text="Group:"/>
                            <ComboBox x:Name="CmbGroup"
                                      Width="320"
                                      Style="{StaticResource BaComboBox}"
                                      DisplayMemberPath="Label"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkCreateIfMissing"
                                  Style="{StaticResource BaPanelCheckBox}"
                                  Content="If not found in file, create new definition in SP file (String)"/>

                        <CheckBox x:Name="ChkMergeCategories"
                                  Style="{StaticResource BaPanelCheckBox}"
                                  Margin="0,0,0,0"
                                  Content="Merge with existing project categories (do not replace)"/>
                    </StackPanel>
                </Border>

                <!-- Categories -->
                <Border x:Name="BorderCategories"
                        Grid.Row="2"
                        Style="{StaticResource BaPanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left"
                                       Style="{StaticResource BaSectionTitleText}"
                                       Margin="0"
                                       Text="Categories"/>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Padding="8,2"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource BaPanelButton}"
                                        Content="All"
                                        Click="BtnCatsAll_Click"/>
                                <Button Padding="8,2"
                                        Style="{StaticResource BaPanelButton}"
                                        Content="None"
                                        Click="BtnCatsNone_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource BaScrollViewer}">
                            <ItemsControl x:Name="CatsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  Style="{StaticResource BaPanelCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Families -->
                <Border x:Name="BorderFamilies"
                        Grid.Row="2"
                        Style="{StaticResource BaPanelBorder}"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left"
                                       Style="{StaticResource BaSectionTitleText}"
                                       Margin="0"
                                       Text="Families"/>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Padding="8,2"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource BaPanelButton}"
                                        Content="All"
                                        Click="BtnFamiliesAll_Click"/>
                                <Button Padding="8,2"
                                        Style="{StaticResource BaPanelButton}"
                                        Content="None"
                                        Click="BtnFamiliesNone_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBox Grid.Row="1"
                                 x:Name="TxtFamilyFilter"
                                 Margin="0,0,0,8"
                                 Style="{StaticResource BaTextBox}"
                                 TextChanged="TxtFamilyFilter_TextChanged"
                                 ToolTip="Filter families by name"/>

                        <ScrollViewer Grid.Row="2"
                                      Style="{StaticResource BaScrollViewer}">
                            <ItemsControl x:Name="FamiliesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  Style="{StaticResource BaPanelCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Width="140"
                    Margin="0,0,8,0"
                    Style="{StaticResource BaPrimaryButton}"
                    Content="Bind selected"
                    IsDefault="True"
                    Click="BtnBind_Click"/>

            <Button Width="90"
                    Style="{StaticResource BaSecondaryButton}"
                    Content="Cancel"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>