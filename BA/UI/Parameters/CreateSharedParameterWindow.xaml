<Window x:Class="BA.UI.Parameters.CreateSharedParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Bind Shared Parameter"
        Width="820" Height="560"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Shared file:" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="TxtPath" Height="26" IsReadOnly="True"/>
            <Button Grid.Column="2" Margin="8,0,0,0" Width="90" Content="Browse..." Click="BtnBrowse_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Shared defs -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBox x:Name="TxtFilter" Height="26" Margin="0,0,0,8"
                         TextChanged="TxtFilter_TextChanged"
                         ToolTip="Filter shared parameter names"/>
                <ListBox x:Name="ListDefs" DisplayMemberPath="Name"/>
            </DockPanel>

            <Separator Grid.Column="1" Width="1" Margin="0,0,0,0"/>

            <!-- Right: binding settings -->
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock FontWeight="SemiBold" Text="Binding settings" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Width="120" VerticalAlignment="Center" Text="Instance/Type:"/>
                    <ComboBox x:Name="CmbInstanceType" Width="200"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Width="120" VerticalAlignment="Center" Text="Group:"/>
                    <ComboBox x:Name="CmbGroup" Width="340"/>
                </StackPanel>

                <CheckBox x:Name="ChkCreateIfMissing"
                          Margin="0,0,0,12"
                          Content="If not found in file, create new definition in SP file (dangerous)"/>

                <TextBlock FontWeight="SemiBold" Text="Categories" Margin="0,0,0,6"/>
                <ScrollViewer Height="290">
                    <ItemsControl x:Name="CatsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="120" Margin="0,0,8,0" Content="Bind" IsDefault="True" Click="BtnBind_Click"/>
            <Button Width="90" Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
