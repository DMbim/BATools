<Window x:Class="BA.UI.Parameters.CreateSharedParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Bind Shared Parameters"
        Width="1080" Height="640"
        MinWidth="980" MinHeight="900"
            Background="#0F0F10" Foreground="#F2F2F2" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Shared file path -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Shared file:" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="TxtPath" Height="26" IsReadOnly="True"/>
            <Button Grid.Column="2" Margin="8,0,0,0" Width="90" Content="Browse..." Click="BtnBrowse_Click"/>
        </Grid>

        <!-- Main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="107*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Shared defs -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="TxtFilter" Height="26" Width="340"
                             TextChanged="TxtFilter_TextChanged"
                             ToolTip="Filter by name, group, GUID"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFF5EEEE"
                               Text="Tip: Ctrl/Shift for multi-select"/>
                </StackPanel>

                <ListBox x:Name="ListDefs"
                         SelectionMode="Extended"
                         DisplayMemberPath="Display"
                         SelectionChanged="ListDefs_SelectionChanged" Width="555"/>
            </DockPanel>

            <Separator Grid.Column="1" Margin="4,0,355,0" Grid.ColumnSpan="2"/>

            <!-- Right: settings + preview -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Preview of what is already bound -->
                <Border Grid.Row="0" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="#D8D8D8" Background="#FAFAFA" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Selection preview" Margin="0,0,0,6" Foreground="#FF040404"/>
                        <TextBlock x:Name="TxtSelectedDefs" Text="Selected: 0" Foreground="#FF1B1B1B"/>
                        <TextBlock x:Name="TxtSelectedFamilies" Text="Families selected: 0" Margin="0,2,0,0" Foreground="#FF1B1B1B"/>
                        <TextBlock x:Name="TxtAlreadyBound" Text="Already bound in project: 0" Margin="0,2,0,0" Foreground="#FF1B1B1B"/>
                        <TextBlock Text="Bound items (project):" Margin="0,8,0,4" Foreground="#FF1B1B1B"/>
                        <ListBox x:Name="ListBoundPreview" Height="90"/>
                    </StackPanel>
                </Border>

                <!-- Binding settings -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock FontWeight="SemiBold" Text="Binding settings" Margin="0,0,0,10"/>

                    <TextBlock FontWeight="SemiBold" Text="Mode" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbBindToCategories" Content="Bind to Categories (Project Parameter)" IsChecked="True"
                                     Margin="0,0,14,0" Checked="Mode_Checked" Foreground="#FFFBFBFB"/>
                        <RadioButton x:Name="RbInjectIntoFamilies" Content="Inject into Families (Family Instance Parameter)"
                                     Checked="Mode_Checked" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Width="120" VerticalAlignment="Center" Text="Instance/Type:"/>
                        <ComboBox x:Name="CmbInstanceType" Width="200"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Width="120" VerticalAlignment="Center" Text="Group:"/>
                        <ComboBox x:Name="CmbGroup" Width="320" DisplayMemberPath="Label"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkCreateIfMissing"
                              Margin="0,0,0,4"
                              Content="If not found in file, create new definition in SP file (String)" Foreground="White"/>

                    <CheckBox x:Name="ChkMergeCategories"
                              Margin="0,0,0,8"
                              Content="Merge with existing project categories (do not replace)" Foreground="#FFFBFBFB"/>
                </StackPanel>

                <!-- Categories -->
                <Border x:Name="BorderCategories" Grid.Row="2" Padding="10" CornerRadius="6"
                        BorderThickness="1" BorderBrush="#D8D8D8" Background="#FAFAFA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Categories" Foreground="#FF151515"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Padding="8,2" Margin="0,0,6,0" Content="All" Click="BtnCatsAll_Click"/>
                                <Button Padding="8,2" Content="None" Click="BtnCatsNone_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl x:Name="CatsList" Foreground="#FF191818">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Families (used in Inject mode) -->
                <Border x:Name="BorderFamilies" Grid.Row="2" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="#D8D8D8" Background="#FAFAFA" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Families"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Padding="8,2" Margin="0,0,6,0" Content="All" Click="BtnFamiliesAll_Click"/>
                                <Button Padding="8,2" Content="None" Click="BtnFamiliesNone_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBox Grid.Row="1" x:Name="TxtFamilyFilter" Height="26" Margin="0,0,0,8"
                                 TextChanged="TxtFamilyFilter_TextChanged"
                                 ToolTip="Filter families by name"/>

                        <ScrollViewer Grid.Row="2">
                            <ItemsControl x:Name="FamiliesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="140" Margin="0,0,8,0" Content="Bind selected" IsDefault="True" Background="Black" Foreground="White" BorderBrush="#FFFFDCDC" Click="BtnBind_Click"/>
            <Button Width="90" Content="Cancel" Background="Black" Foreground="White" BorderBrush="#FFFFDCDC" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
