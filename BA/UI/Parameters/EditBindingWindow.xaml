<Window x:Class="BA.UI.Parameters.EditBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Edit Binding"
        Width="1100" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F10"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0F0F10"/>
        <SolidColorBrush x:Key="Card" Color="#121214"/>
        <SolidColorBrush x:Key="Field" Color="#1B1B1C"/>
        <SolidColorBrush x:Key="Border" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="6,2"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B1B1C"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12" Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold"
                   Text="{Binding Header}" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: selection -->
            <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Selected parameters"/>
                        <TextBlock DockPanel.Dock="Right" x:Name="TxtSelCount" Foreground="#B7B7BC"/>
                    </DockPanel>

                    <ListBox Grid.Row="1" x:Name="ListSelectedParams"/>
                </Grid>
            </Border>

            <Separator Grid.Column="1" Width="1" Margin="4,0"/>

            <!-- Right: settings -->
            <Border Grid.Column="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Instance/Type:"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbInstanceType"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Group:" Margin="0,8,0,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbGroup" Margin="0,8,0,0" DisplayMemberPath="Label"/>
                    </Grid>

                    <CheckBox Grid.Row="1" x:Name="ChkMergeCategories" Margin="0,10,0,0"
                              Content="Merge categories with existing (do not replace)"/>

                    <DockPanel Grid.Row="2" Margin="0,10,0,8">
                        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Categories"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Padding="8,2" Margin="0,0,6,0" Content="All" Click="BtnCatsAll_Click"/>
                            <Button Padding="8,2" Margin="0,0,6,0" Content="None" Click="BtnCatsNone_Click"/>
                            <TextBlock x:Name="TxtCatCount" Foreground="#B7B7BC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <ListBox Grid.Row="3" x:Name="CatsList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="140" Margin="0,0,8,0" Content="Apply" IsDefault="True" Click="BtnApply_Click"/>
            <Button Width="90" Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
