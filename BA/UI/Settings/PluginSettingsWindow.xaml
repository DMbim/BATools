<Window x:Class="BA.UI.Settings.PluginSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Plugin Settings"
        Width="980" Height="650"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F10"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSearch"
                         Height="28"
                         Background="#1B1B1C"
                         Foreground="#F2F2F2"
                         BorderBrush="#3A3A3D"
                         Padding="6,3"
                         TextChanged="TxtSearch_TextChanged"/>
            </DockPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Margin="0,0,8,0" Content="Enable All" Click="BtnEnableAll_Click"/>
                <Button Width="110" Margin="0,0,8,0" Content="Disable All" Click="BtnDisableAll_Click"/>
                <Button Width="110" Content="Reset Defaults" Click="BtnReset_Click"/>
            </StackPanel>
        </Grid>

        <!-- Data -->
        <DataGrid Grid.Row="1"
                  x:Name="GridToggles"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  Background="#121214"
                  BorderBrush="#3A3A3D">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On"
                                        Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="55"/>

                <DataGridTextColumn Header="Group" Binding="{Binding Group}" IsReadOnly="True" Width="160"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="260"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="260"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Opacity="0.75"
                       Text="Tip: Prefer guards that stay subscribed and early-exit when disabled (safe + simple)."/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="120" Margin="0,0,8,0" Content="Apply" Click="BtnApply_Click"/>
                <Button Width="140" Margin="0,0,8,0" Content="Save and Close" Click="BtnSaveClose_Click"/>
                <Button Width="100" Content="Close" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>