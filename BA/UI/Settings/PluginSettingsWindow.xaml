<Window x:Class="BA.UI.Settings.PluginSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Plugin Settings"
        Width="980" Height="650"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource BaWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Local toggle-switch style for the "On" column.
                 DataGridCheckBoxColumn resists dark styling, so this replaces it with
                 a templated Button + DataTrigger + explicit RelayCommand (ToggleRow.ToggleCommand),
                 per the established project pattern. If you end up needing this in another
                 grid, promote it into Theme.xaml as a shared BaToggleButton style instead
                 of copy-pasting it, for now it's scoped locally to this window. -->
            <Style x:Key="BaToggleButtonCell" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Track"
                                    CornerRadius="10"
                                    Background="{StaticResource Brush.ControlBg}"
                                    BorderBrush="{StaticResource Brush.ControlBorder}"
                                    BorderThickness="1">
                                <Grid>
                                    <Ellipse x:Name="Knob"
                                             Width="14" Height="14"
                                             Fill="{StaticResource Brush.MutedTextLightPanel}"
                                             HorizontalAlignment="Left"
                                             Margin="2,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Selected}"/>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}"/>
                                    <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Brush.WindowFg}"/>
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource Thickness.WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock Text="Search:" Style="{StaticResource BaLabelText}" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSearch"
                         Style="{StaticResource BaDarkTextBox}"
                         TextChanged="TxtSearch_TextChanged"/>
            </DockPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Margin="0,0,8,0" Content="Enable All" Style="{StaticResource BaSecondaryButton}" Click="BtnEnableAll_Click"/>
                <Button Width="110" Margin="0,0,8,0" Content="Disable All" Style="{StaticResource BaSecondaryButton}" Click="BtnDisableAll_Click"/>
                <Button Width="110" Content="Reset Defaults" Style="{StaticResource BaSecondaryButton}" Click="BtnReset_Click"/>
            </StackPanel>
        </Grid>

        <!-- Data -->
        <DataGrid Grid.Row="1"
                  x:Name="GridToggles"
                  Style="{StaticResource BaDataGrid}"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="On" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding ToggleCommand}"
                                    Style="{StaticResource BaToggleButtonCell}"
                                    Content="{Binding Value}"
                                    HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Group" Binding="{Binding Group}" IsReadOnly="True" Width="160"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="260"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="260"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource BaLabelText}"
                       Opacity="0.75"
                       Text="Tip: Prefer guards that stay subscribed and early-exit when disabled (safe + simple)."/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="120" Margin="0,0,8,0" Content="Apply" Style="{StaticResource BaSecondaryButton}" Click="BtnApply_Click"/>
                <Button Width="140" Margin="0,0,8,0" Content="Save and Close" Style="{StaticResource BaPrimaryButton}" Click="BtnSaveClose_Click"/>
                <Button Width="100" Content="Close" Style="{StaticResource BaSecondaryButton}" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>