<Window x:Class="BA.UI.Settings.RevitLeadersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA | Revit Leaders"
        Width="520" Height="470"
        MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource BaWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource Thickness.WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource BaLabelText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="Revit Leaders can create and edit shared parameters. Entries are Autodesk account names exactly as Revit reports them."/>

        <DataGrid Grid.Row="1"
                  x:Name="GridLeaders"
                  Style="{StaticResource BaDataGrid}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Autodesk username"
                                    Binding="{Binding Mode=OneWay}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="TxtNewLeader"
                     Style="{StaticResource BaDarkTextBox}"
                     Margin="0,0,8,0"/>
            <Button Grid.Column="1"
                    x:Name="BtnAdd"
                    Width="80"
                    Margin="0,0,8,0"
                    Content="Add"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="BtnAdd_Click"/>
            <Button Grid.Column="2"
                    x:Name="BtnAddMe"
                    Width="90"
                    Content="Add me"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="BtnAddMe_Click"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="TxtCurrentUser"
                       Style="{StaticResource BaLabelText}"
                       Opacity="0.75"/>
            <TextBlock x:Name="TxtStatus"
                       Margin="0,6,0,0"
                       Foreground="#FFC966"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="BtnRemove"
                    Width="140"
                    Margin="0,0,8,0"
                    Content="Remove selected"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="BtnRemove_Click"/>
            <Button Width="100"
                    Content="Close"
                    Style="{StaticResource BaSecondaryButton}"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>