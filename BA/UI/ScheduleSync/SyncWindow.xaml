<Window x:Class="BA.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA Schedule Sync"
        Height="600"
        Width="1000"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPanel" Color="#11151C"/>
        <SolidColorBrush x:Key="BgInput" Color="#161B22"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#2C3440"/>
    </Window.Resources>

    <DockPanel>

        <!-- TOP BAR -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="10">

            <StackPanel Orientation="Horizontal">

                <Button Content="Add Mapping" Command="{Binding AddCommand}"/>
                <Button Content="Remove" Command="{Binding RemoveCommand}"/>
                <Button Content="Sync Now" Command="{Binding SyncCommand}"/>

            </StackPanel>
        </Border>

        <!-- MAIN GRID -->
        <Grid Margin="10">

            <DataGrid ItemsSource="{Binding Mappings}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False">

                <DataGrid.Columns>

                    <!-- Schedule -->
                    <DataGridTemplateColumn Header="Schedule" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Schedules, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Schedule}"
                                          DisplayMemberPath="Name"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Source -->
                    <DataGridTemplateColumn Header="Source Column" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding SourceColumn}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Destination -->
                    <DataGridTemplateColumn Header="Destination Param" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Parameters, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding DestinationParameter}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>
    </DockPanel>
</Window>
