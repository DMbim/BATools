<Window x:Class="BA.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA Schedule Sync"
        Height="600"
        Width="700"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="BgPanel" Color="#11151C"/>
            <SolidColorBrush x:Key="BgInput" Color="#161B22"/>
            <SolidColorBrush x:Key="BorderSoft" Color="#2C3440"/>

            <Style x:Key="DarkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1A1A1D"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#222226"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#17171A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource BgPanel}"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="RowBackground" Value="{StaticResource BgPanel}"/>
                <Setter Property="AlternatingRowBackground" Value="#16161A"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowHeight" Value="28"/>
                <Setter Property="AlternationCount" Value="2"/>
            </Style>

            <Style x:Key="DarkColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#16161A"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- TOP BAR -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Add Mapping" Command="{Binding AddCommand}" Margin="0,0,6,0" Style="{StaticResource DarkButtonStyle}"/>
                <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="0,0,6,0" Style="{StaticResource DarkButtonStyle}"/>
                <Button Content="Sync Now" Command="{Binding SyncCommand}" Style="{StaticResource DarkButtonStyle}"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#A0A8B4"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- SCHEDULE SELECTOR -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Schedule:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A0A8B4"/>
                <ComboBox ItemsSource="{Binding Schedules}"
                          SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                DisplayMemberPath="Name"
                  Style="{StaticResource BaDarkComboBox}"
                  Width="320"/>
            </StackPanel>
        </Border>

        <!-- MAPPING GRID -->
        <Grid Margin="10">
            <DataGrid ItemsSource="{Binding Mappings}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Style="{StaticResource DarkDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DarkColumnHeaderStyle}">

                <DataGrid.Columns>

                    <!-- Source Column -->
                    <DataGridTemplateColumn Header="Source Column" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding SourceColumn, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BaDarkComboBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Destination Parameter -->
                    <DataGridTemplateColumn Header="Destination Parameter" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Parameters, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding DestinationParameter, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BaDarkComboBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>
        </Grid>

    </DockPanel>
</Window>
