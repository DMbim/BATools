<Window
    x:Class="BATools.SelectionManager.Views.ToolbarSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Toolbar Settings"
    Width="400"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="ToolWindow"
    ShowInTaskbar="False"
    FontFamily="Segoe UI"
    FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Background on Grid — cannot reference Window.Resources from Window attributes -->
    <Grid Background="{StaticResource Brush.WindowBg}">
        <StackPanel Margin="20,16,20,20">

            <!-- ── TOGGLE section ───────────────────────────────── -->
            <TextBlock Text="TOGGLE TOOLBAR"
                       Style="{StaticResource BaMutedTextDark}"
                       FontSize="9" FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gesture:"
                           Style="{StaticResource BaLabelText}"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1"
                          Style="{StaticResource BaDarkComboBox}"
                          Foreground="{StaticResource Brush.WindowFg}"
                          ItemsSource="{Binding ToggleOptions}"
                          SelectedItem="{Binding ToggleShortcut, Mode=TwoWay}"/>
            </Grid>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Time window:"
                           Style="{StaticResource BaLabelText}"
                           VerticalAlignment="Center"
                           ToolTip="Max milliseconds between two key presses"/>
                <Slider Grid.Column="1"
                        Minimum="150" Maximum="600"
                        Value="{Binding ToggleWindowMs, Mode=TwoWay}"
                        TickFrequency="50" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding ToggleWindowMs, StringFormat='{}{0} ms'}"
                           Style="{StaticResource BaMutedTextDark}"
                           FontSize="10" Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Divider -->
            <Border Height="1"
                    Background="{StaticResource Brush.DarkPanelBorder}"
                    Margin="0,16,0,16"/>

            <!-- ── FREEZE section ────────────────────────────────── -->
            <TextBlock Text="FREEZE CURSOR"
                       Style="{StaticResource BaMutedTextDark}"
                       FontSize="9" FontWeight="SemiBold"
                       Margin="0,0,0,2"/>
            <TextBlock Text="Hold key to stop tracking — lets cursor enter toolbar"
                       Style="{StaticResource BaMutedTextDark}"
                       FontSize="9" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gesture:"
                           Style="{StaticResource BaLabelText}"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1"
                          Style="{StaticResource BaDarkComboBox}"
                          Foreground="{StaticResource Brush.WindowFg}"
                          ItemsSource="{Binding FreezeOptions}"
                          SelectedItem="{Binding FreezeShortcut, Mode=TwoWay}"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Hold duration:"
                           Style="{StaticResource BaLabelText}"
                           VerticalAlignment="Center"
                           ToolTip="Milliseconds key must be held to trigger freeze"/>
                <Slider Grid.Column="1"
                        Minimum="300" Maximum="1200"
                        Value="{Binding FreezeHoldMs, Mode=TwoWay}"
                        TickFrequency="50" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding FreezeHoldMs, StringFormat='{}{0} ms'}"
                           Style="{StaticResource BaMutedTextDark}"
                           FontSize="10" Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Info box -->
            <Border Style="{StaticResource BaDarkPanelBorder}"
                    Margin="0,16,0,0" Padding="10,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource BaDarkSectionTitleText}"
                               Text="How it works" FontSize="11"
                               Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource BaMutedTextDark}"
                               FontSize="10" TextWrapping="Wrap"
                               Text="Double-press toggle key — toolbar appears and tracks cursor."/>
                    <TextBlock Style="{StaticResource BaMutedTextDark}"
                               FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Hold freeze key — toolbar stops, cursor can click buttons."/>
                    <TextBlock Style="{StaticResource BaMutedTextDark}"
                               FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Hold freeze again — resumes tracking. Double-press to close."/>
                    <TextBlock Style="{StaticResource BaMutedTextDark}"
                               FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Toolbar border turns white while frozen."/>
                </StackPanel>
            </Border>

            <!-- Divider -->
            <Border Height="1"
                    Background="{StaticResource Brush.DarkPanelBorder}"
                    Margin="0,16,0,16"/>

            <!-- Buttons -->
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="Reset to defaults"
                        Command="{Binding ResetCommand}"
                        Style="{StaticResource BaSecondaryButton}"
                        Width="130"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource BaSecondaryButton}"
                            Width="80" Margin="0,0,8,0"/>
                    <Button Content="Save"
                            IsDefault="True"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource BaPrimaryButton}"
                            Width="80"/>
                </StackPanel>
            </DockPanel>

        </StackPanel>
    </Grid>
</Window>