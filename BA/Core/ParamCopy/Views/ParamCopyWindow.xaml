<Window x:Class="BATools.ParamCopy.Views.ParamCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BATools.ParamCopy.Models"
        Title="BA — Parameter Copy"
        Width="1400" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PcDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="#11151C"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="RowBackground" Value="#11151C"/>
                <Setter Property="AlternatingRowBackground" Value="#16161A"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#2C3440"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowHeight" Value="26"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            </Style>

            <Style x:Key="PcHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#16161A"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="PcRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2A3A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PcCellStyle" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="MutedLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#A0A8B4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <Style x:Key="FilterBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ TOP: Source + Pairs + Dest ══════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SOURCE LIST ──────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Style="{StaticResource BaDarkPanelBorder}"
                    Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Source List"
                               Style="{StaticResource SectionLabel}"/>

                    <!-- Category + display params -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Category:"
                                   Style="{StaticResource MutedLabel}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SourceCategoryName,
                                        UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaDarkTextBox}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="Display params:"
                                   Style="{StaticResource MutedLabel}"/>
                        <TextBox Grid.Column="3"
                                 Text="{Binding SourceDisplayParams,
                                        UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaDarkTextBox}"
                                 ToolTip="Comma-separated parameter names shown as columns, e.g: Mark, Comments, Level"/>
                    </Grid>

                    <!-- Filter rules -->
                    <Border Grid.Row="2" Style="{StaticResource FilterBorder}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SourceFilterSets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#2C3440"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{x:Static models:FilterSetOperatorValues.All}"
                                                          SelectedItem="{Binding Operator}"
                                                          Style="{StaticResource BaDarkComboBox}"
                                                          Margin="0,0,4,0"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding PrimaryRule.ParameterName,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource BaDarkTextBox}"
                                                         Margin="0,0,4,0"/>
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{x:Static models:FilterConditionValues.All}"
                                                          SelectedItem="{Binding PrimaryRule.Condition}"
                                                          Style="{StaticResource BaDarkComboBox}"
                                                          Margin="0,0,4,0"/>
                                                <TextBox Grid.Column="3"
                                                         Text="{Binding PrimaryRule.Value,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource BaDarkTextBox}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Add Filter Rule"
                                    Command="{Binding AddSourceFilterSetCommand}"
                                    Style="{StaticResource BaSecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Source elements grid — dynamic columns added by code-behind -->
                    <DataGrid x:Name="SourceGrid"
                              Grid.Row="3"
                              ItemsSource="{Binding SourceElements}"
                              SelectedItem="{Binding SelectedSourceItem}"
                              Style="{StaticResource PcDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource PcHeaderStyle}"
                              RowStyle="{StaticResource PcRowStyle}"
                              CellStyle="{StaticResource PcCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category}"
                                                IsReadOnly="True"
                                                Width="90"/>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                IsReadOnly="True"
                                                Width="*"/>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding ElementId}"
                                                IsReadOnly="True"
                                                Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ── PAIRS PANEL ──────────────────────────────────────────────── -->
            <Border Grid.Column="1"
                    Style="{StaticResource BaDarkPanelBorder}"
                    Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Pairs"
                               Style="{StaticResource SectionLabel}"/>

                    <TextBlock Grid.Row="1"
                               Text="Mode:"
                               Style="{StaticResource MutedLabel}"
                               Margin="0,0,0,4"/>

                    <ComboBox Grid.Row="2"
                              ItemsSource="{Binding PairingModes}"
                              SelectedItem="{Binding PairingMode}"
                              Style="{StaticResource BaDarkComboBox}"
                              Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="3" Margin="0,0,0,6">
                        <TextBlock Text="Match by param:"
                                   Style="{StaticResource MutedLabel}"
                                   Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PairingParameterName,
                                         UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaDarkTextBox}"
                                 Margin="0,0,0,6"
                                 ToolTip="Parameter whose value must match between source and dest elements"/>
                        <Button Content="Auto-Pair"
                                Command="{Binding AutoPairCommand}"
                                Style="{StaticResource BaSecondaryButton}"
                                Margin="0,0,0,4"/>
                        <Button Content="Pair Selected"
                                Command="{Binding PairSelectedCommand}"
                                Style="{StaticResource BaSecondaryButton}"
                                Margin="0,0,0,4"
                                ToolTip="Select one row in Source and one in Dest, then click"/>
                        <Button Content="Remove Pair"
                                Command="{Binding RemovePairCommand}"
                                Style="{StaticResource BaSecondaryButton}"
                                Margin="0,0,0,4"/>
                        <Button Content="Clear All"
                                Command="{Binding ClearPairsCommand}"
                                Style="{StaticResource BaSecondaryButton}"/>
                    </StackPanel>

                    <!-- Pairs list -->
                    <DataGrid Grid.Row="4"
                              ItemsSource="{Binding Pairs}"
                              SelectedItem="{Binding SelectedPair}"
                              Style="{StaticResource PcDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource PcHeaderStyle}"
                              RowStyle="{StaticResource PcRowStyle}"
                              CellStyle="{StaticResource PcCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source"
                                                Binding="{Binding SourceLabel}"
                                                IsReadOnly="True"
                                                Width="*"/>
                            <DataGridTextColumn Header="Dest"
                                                Binding="{Binding DestLabel}"
                                                IsReadOnly="True"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="5"
                               Text="{Binding Pairs.Count, StringFormat='{}{0} pairs'}"
                               Foreground="#A0A8B4"
                               Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <!-- ── DEST LIST ────────────────────────────────────────────────── -->
            <Border Grid.Column="2"
                    Style="{StaticResource BaDarkPanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Dest List"
                               Style="{StaticResource SectionLabel}"/>

                    <!-- Category + display params -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Category:"
                                   Style="{StaticResource MutedLabel}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding DestCategoryName,
                                        UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaDarkTextBox}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="Display params:"
                                   Style="{StaticResource MutedLabel}"/>
                        <TextBox Grid.Column="3"
                                 Text="{Binding DestDisplayParams,
                                        UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaDarkTextBox}"
                                 ToolTip="Comma-separated parameter names shown as columns, e.g: Mark, Comments, Level"/>
                    </Grid>

                    <!-- Filter rules -->
                    <Border Grid.Row="2" Style="{StaticResource FilterBorder}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding DestFilterSets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#2C3440"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{x:Static models:FilterSetOperatorValues.All}"
                                                          SelectedItem="{Binding Operator}"
                                                          Style="{StaticResource BaDarkComboBox}"
                                                          Margin="0,0,4,0"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding PrimaryRule.ParameterName,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource BaDarkTextBox}"
                                                         Margin="0,0,4,0"/>
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{x:Static models:FilterConditionValues.All}"
                                                          SelectedItem="{Binding PrimaryRule.Condition}"
                                                          Style="{StaticResource BaDarkComboBox}"
                                                          Margin="0,0,4,0"/>
                                                <TextBox Grid.Column="3"
                                                         Text="{Binding PrimaryRule.Value,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource BaDarkTextBox}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Add Filter Rule"
                                    Command="{Binding AddDestFilterSetCommand}"
                                    Style="{StaticResource BaSecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Dest elements grid — dynamic columns added by code-behind -->
                    <DataGrid x:Name="DestGrid"
                              Grid.Row="3"
                              ItemsSource="{Binding DestElements}"
                              SelectedItem="{Binding SelectedDestItem}"
                              Style="{StaticResource PcDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource PcHeaderStyle}"
                              RowStyle="{StaticResource PcRowStyle}"
                              CellStyle="{StaticResource PcCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category}"
                                                IsReadOnly="True"
                                                Width="90"/>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                IsReadOnly="True"
                                                Width="*"/>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding ElementId}"
                                                IsReadOnly="True"
                                                Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ RELOAD BUTTONS ════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,6">
            <Button Content="Reload Source"
                    Command="{Binding ReloadSourceCommand}"
                    Style="{StaticResource BaSecondaryButton}"
                    Width="120" Margin="0,0,8,0"/>
            <Button Content="Reload Dest"
                    Command="{Binding ReloadDestCommand}"
                    Style="{StaticResource BaSecondaryButton}"
                    Width="120"/>
        </StackPanel>

        <!-- ══ PARAMETER MAPPING TABLE ═══════════════════════════════════════ -->
        <Border Grid.Row="2"
                Style="{StaticResource BaDarkPanelBorder}"
                Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,6">
                    <TextBlock Text="Parameter Mappings"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"/>
                    <Button Content="Add Mapping"
                            Command="{Binding AddMappingCommand}"
                            Style="{StaticResource BaSecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Remove Selected"
                            Command="{Binding RemoveMappingCommand}"
                            Style="{StaticResource BaSecondaryButton}"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Mappings}"
                          SelectedItem="{Binding SelectedMapping}"
                          Style="{StaticResource PcDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource PcHeaderStyle}"
                          RowStyle="{StaticResource PcRowStyle}"
                          CellStyle="{StaticResource PcCellStyle}"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source Parameter Name"
                                            Binding="{Binding SourceParameterName,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Dest Parameter Name"
                                            Binding="{Binding DestParameterName,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                        <DataGridCheckBoxColumn Header="Write Only If Empty"
                                                Binding="{Binding WriteOnlyIfEmpty}"
                                                Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ══ ACTION BAR ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       Foreground="#A0A8B4"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Save Settings"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource BaSecondaryButton}"
                    Width="110" Margin="0,0,8,0"/>
            <Button Grid.Column="2"
                    Content="Load Settings"
                    Command="{Binding LoadSettingsCommand}"
                    Style="{StaticResource BaSecondaryButton}"
                    Width="110" Margin="0,0,16,0"/>
            <Button Grid.Column="3"
                    Content="▶  Run Copy"
                    Command="{Binding RunCopyCommand}"
                    Style="{StaticResource BaPrimaryButton}"
                    Width="120"/>
        </Grid>
    </Grid>
</Window>