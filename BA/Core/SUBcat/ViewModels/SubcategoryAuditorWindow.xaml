<Window x:Class="BA.UI.Standards.SubcategoryAuditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BA Subcategory Auditor"
        Height="800"
        Width="1620"
        MinHeight="650"
        MinWidth="1250"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>
        <SolidColorBrush x:Key="BgWindow" Color="#0B0C0F"/>
        <SolidColorBrush x:Key="BgPanel" Color="#11151C"/>
        <SolidColorBrush x:Key="BgInput" Color="#161B22"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#2C3440"/>
        <SolidColorBrush x:Key="FgMain" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="FgMuted" Color="#B8C0CC"/>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgMain}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#10161F"/>
            <Setter Property="AlternatingRowBackground" Value="#0D1219"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1E2630"/>
            <Setter Property="VerticalGridLinesBrush" Value="#1E2630"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#17202B"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource BgWindow}">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="Scan Project" Click="BtnScan_Click"/>
                <Button Grid.Row="0" Grid.Column="1" Content="Export CSV" Click="BtnExport_Click"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Copy Issue Summary" Click="BtnCopySummary_Click"/>
                <Button Grid.Row="0" Grid.Column="3" Content="Close" Click="BtnClose_Click"/>

                <TextBox Grid.Row="0"
                         Grid.Column="5"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         ToolTip="Search family, category, notes, or subcategory names."/>

                <CheckBox Grid.Row="1"
                          Grid.Column="5"
                          Content="Show only issues"
                          IsChecked="{Binding ShowOnlyIssues}"/>

                <CheckBox Grid.Row="1"
                          Grid.Column="6"
                          Content="Missing semantic only"
                          IsChecked="{Binding ShowMissingSemanticOnly}"/>

                <CheckBox Grid.Row="1"
                          Grid.Column="7"
                          Content="Strict mode"
                          IsChecked="{Binding StrictMode}"/>

                <CheckBox Grid.Row="1"
                          Grid.Column="8"
                          Content="Warn if no BA names"
                          IsChecked="{Binding WarnIfNoBaNames}"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="11"
                           Margin="0,12,0,0"
                           Text="{Binding SummaryText}"
                           Foreground="{StaticResource FgMuted}"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Grid Margin="14">
            <DataGrid ItemsSource="{Binding RowsView}"
                      AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Family Id" Binding="{Binding FamilyId}" Width="110"/>
                    <DataGridTextColumn Header="Family Name" Binding="{Binding FamilyName}" Width="220"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                    <DataGridTextColumn Header="Existing Subcategories" Binding="{Binding ExistingSubcategories}" Width="280"/>
                    <DataGridTextColumn Header="Valid BA Names" Binding="{Binding ValidBaNames}" Width="220"/>
                    <DataGridTextColumn Header="Missing Required" Binding="{Binding MissingRequired}" Width="200"/>
                    <DataGridTextColumn Header="Allowed Non-BA" Binding="{Binding AllowedNonBaNames}" Width="180"/>
                    <DataGridTextColumn Header="Non-Compliant Names" Binding="{Binding NonCompliantNames}" Width="220"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Background="#AA0B0C0F"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="20,14"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Scanning families..."
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Opening editable families and reading subcategories."
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource FgMuted}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>