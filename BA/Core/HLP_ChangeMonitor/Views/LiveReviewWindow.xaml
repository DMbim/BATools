<Window x:Class="BA.UI.LiveReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Change Monitor (Live Review)"
        Height="560" Width="1540"
        WindowStartupLocation="CenterOwner"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        ResizeMode="CanResize"
        Topmost="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="LrBorder" Color="#2C3440"/>
            <SolidColorBrush x:Key="LrPanel"  Color="#11151C"/>
            <SolidColorBrush x:Key="LrAlt"    Color="#16161A"/>

            <Style x:Key="LrDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background"               Value="{StaticResource LrPanel}"/>
                <Setter Property="Foreground"               Value="#F2F2F2"/>
                <Setter Property="RowBackground"            Value="{StaticResource LrPanel}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource LrAlt}"/>
                <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LrBorder}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource LrBorder}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="RowHeaderWidth"           Value="0"/>
                <Setter Property="RowHeight"                Value="28"/>
                <Setter Property="HeadersVisibility"        Value="Column"/>
                <Setter Property="SelectionMode"            Value="Extended"/>
                <Setter Property="AutoGenerateColumns"      Value="False"/>
                <Setter Property="CanUserAddRows"           Value="False"/>
                <Setter Property="EnableRowVirtualization"  Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            </Style>

            <Style x:Key="LrHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background"      Value="#16161A"/>
                <Setter Property="Foreground"      Value="#F2F2F2"/>
                <Setter Property="BorderBrush"     Value="{StaticResource LrBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding"         Value="10,6"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
            </Style>

            <Style x:Key="LrRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2A3A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LrCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground"       Value="#F2F2F2"/>
                <Setter Property="BorderThickness"  Value="0"/>
                <Setter Property="Padding"          Value="8,2"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ FILTERS + OPTIONS ═══════════════════════════════════════════════ -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Text="Recorded Changes"
                       FontWeight="Bold" FontSize="16"
                       VerticalAlignment="Center"
                       Foreground="#F2F2F2"/>
            <TextBlock Text="  (double-click a row or use actions below)"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#A0A8B4"/>

            <Button Content="Refresh"
                    Width="80" Margin="12,0,0,0"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="OnRefreshClick"/>

            <CheckBox x:Name="ChkFollow"
                      Content="Follow live"
                      IsChecked="True"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource BaCheckBox}"/>

            <TextBlock Text="   Type:" Margin="18,0,4,0" VerticalAlignment="Center" Foreground="#A0A8B4"/>
            <ComboBox x:Name="CmbType" Width="120"
                      Style="{StaticResource BaDarkComboBox}"
                      SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="(All)" IsSelected="True"/>
                <ComboBoxItem Content="Added"/>
                <ComboBoxItem Content="Deleted"/>
                <ComboBoxItem Content="Moved"/>
                <ComboBoxItem Content="Modified"/>
            </ComboBox>

            <TextBlock Text="   Category:" Margin="12,0,4,0" VerticalAlignment="Center" Foreground="#A0A8B4"/>
            <TextBox x:Name="TxtCategory" Width="160"
                     Style="{StaticResource BaDarkTextBox}"
                     TextChanged="OnFilterChanged"/>

            <TextBlock Text="   Param contains:" Margin="12,0,4,0" VerticalAlignment="Center" Foreground="#A0A8B4"/>
            <TextBox x:Name="TxtParam" Width="200"
                     Style="{StaticResource BaDarkTextBox}"
                     TextChanged="OnFilterChanged"/>

            <TextBlock Text="   Group:" Margin="12,0,4,0" VerticalAlignment="Center" Foreground="#A0A8B4"/>
            <ComboBox x:Name="CmbGroupMode" Width="150"
                      Style="{StaticResource BaDarkComboBox}"
                      SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="None" IsSelected="True"/>
                <ComboBoxItem Content="Transaction"/>
                <ComboBoxItem Content="Time (per minute)"/>
            </ComboBox>
        </StackPanel>

        <!-- ══ GRID ═════════════════════════════════════════════════════════════ -->
        <DataGrid x:Name="GridChanges"
                  Grid.Row="1"
                  Style="{StaticResource LrDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource LrHeaderStyle}"
                  RowStyle="{StaticResource LrRowStyle}"
                  CellStyle="{StaticResource LrCellStyle}"
                  IsReadOnly="False"
                  MouseDoubleClick="GridChanges_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Done"
                                        Binding="{Binding IsDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="60"/>
                <DataGridTextColumn Header="When"          Binding="{Binding When}"         Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="Type"          Binding="{Binding ChangeType}"   Width="90"  IsReadOnly="True"/>
                <DataGridTextColumn Header="ElementId"     Binding="{Binding ElementId}"    Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Category"      Binding="{Binding Category}"     Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="View"          Binding="{Binding ViewName}"      Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="ViewId"        Binding="{Binding ViewId}"        Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="User"          Binding="{Binding Username}"      Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Transactions"  Binding="{Binding Transactions}"  Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Param Changes" Binding="{Binding ParamSummary}"  Width="*"   IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ══ ACTIONS ═════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Add Revision Cloud(s)"
                    Width="160" Margin="0,0,8,0"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="OnAddCloudsClick"/>
            <Button Content="Show in Revit"
                    Width="120" Margin="0,0,8,0"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="OnShowClick"/>
            <Button Content="Close"
                    Width="90"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
