<!-- File: BA.UI/Management/TemplateCheckerWindow.xaml -->
<Window x:Class="BA.UI.Management.TemplateCheckerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Template Checker"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F10"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Primary Button -->
        <Style x:Key="BaPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F0F10"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Disabled state: dim the button -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="BaSecondaryButton" TargetType="Button"
               BasedOn="{StaticResource BaPrimaryButton}">
            <Setter Property="Background" Value="#1A1A1C"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#101012"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CaretBrush" Value="#F2F2F2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#141416"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="4,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202024"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Disabled: dim — IsEnabled=False, not True -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#101012"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D6D6DA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Card -->
        <Style x:Key="BaCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#141416"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#101012"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#101012"/>
            <Setter Property="AlternatingRowBackground" Value="#141416"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1E1E22"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#141416"/>
            <Setter Property="Foreground" Value="#CFCFD6"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=RowBackground}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A2A2E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202024"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A2A2E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="BA"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       Margin="0,0,8,0"/>
            <TextBlock Text="Template Checker"
                       FontSize="18"
                       Foreground="#B7B7BC"
                       VerticalAlignment="Bottom"/>
        </DockPanel>

        <!-- ── Controls card ──────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource BaCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Labels -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="View Template"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#8A8A94"/>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Standard File"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#8A8A94"/>

                <!-- Inputs -->
                <ComboBox Grid.Row="2" Grid.Column="0"
                          x:Name="CmbTemplates"/>
                <TextBox Grid.Row="2" Grid.Column="2"
                         x:Name="TxtFile"
                         IsReadOnly="True"/>

                <!-- Action buttons — row 2 col 4 -->
                <StackPanel Grid.Row="2" Grid.Column="4"
                            Orientation="Horizontal">
                    <Button x:Name="BtnBrowse"
                            Content="Browse…"
                            Width="90"
                            Margin="0,0,8,0"
                            Style="{StaticResource BaSecondaryButton}"
                            Click="BtnBrowse_Click"/>
                    <Button x:Name="BtnSave"
                            Content="Save Standard"
                            Width="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource BaSecondaryButton}"
                            Click="BtnSave_Click"/>
                    <Button x:Name="BtnCheck"
                            Content="Check"
                            Width="80"
                            Margin="0,0,8,0"
                            Style="{StaticResource BaPrimaryButton}"
                            Click="BtnCheck_Click"/>
                    <Button x:Name="BtnFixSelected"
                            Content="Fix Selected"
                            Width="100"
                            Margin="0,0,8,0"
                            Style="{StaticResource BaPrimaryButton}"
                            Click="BtnFixSelected_Click"/>
                    <Button x:Name="BtnApply"
                            Content="Apply All"
                            Width="90"
                            Style="{StaticResource BaPrimaryButton}"
                            Click="BtnApply_Click"/>
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                        BorderBrush="#2A2A2E"
                        BorderThickness="0,1,0,0"
                        Margin="0,4,0,0"/>

                <!-- Hint row -->
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"
                           Text="1. Pick a template.  2. Browse to or type a standard JSON path.  3. Check to compare.  4. Tick rows to fix, then Fix Selected — or Apply All to overwrite everything."
                           FontSize="11"
                           Foreground="#5A5A64"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- ── Diff grid card ─────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource BaCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar above grid -->
                <DockPanel Grid.Row="0">
                    <CheckBox x:Name="ChkOnlyMismatches"
                              Content="Only mismatches"
                              IsChecked="True"
                              DockPanel.Dock="Right"
                              Margin="16,0,0,0"
                              Checked="ChkOnlyMismatches_Changed"
                              Unchecked="ChkOnlyMismatches_Changed"/>
                    <TextBlock x:Name="TxtSummary"
                               Text="No check performed."
                               Foreground="#B7B7BC"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid Grid.Row="2"
                          x:Name="GridDiff"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          ColumnWidth="*">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Scope"
                                            Binding="{Binding Scope}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Property"
                                            Binding="{Binding Property}"
                                            Width="1.5*"/>
                        <DataGridTextColumn Header="Standard"
                                            Binding="{Binding StandardValue}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Current"
                                            Binding="{Binding CurrentValue}"
                                            Width="*"/>
                        <DataGridCheckBoxColumn Header="Mismatch"
                                                Binding="{Binding IsMismatch}"
                                                Width="80"
                                                IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Fix"
                                                Binding="{Binding ApplyFix}"
                                                Width="60"
                                                IsReadOnly="False"/>
                        <DataGridTextColumn Header="Notes"
                                            Binding="{Binding Notes}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ── Footer ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Close"
                    Width="90"
                    IsCancel="True"
                    Style="{StaticResource BaSecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>