<Window x:Class="BA.IssueReporter.Views.SubmitIssueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Submit Issue"
        Height="660"
        Width="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Submit Plugin Issue"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="#F2F2F2"/>
            <TextBlock Text="Report a bug, unclear behavior, or improvement idea."
                       Foreground="{StaticResource Brush.MutedTextDarkShell}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Auto info panel -->
        <Border Grid.Row="1"
                Style="{StaticResource BaDarkPanelBorder}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="AutoInfoTextBlock"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.DarkPanelFg}"/>
            </StackPanel>
        </Border>

        <!-- Category row -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Category:"
               Foreground="{StaticResource Brush.MutedTextDarkShell}"
               VerticalAlignment="Center"/>

            <ComboBox x:Name="CategoryComboBox"
              Grid.Column="1"
              Height="30"
              SelectionChanged="CategoryComboBox_SelectionChanged"
              Style="{StaticResource BaDarkComboBox}"/>
        </Grid>

        <!-- Source row -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Source:"
               Foreground="{StaticResource Brush.MutedTextDarkShell}"
               VerticalAlignment="Center"/>

            <ComboBox x:Name="SourceComboBox"
              Grid.Column="1"
              Height="30"
              IsEditable="True"
              Style="{StaticResource BaDarkComboBox}"/>
        </Grid>

        <!-- Screenshot row (NEW) -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Screenshot:"
                           Foreground="{StaticResource Brush.MutedTextDarkShell}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Press Win+Shift+S to snip an area, then Ctrl+V anywhere in this window to attach it."
                           Foreground="{StaticResource Brush.MutedTextDarkShell}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <Button x:Name="RemoveScreenshotButton"
                        Grid.Column="2"
                        Content="Remove Image"
                        Width="110"
                        Style="{StaticResource BaSecondaryButton}"
                        Click="RemoveScreenshotButton_Click"
                        Visibility="Collapsed"/>
            </Grid>

            <Border x:Name="ScreenshotPreviewBorder"
                    Style="{StaticResource BaDarkPanelBorder}"
                    Margin="0,8,0,0"
                    Padding="4"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed">
                <Image x:Name="ScreenshotPreviewImage"
                       MaxHeight="140"
                       MaxWidth="300"
                       Stretch="Uniform"/>
            </Border>
        </StackPanel>

        <!-- Issue -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Issue:"
                       Foreground="{StaticResource Brush.MutedTextDarkShell}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="IssueTextBox"
                     Grid.Row="1"
                     Style="{StaticResource BaDarkTextBox}"
                     Height="Auto"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Padding="6,6"/>
        </Grid>

        <!-- Suggestion -->
        <Grid Grid.Row="6" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Suggestion:"
                       Foreground="{StaticResource Brush.MutedTextDarkShell}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="SuggestionTextBox"
                     Grid.Row="1"
                     Style="{StaticResource BaDarkTextBox}"
                     Height="Auto"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Padding="6,6"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90" Margin="0,0,8,0"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="CancelButton_Click"/>
            <Button Content="Submit"
                    Width="110"
                    Style="{StaticResource BaPrimaryButton}"
                    Click="SubmitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>