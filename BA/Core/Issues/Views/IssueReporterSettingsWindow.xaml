<Window x:Class="BA.IssueReporter.Views.IssueReporterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Issue Reporter Settings"
        Height="620"
        Width="780"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Issue Reporter Settings"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="#F2F2F2"/>
            <TextBlock x:Name="SettingsPathTextBlock"
                       Foreground="{StaticResource Brush.MutedTextDarkShell}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Database path -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Issue database:"
                       Foreground="{StaticResource Brush.MutedTextDarkShell}"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="IssueDatabasePathTextBox"
                     Grid.Column="1"
                     Height="30"
                     Style="{StaticResource BaDarkTextBox}"/>
        </Grid>

        <!-- Teams URL -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Teams Workflow URL:"
                       Foreground="{StaticResource Brush.MutedTextDarkShell}"
                       VerticalAlignment="Center"/>
            <PasswordBox x:Name="TeamsWorkflowUrlPasswordBox"
                         Grid.Column="1"
                         Height="30"
                         Background="#1A1A1C"
                         Foreground="#F2F2F2"
                         BorderBrush="#3A3A3D"
                         BorderThickness="1"
                         Padding="6,2"/>
        </Grid>

        <!-- Managers -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Manager Revit usernames, one per line:"
                       Foreground="{StaticResource Brush.MutedTextDarkShell}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="ManagersTextBox"
                     Grid.Row="1"
                     Style="{StaticResource BaDarkTextBox}"
                     Height="Auto"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Padding="6,6"
                     Margin="0,4,0,0"/>
        </Grid>

        <!-- Known commands -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Known commands shown in Submit Issue dropdown, one per line:"
                       Foreground="{StaticResource Brush.MutedTextDarkShell}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="KnownCommandsTextBox"
                     Grid.Row="1"
                     Style="{StaticResource BaDarkTextBox}"
                     Height="Auto"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Padding="6,6"
                     Margin="0,4,0,0"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90" Margin="0,0,8,0"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="CancelButton_Click"/>
            <Button Content="Save"
                    Width="110"
                    Style="{StaticResource BaPrimaryButton}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>