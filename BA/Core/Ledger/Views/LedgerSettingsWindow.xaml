<Window x:Class="BA.UI.Ledger.LedgerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:BA_Tools.ScheduleExporter.Helpers"
        Title="Ledger Settings"
        Width="560" Height="660"
        Style="{DynamicResource BaWindow}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <!-- Two-state Ledger on/off button: background swaps green/red based on
                 IsLedgerEnabled. Colors are hardcoded here since no existing theme brush
                 (e.g. Brush.Success/Brush.Danger) was specified; swap these for real theme
                 resources if BaDark* already defines them. -->
            <Style x:Key="BaLedgerToggleButton" TargetType="Button" BasedOn="{StaticResource BaPrimaryButton}">
                <Setter Property="Width" Value="170" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLedgerEnabled}" Value="True">
                        <Setter Property="Background" Value="#FF2E7D46" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsLedgerEnabled}" Value="False">
                        <Setter Property="Background" Value="#FF8A2E2E" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ledger sync on/off (per central, defaults OFF for every model) -->
        <Border Grid.Row="0" Style="{StaticResource BaDarkPanelBorder}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding LedgerEnabledButtonText}"
                        Style="{StaticResource BaLedgerToggleButton}"
                        Command="{Binding ToggleLedgerEnabledCommand}"
                        IsEnabled="{Binding IsSettingLedgerEnabled, Converter={StaticResource InverseBooleanConverter}}" />
                <TextBlock Text="Controls whether this central participates in Type Data Ledger sync. Off by default for every model; this is stored per central and travels with the document."
                           Foreground="{DynamicResource Brush.WindowFg}"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           FontSize="11"
                           MaxWidth="330"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Ledger path -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource BaLabelText}" Text="Ledger JSON File Path" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource BaDarkTextBox}"
                         Text="{Binding LedgerFilePath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"
                        Content="Browse..."
                        Margin="8,0,0,0"
                        Style="{StaticResource BaSecondaryButton}"
                        Command="{Binding BrowseCommand}" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,10,0,0">

            <TextBlock Text="Project Set" Foreground="{DynamicResource Brush.WindowFg}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Auto-detected from the central's file path (e.g. N:\17-081\... -> 17-081). Only set this manually if auto-detection is wrong for this central."
               Foreground="{DynamicResource Brush.WindowFg}" Opacity="0.7" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{DynamicResource BaDarkTextBox}"
                 Text="{Binding ProjectSetText, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsSettingProjectSet, Converter={StaticResource InverseBooleanConverter}}"
                 Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Set" Style="{DynamicResource BaPrimaryButton}"
                Command="{Binding SetProjectSetCommand}" Margin="0,0,6,0"/>
                <Button Grid.Column="2" Content="Clear" Style="{DynamicResource BaSecondaryButton}"
                Command="{Binding ClearProjectSetCommand}"/>
            </Grid>
            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource Brush.WindowFg}" Opacity="0.6"
               Text="{Binding ResolvedLedgerFilePathDisplay, StringFormat='Currently syncing: {0}'}"
               TextWrapping="Wrap"/>
        </StackPanel>
        <!-- Central model identifier (this document only) -->
        <Border Grid.Row="2" Style="{StaticResource BaDarkPanelBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource BaSectionTitleText}" Text="Central Model Identifier (this document only)" />
                <TextBlock Style="{StaticResource BaMutedTextDark}"
                           Text="Manually identifies this central so Personal Ledger baselines don't collide across different buildings open under the same user. Set once per central, e.g. 'BuildingA'."
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource BaDarkTextBox}"
                             Text="{Binding CentralIdentifierText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Content="Set"
                            Margin="8,0,0,0"
                            Style="{StaticResource BaSecondaryButton}"
                            Command="{Binding SetIdentifierCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Retry settings -->
        <Border Grid.Row="3" Style="{StaticResource BaDarkPanelBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource BaSectionTitleText}" Text="File Lock Retry Settings" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource BaLabelText}" Text="Retry Count" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource BaDarkTextBox}"
                                 Text="{Binding RetryCountText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BaLabelText}" Text="Retry Delay (ms)" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource BaDarkTextBox}"
                                 Text="{Binding RetryDelayMsText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Category filter + diagnostics, side by side -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource BaDarkPanelBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource BaSectionTitleText}" Text="Tracked Categories" />
                    <CheckBox DockPanel.Dock="Top"
                              Content="Track ALL categories"
                              IsChecked="{Binding TrackAllCategories}"
                              Style="{StaticResource BaDarkPanelCheckBox}"
                              Margin="0,0,0,8"
                              FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Style="{StaticResource BaMutedTextDark}"
                               Text="Only checked categories below are synced when 'Track ALL' is off"
                               FontStyle="Italic"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  IsEnabled="{Binding CustomCategorySelectionEnabled}">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected}"
                                              Style="{StaticResource BaDarkPanelCheckBox}"
                                              Margin="0,2,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource BaDarkPanelBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource BaSectionTitleText}" Text="Diagnostics" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="0,0,0,2">
                            <Run Text="Tracked families: " />
                            <Run Text="{Binding TrackedFamiliesDisplay, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock Grid.Row="1">
                            <Run Text="Last applied in this doc: " />
                            <Run Text="{Binding LastSyncDisplay, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </Grid>

                    <Button DockPanel.Dock="Bottom"
                            Content="Refresh"
                            Style="{StaticResource BaSecondaryButton}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,8,0,0" />

                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource BaLabelText}" Text="Pending (not yet applied here):" Margin="0,4,0,4" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PendingItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock FontWeight="Bold" Text="{Binding FamilyTypeKey}" TextWrapping="Wrap" />
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding ParameterName, Mode=OneWay}" />
                                            <Run Text=" -&gt; " />
                                            <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource BaMutedTextDark}" FontSize="11">
                                            <Run Text="by " />
                                            <Run Text="{Binding LastEditedBy, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource BaSecondaryButton}"
                    Command="{Binding CancelCommand}"
                    Width="90" Margin="0,0,8,0" />
            <Button Content="Save"
                    Style="{StaticResource BaPrimaryButton}"
                    Command="{Binding SaveCommand}"
                    Width="90" />
        </StackPanel>
    </Grid>
</Window>