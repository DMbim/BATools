<Window x:Class="BA.UI.LineStyleHub.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Color"
        Width="320" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111214"
        Foreground="White"
        FontFamily="Segoe UI">

    <StackPanel Margin="20">

        <!-- Preview swatch -->
        <Border Height="50"
                CornerRadius="4"
                BorderBrush="#2A2A2C"
                BorderThickness="1"
                Background="{Binding PreviewBrush}"
                Margin="0,0,0,16"/>

        <!-- R -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="R" Foreground="#B8B8B8" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="255"
                    Value="{Binding R, Mode=TwoWay}"
                    VerticalAlignment="Center" Margin="8,0"/>
            <TextBox Grid.Column="2"
                     Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="#1A1A1D" Foreground="White"
                     BorderBrush="#2A2A2C" BorderThickness="1"
                     Padding="4,2" TextAlignment="Right"/>
        </Grid>

        <!-- G -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="G" Foreground="#B8B8B8" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="255"
                    Value="{Binding G, Mode=TwoWay}"
                    VerticalAlignment="Center" Margin="8,0"/>
            <TextBox Grid.Column="2"
                     Text="{Binding G, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="#1A1A1D" Foreground="White"
                     BorderBrush="#2A2A2C" BorderThickness="1"
                     Padding="4,2" TextAlignment="Right"/>
        </Grid>

        <!-- B -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="B" Foreground="#B8B8B8" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="255"
                    Value="{Binding B, Mode=TwoWay}"
                    VerticalAlignment="Center" Margin="8,0"/>
            <TextBox Grid.Column="2"
                     Text="{Binding B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="#1A1A1D" Foreground="White"
                     BorderBrush="#2A2A2C" BorderThickness="1"
                     Padding="4,2" TextAlignment="Right"/>
        </Grid>

        <!-- Hex input -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Hex:" Foreground="#B8B8B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding HexText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Width="100"
                     Background="#1A1A1D" Foreground="White"
                     BorderBrush="#2A2A2C" BorderThickness="1"
                     Padding="6,4"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="80" Margin="0,0,8,0"
                    Background="#1A1A1D" Foreground="White"
                    BorderBrush="#2A2A2C" BorderThickness="1"
                    Padding="0,6"
                    Click="BtnCancel_Click"/>
            <Button Content="OK"
                    Width="80"
                    Background="#2A5A9E" Foreground="White"
                    BorderBrush="#1E4A8E" BorderThickness="1"
                    Padding="0,6"
                    Click="BtnOk_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
