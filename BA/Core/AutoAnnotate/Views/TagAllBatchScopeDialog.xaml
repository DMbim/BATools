<Window x:Class="BA.BIM.Commands.Anno.TagAllBatchScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag All (Batch) - View Scope"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{DynamicResource BaWindow}"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock Text="Which views should be scanned for untagged elements?"
                   Style="{StaticResource BaLabelText}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <RadioButton x:Name="RbActiveViewOnly" GroupName="Scope" Content="Active view only"
                     Style="{StaticResource BaRadioButton}" Margin="0,4,0,4"/>
        <RadioButton x:Name="RbAllFloorPlans" GroupName="Scope" Content="All floor plan views"
                     Style="{StaticResource BaRadioButton}" IsChecked="True" Margin="0,4,0,4"/>

        <TextBlock TextWrapping="Wrap" FontStyle="Italic" Style="{StaticResource BaMutedTextDark}" FontSize="11" Margin="0,6,0,0"
                   Text="Categories and tag types are chosen next, aggregated across every scanned view. Elements already tagged in a given view are skipped automatically."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Next" Width="80" Margin="0,0,8,0"
                    Style="{StaticResource BaPrimaryButton}"
                    Click="BtnApply_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>