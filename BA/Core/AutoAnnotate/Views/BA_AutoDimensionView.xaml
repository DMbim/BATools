<Window x:Class="BA.AutoAnnotate.Views.BA_AutoDimensionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA Auto-Dimension" Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource BaWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="{StaticResource Thickness.WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="View scope:" Style="{StaticResource BaLabelText}" Margin="0,0,8,0"/>
            <ComboBox Width="200"
                      Style="{StaticResource BaComboBox}"
                      ItemsSource="{Binding ViewScopeModes}"
                      SelectedItem="{Binding ViewScopeMode, Mode=TwoWay}"/>
            <CheckBox Content="Extend through collinear walls"
                      Style="{StaticResource BaCheckBox}"
                      Margin="20,0,0,0"
                      IsChecked="{Binding ExtendThroughCollinearWalls, Mode=TwoWay}"/>
            <Button Content="Scan" Width="90" Margin="20,0,0,0"
                    Style="{StaticResource BaPrimaryButton}"
                    Command="{Binding ScanCommand}"/>
            <TextBlock Text="{Binding SelectedCount, StringFormat='Selected: {0}'}"
                       Style="{StaticResource BaLabelText}" Margin="20,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="0,0,0,8"
                   Style="{StaticResource BaSectionTitleText}"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Candidates}"
          Style="{StaticResource BaDataGrid}"
          IsReadOnly="False"
          SelectionChanged="CandidatesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Place"
                                         Binding="{Binding IsSelected, Mode=TwoWay}"
                                         Width="50"
                                         ElementStyle="{StaticResource BaCheckBox}"
                                         EditingElementStyle="{StaticResource BaCheckBox}"/>
                <DataGridTextColumn Header="View" Binding="{Binding ViewName}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Wall / Openings" Binding="{Binding DisplayLabel}" Width="*" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Flip Side"
                                         Binding="{Binding IsFlipped, Mode=TwoWay}"
                                         Width="70"
                                         ElementStyle="{StaticResource BaCheckBox}"
                                         EditingElementStyle="{StaticResource BaCheckBox}"/>
                <DataGridTextColumn Header="Offset (mm)" Binding="{Binding OffsetMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Place Dimensions (best effort)" Margin="0,8,0,8"
                HorizontalAlignment="Right" Width="220"
                Style="{StaticResource BaPrimaryButton}"
                Command="{Binding PlaceCommand}"/>

        <TabControl Grid.Row="4" Style="{StaticResource BaTabControl}">
            <TabItem Header="Skipped">
                <DataGrid ItemsSource="{Binding Skips}" Style="{StaticResource BaDataGrid}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="View" Binding="{Binding ViewName}" Width="150"/>
                        <DataGridTextColumn Header="Wall" Binding="{Binding WallName}" Width="150"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="150"/>
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Results">
                <DataGrid ItemsSource="{Binding Outcomes}" Style="{StaticResource BaDataGrid}" IsReadOnly="True"
          SelectionChanged="ResultsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="View" Binding="{Binding ViewName}" Width="150"/>
                        <DataGridTextColumn Header="Success" Binding="{Binding Success}" Width="70"/>
                        <DataGridTextColumn Header="Failure" Binding="{Binding FailureMessage}" Width="*"/>
                        <DataGridTemplateColumn Header="Delete" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete" Click="BtnDeleteOutcome_Click"
                                            Style="{StaticResource BaSmallPanelButton}"
                                            IsEnabled="{Binding Success}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>