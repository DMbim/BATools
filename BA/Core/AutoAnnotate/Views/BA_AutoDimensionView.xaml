<Window x:Class="BA.AutoAnnotate.Views.BA_AutoDimensionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA Auto-Dimension" Height="620" Width="860"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="View scope:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="200"
                      ItemsSource="{Binding ViewScopeModes}"
                      SelectedItem="{Binding ViewScopeMode, Mode=TwoWay}"/>
            <Button Content="Scan" Width="90" Margin="12,0,0,0"
                    Command="{Binding ScanCommand}"/>
            <TextBlock Text="{Binding SelectedCount, StringFormat='Selected: {0}'}"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="0,0,0,8" FontWeight="Bold"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Place" Binding="{Binding IsSelected, Mode=TwoWay}" Width="50"/>
                <DataGridTextColumn Header="View" Binding="{Binding ViewName}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Wall / Openings" Binding="{Binding DisplayLabel}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Place Dimensions (best effort)" Margin="0,8,0,8"
                HorizontalAlignment="Right" Width="220" Command="{Binding PlaceCommand}"/>

        <TabControl Grid.Row="4">
            <TabItem Header="Skipped">
                <DataGrid ItemsSource="{Binding Skips}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="View" Binding="{Binding ViewName}" Width="150"/>
                        <DataGridTextColumn Header="Wall" Binding="{Binding WallName}" Width="150"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="150"/>
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Results">
                <DataGrid ItemsSource="{Binding Outcomes}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="View" Binding="{Binding ViewName}" Width="150"/>
                        <DataGridTextColumn Header="Success" Binding="{Binding Success}" Width="70"/>
                        <DataGridTextColumn Header="Failure" Binding="{Binding FailureMessage}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>