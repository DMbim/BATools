<!-- BA/Markup/Views/MarkupWindow.xaml -->
<Window
    x:Class="BA.Markup.Views.MarkupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BA.Markup.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MarkupViewModel}"
    mc:Ignorable="d"
    Title="BA Markup"
    Width="420"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Style="{DynamicResource BaWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">

        <!-- MODE -->
        <TextBlock Text="Markup Mode"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource Brush.WindowFg}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="Internal Comment"
                 IsChecked="{Binding IsInternalMode}"
                 Style="{StaticResource BaRadioButton}"
                 Margin="0,0,16,0"/>
            <RadioButton Content="Official Revision"
                 IsChecked="{Binding IsOfficialMode}"
                 Style="{StaticResource BaRadioButton}"/>
        </StackPanel>

        <!-- BA_TYPE -->
        <TextBlock Text="Type (BA_Type)"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource Brush.WindowFg}"/>
        <ComboBox ItemsSource="{Binding TypeOptions}"
                  SelectedItem="{Binding SelectedTypeOption}"
                  Margin="0,0,0,12"
                  Style="{StaticResource BaDarkComboBox}"/>

        <!-- BA_COMMENTS — action dropdown -->
        <TextBlock Text="Action (BA_Comments)"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource Brush.WindowFg}"/>
        <ComboBox ItemsSource="{Binding ActionOptions}"
                  SelectedItem="{Binding SelectedActionOption}"
                  Margin="0,0,0,6"
                  Style="{StaticResource BaDarkComboBox}"/>

        <!-- BA_COMMENTS — free text -->
        <TextBlock Text="Additional comment"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource Brush.WindowFg}"/>
        <TextBox Text="{Binding CommentFreeText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="False"
                 MaxLength="500"
                 Margin="0,0,0,12"
                 Style="{StaticResource BaDarkTextBox}"/>

        <!-- AUTHOR -->
        <TextBlock Text="Author (BA_Markup_Author)"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource Brush.WindowFg}"/>
        <TextBox Text="{Binding BaAuthor, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12"
                 Style="{StaticResource BaDarkTextBox}"/>

        <!-- DATE -->
        <TextBlock Text="Date (BA_Markup_Date)"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource Brush.WindowFg}"/>
        <TextBox Text="{Binding BaDate, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12"
                 Style="{StaticResource BaDarkTextBox}"/>

        <!-- ASSIGNED TO (BA_Tls_AssignedUser) -->
        <!-- Editable ComboBox: pick from AssigneeOptions (active registry users for this
             central) or type any other username as free text. Empty selection is valid,
             means the markup is left unassigned. IsTextSearchEnabled lets typing jump to
             a matching existing entry without blocking free text for names not yet in
             the list. -->
        <TextBlock Text="Assigned To (BA_Tls_AssignedUser)"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource Brush.WindowFg}"/>
        <ComboBox ItemsSource="{Binding AssigneeOptions}"
                  Text="{Binding AssignedUser, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  Margin="0,0,0,12"
                  Style="{StaticResource BaDarkComboBox}"/>

        <!-- REVISION — only visible in Official mode -->
        <StackPanel
            Visibility="{Binding IsOfficialMode, Converter={StaticResource BoolToVis}}"
            Margin="0,0,0,12">

            <TextBlock Text="Revision"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource Brush.WindowFg}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Shows the revision selected in RevisionManagerWindow -->
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Revisions}"
                          SelectedItem="{Binding SelectedRevision}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource BaDarkComboBox}"
                          Margin="0,0,6,0"/>

                <!-- Opens RevisionManagerWindow for full management + selection -->
                <Button Grid.Column="1"
                        Content="Manage Revisions"
                        Command="{Binding RefreshRevisionsCommand}"
                        Style="{StaticResource BaSecondaryButton}"
                        Width="120"/>
            </Grid>
        </StackPanel>

        <!-- BUTTONS -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource BaSecondaryButton}"
                    Width="80"
                    Margin="0,0,8,0"/>
            <Button Content="Pick Area"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource BaPrimaryButton}"
                    Width="90"/>
        </StackPanel>

    </StackPanel>
</Window>