<!-- BA/Markup/Views/RevisionManagerWindow.xaml -->
<Window
    x:Class="BA.Markup.Views.RevisionManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BA.Markup.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:RevisionManagerViewModel}"
    mc:Ignorable="d"
    Title="BA — Revision Manager"
    Width="780"
    Height="560"
    MinWidth="620"
    MinHeight="400"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    Style="{DynamicResource BaWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: Filter and group toolbar                                 -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Style="{StaticResource BaDarkPanelBorder}"
                Margin="0,0,0,8"
                Padding="10,8">
            <WrapPanel Orientation="Horizontal">

                <TextBlock Text="Filter by"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding FilterFields}"
                          SelectedItem="{Binding SelectedFilterField}"
                          Width="130"
                          Margin="0,0,6,0"
                          Style="{StaticResource BaDarkComboBox}"/>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Width="160"
                         Margin="0,0,16,0"
                         Style="{StaticResource BaDarkTextBox}"/>

                <Separator Width="1" Margin="0,2,16,2"/>

                <CheckBox Content="Group by"
                          IsChecked="{Binding GroupingEnabled}"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"
                          Style="{StaticResource BaDarkPanelCheckBox}"/>
                <ComboBox ItemsSource="{Binding GroupFields}"
                          SelectedItem="{Binding SelectedGroupField}"
                          Width="130"
                          IsEnabled="{Binding GroupingEnabled}"
                          Style="{StaticResource BaDarkComboBox}"/>

            </WrapPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1: Revision DataGrid                                        -->
        <!-- ============================================================== -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredRevisions}"
                  SelectedItem="{Binding SelectedRevision}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  Margin="0,0,0,8"
                  BorderThickness="1">

            <DataGrid.Columns>
                <DataGridTextColumn Header="#"
                                    Binding="{Binding SequenceNumber}"
                                    Width="40"/>
                <DataGridTextColumn Header="Date"
                                    Binding="{Binding RevisionDate}"
                                    Width="100"/>
                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>
                <DataGridCheckBoxColumn Header="Issued"
                                        Binding="{Binding Issued}"
                                        Width="60"/>
                <DataGridTextColumn Header="Issued By"
                                    Binding="{Binding IssuedBy}"
                                    Width="110"/>
                <DataGridTextColumn Header="Issued To"
                                    Binding="{Binding IssuedTo}"
                                    Width="110"/>
            </DataGrid.Columns>

        </DataGrid>

        <!-- ============================================================== -->
        <!-- ROW 2: Inline editor panel                                      -->
        <!-- ============================================================== -->
        <Border Grid.Row="2"
                Style="{StaticResource BaDarkPanelBorder}"
                Padding="12,10"
                Margin="0,0,0,8"
                Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVis}}">

            <StackPanel DataContext="{Binding EditorViewModel}">

                <TextBlock Text="{Binding EditorTitle}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,0,0,10"/>

                <!-- Seq + Date + Description -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Seq #" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SequenceNumberDisplay, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Style="{StaticResource BaDarkTextBox}"
                                 Opacity="0.6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Date (yyyy-MM-dd)" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding RevisionDate, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaDarkTextBox}"/>
                        <TextBlock Text="{Binding DateError}"
                                   FontSize="10"
                                   Foreground="#E05252"
                                   Visibility="{Binding HasDateError,
                                       Converter={StaticResource BoolToVis}}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Description" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaDarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- Issued + Issued By + Issued To -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                        <CheckBox Content="Issued"
                                  IsChecked="{Binding Issued}"
                                  Style="{StaticResource BaDarkPanelCheckBox}"
                                  Margin="0,0,0,4"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Issued By" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding IssuedBy, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaDarkTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Issued To" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding IssuedTo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaDarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- Editor buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding DataContext.CancelEditCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource BaSecondaryButton}"
                            Width="70"
                            Margin="0,0,8,0"/>
                    <Button Content="Save"
                            Command="{Binding DataContext.SaveCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource BaPrimaryButton}"
                            Width="70"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 3: Status bar + action buttons                              -->
        <!-- ============================================================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource BaSecondaryButton}"
                        Width="70"
                        Margin="0,0,6,0"/>
                <Button Content="New"
                        Command="{Binding NewCommand}"
                        Style="{StaticResource BaSecondaryButton}"
                        Width="60"
                        Margin="0,0,6,0"/>
                <Button Content="Edit"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource BaSecondaryButton}"
                        Width="60"
                        Margin="0,0,6,0"/>
                <Button Content="Select"
                        Command="{Binding SelectCommand}"
                        Style="{StaticResource BaPrimaryButton}"
                        Width="70"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>