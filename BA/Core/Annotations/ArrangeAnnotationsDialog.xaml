<Window x:Class="BA.BIM.Commands.Anno.ArrangeAnnotationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrange Annotations"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Modernized Revit-Like GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#444444" Margin="4,0,4,4"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <!-- Tooltip wrapping setup -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12"
                ToolTipService.InitialShowDelay="600"
                ToolTipService.ShowDuration="12000">

        <!-- ===== MODE SELECTION ===== -->
        <GroupBox Header="Mode">
            <StackPanel>
                <RadioButton x:Name="RbResolveCollisions" GroupName="Mode"
                             Content="Resolve collisions (de-overlap)"
                             Checked="ModeRadio_Checked" Tag="ResolveCollisions">
                    <RadioButton.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                Detects overlapping annotation bounding boxes and pushes them apart using an iterative MTV (Minimum Translation Vector) physics simulation. Best for small clusters where you want minimum movement.
                            </TextBlock>
                        </ToolTip>
                    </RadioButton.ToolTip>
                </RadioButton>

                <RadioButton x:Name="RbSnapGrid" GroupName="Mode"
                             Content="Snap to grid (host-aware)"
                             Checked="ModeRadio_Checked" Tag="SnapGrid">
                    <RadioButton.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                Arranges selected annotations into a uniform grid centered on their original positions. Grid topology grows automatically when elements travel too far.
                            </TextBlock>
                        </ToolTip>
                    </RadioButton.ToolTip>
                </RadioButton>

                <RadioButton x:Name="RbDistributeHorizontal" GroupName="Mode"
                             Content="Distribute / align horizontal row"
                             Checked="ModeRadio_Checked" Tag="DistributeHorizontal">
                    <RadioButton.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                Aligns annotations to a shared horizontal axis. Spacing between elements is preserved as-is.
                            </TextBlock>
                        </ToolTip>
                    </RadioButton.ToolTip>
                </RadioButton>

                <RadioButton x:Name="RbDistributeVertical" GroupName="Mode"
                             Content="Distribute / align vertical column"
                             Checked="ModeRadio_Checked" Tag="DistributeVertical">
                    <RadioButton.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                Aligns annotations to a shared vertical axis. Spacing between elements is preserved as-is.
                            </TextBlock>
                        </ToolTip>
                    </RadioButton.ToolTip>
                </RadioButton>

                <RadioButton x:Name="RbStackVertical" GroupName="Mode"
                             Content="Stack list vertical"
                             Checked="ModeRadio_Checked" Tag="StackListVertical">
                    <RadioButton.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                Stacks selected annotations into a vertical list, top to bottom, with a uniform gap between each bounding box.
                            </TextBlock>
                        </ToolTip>
                    </RadioButton.ToolTip>
                </RadioButton>

                <RadioButton x:Name="RbStackHorizontal" GroupName="Mode"
                             Content="Stack list horizontal"
                             Checked="ModeRadio_Checked" Tag="StackListHorizontal">
                    <RadioButton.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                Stacks selected annotations into a horizontal list, left to right, with a uniform gap between each bounding box.
                            </TextBlock>
                        </ToolTip>
                    </RadioButton.ToolTip>
                </RadioButton>

                <RadioButton x:Name="RbSnapToGuideLine" GroupName="Mode"
                             Content="Snap to guide line (pick 2 points after Apply)"
                             Checked="ModeRadio_Checked" Tag="SnapToGuideLine">
                    <RadioButton.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                Snaps annotations perpendicular onto a selected line of your choosing after clicking Apply.
                            </TextBlock>
                        </ToolTip>
                    </RadioButton.ToolTip>
                </RadioButton>
            </StackPanel>
        </GroupBox>

        <!-- ===== GLOBAL SPACING ===== -->
        <GroupBox Header="Spacing">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gap (mm):" Style="{StaticResource LabelStyle}" Width="110">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                Minimum clear distance in millimetres between annotation bounding boxes after arrangement.
                            </TextBlock>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBox Grid.Column="1" x:Name="TbGap" Text="6" Width="60" HorizontalAlignment="Left">
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                Minimum clear distance in millimetres between bounding boxes.
                            </TextBlock>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
            </Grid>
        </GroupBox>

        <!-- ===== RESOLVE COLLISIONS SETTINGS ===== -->
        <GroupBox x:Name="GbResolve" Header="Resolve Collisions Settings">
            <StackPanel>
                <!-- Iterations Slider + Input Row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Iterations (Passes):" Style="{StaticResource LabelStyle}">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    Number of simulation passes. More iterations resolve complex clusters but take longer. 20-40 is typically sufficient.
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <Slider Grid.Column="1" x:Name="SlIterations" Minimum="1" Maximum="120" Value="30" TickFrequency="1" IsSnapToTickEnabled="True"
                            />
                    <TextBox Grid.Column="2" x:Name="TbIterations" Text="30" HorizontalAlignment="Right" Width="50"/>
                </Grid>

                <!-- Damping Slider + Input Row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Damping (0 to 1):" Style="{StaticResource LabelStyle}">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    Fraction of computed displacement applied per iteration. Lower values move elements slowly and smoothly; higher values converge faster but can overshoot.
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <Slider Grid.Column="1" x:Name="SlDamping" Minimum="0.0" Maximum="1.0" Value="0.75" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            />
                    <TextBox Grid.Column="2" x:Name="TbDamping" Text="0.75" HorizontalAlignment="Right" Width="50"/>
                </Grid>

                <!-- Auto Margin Checkbox -->
                <CheckBox x:Name="CbAutoMargin"
                          Content="Auto margin (Adaptive 3% based on element size)"
                          IsChecked="True"
                          Checked="CbAutoMargin_CheckedChanged"
                          Unchecked="CbAutoMargin_CheckedChanged"
                          Margin="0,4,0,8">
                    <CheckBox.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                When enabled, the collision margin is computed automatically as 3% of the element's shortest bounding box dimension (minimum 1.5 mm).
                            </TextBlock>
                        </ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>

                <!-- Fixed Margin Input Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Fixed margin (mm):" Style="{StaticResource LabelStyle}">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    Fixed clearance margin added around bounding boxes before collision detection. Only active when Auto margin is disabled.
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox Grid.Column="1" x:Name="TbFixedMargin" Text="2" IsEnabled="False" Width="60" HorizontalAlignment="Left">
                        <TextBox.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    Fixed margin in mm. Active only when Auto margin is disabled.
                                </TextBlock>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ===== SNAP GRID SETTINGS ===== -->
        <GroupBox x:Name="GbSnapGrid" Header="Snap to Grid Settings">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Max displacement factor:" Style="{StaticResource LabelStyle}">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    Controls how far an element can travel before forcing the grid to grow. Max displacement = Gap x Factor.
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox Grid.Column="1" x:Name="TbMaxDisplacementFactor" Text="3.0" Width="60" HorizontalAlignment="Left">
                        <TextBox.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    Max displacement = Gap x this factor. Recommended range: 2.0 to 5.0.
                                </TextBlock>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                </Grid>

                <TextBlock TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray" FontSize="11">
                    Grid dimensions (cols x rows) expand automatically to keep elements near their original positions.
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- ===== ACTION BUTTONS ===== -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="BtnApply" Content="Apply" Width="80" Height="24"
                    Margin="0,0,8,0" Click="BtnApply_Click" IsDefault="True"/>
            <Button Grid.Column="2" x:Name="BtnCancel" Content="Cancel" Width="80" Height="24"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </Grid>

    </StackPanel>
</Window>