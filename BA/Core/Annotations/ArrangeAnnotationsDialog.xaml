<Window x:Class="BA.BIM.Commands.Anno.ArrangeAnnotationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrange Annotations"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">

        <GroupBox Header="Mode">
            <StackPanel>
                <RadioButton x:Name="RbResolveCollisions" GroupName="Mode" Content="Resolve collisions (de-overlap)"
                              Checked="ModeRadio_Checked" Tag="ResolveCollisions"/>
                <RadioButton x:Name="RbSnapGrid" GroupName="Mode" Content="Snap to grid (host-aware)"
                              Checked="ModeRadio_Checked" Tag="SnapGrid"/>
                <RadioButton x:Name="RbDistributeHorizontal" GroupName="Mode" Content="Distribute - align horizontal row"
                              Checked="ModeRadio_Checked" Tag="DistributeHorizontal"/>
                <RadioButton x:Name="RbDistributeVertical" GroupName="Mode" Content="Distribute - align vertical column"
                              Checked="ModeRadio_Checked" Tag="DistributeVertical"/>
                <RadioButton x:Name="RbStackVertical" GroupName="Mode" Content="Stack list - vertical"
                              Checked="ModeRadio_Checked" Tag="StackListVertical"/>
                <RadioButton x:Name="RbStackHorizontal" GroupName="Mode" Content="Stack list - horizontal"
                              Checked="ModeRadio_Checked" Tag="StackListHorizontal"/>
                <RadioButton x:Name="RbSnapToGuideLine" GroupName="Mode" Content="Snap to guide line (pick 2 points)"
                              Checked="ModeRadio_Checked" Tag="SnapToGuideLine"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Spacing">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Gap (mm):" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TbGap" Text="6"/>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="GbResolve" Header="Resolve collisions settings">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Iterations:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbIterations" Text="30"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Damping (0-1):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbDamping" Text="0.75"/>
                </StackPanel>
                <CheckBox x:Name="CbAutoMargin" Content="Auto margin" IsChecked="True"
                          Checked="CbAutoMargin_CheckedChanged" Unchecked="CbAutoMargin_CheckedChanged"
                          Margin="0,6,0,2"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Fixed margin (mm):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbFixedMargin" Text="2" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="GbSnapGrid" Header="Snap to grid settings">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Max displacement factor:" Style="{StaticResource LabelStyle}" Width="140"/>
                    <TextBox x:Name="TbMaxDisplacementFactor" Text="3.0"/>
                </StackPanel>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray" FontSize="11">
                    Max displacement = Gap x this factor. Items whose target grid cell would exceed this distance from their current position cause the grid to grow an extra row or column.
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnApply" Content="Apply" Width="80" Margin="0,0,8,0" Click="BtnApply_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>

    </StackPanel>
</Window>
