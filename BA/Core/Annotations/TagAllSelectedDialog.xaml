<Window x:Class="BA.BIM.Commands.Anno.TagAllSelectedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag All Selected"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">

        <GroupBox Header="Tag type per category">
            <StackPanel x:Name="CategoryRowsPanel">
                <!-- Rows added programmatically in code-behind, one per category -->
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Leader">
            <CheckBox x:Name="CbUseLeader" Content="Add leader to tags pushed off their host due to collision"
                      IsChecked="False"/>
        </GroupBox>

        <GroupBox Header="Collision resolution (when a new tag overlaps existing annotation)">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Gap (mm):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbGap" Text="6"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Iterations:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbIterations" Text="30"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Damping (0-1):" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbDamping" Text="0.75"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnApply" Content="Apply" Width="80" Margin="0,0,8,0" Click="BtnApply_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>

    </StackPanel>
</Window>
