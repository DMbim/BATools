<Window x:Class="BA.UI.Parameters.ParameterManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA – Parameter Manager"
        Width="1100" Height="650"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource BaWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource BaLabelText}"
                       Text="Search:"
                       Margin="0,0,8,0"/>

            <TextBox Grid.Column="1"
                     x:Name="TxtSearch"
                     Style="{StaticResource BaTextBox}"
                     TextChanged="TxtSearch_TextChanged"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="10,0,0,0"
                        Width="90"
                        Style="{StaticResource BaSecondaryButton}"
                        Content="Refresh"
                        Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Grid -->
        <DataGrid Grid.Row="1"
                  x:Name="GridParams"
                  Style="{StaticResource BaDataGrid}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  SelectionChanged="GridParams_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Shared" Binding="{Binding IsShared}" Width="80"/>
                <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="220"/>
                <DataGridTextColumn Header="Instance/Type" Binding="{Binding InstanceOrType}" Width="120"/>
                <DataGridTextColumn Header="Spec" Binding="{Binding SpecLabel}" Width="180"/>
                <DataGridTextColumn Header="Group" Binding="{Binding GroupLabel}" Width="220"/>
                <DataGridTextColumn Header="Categories" Binding="{Binding CategoriesCsv}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- File path row -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource BaLabelText}"
                           Text="Shared Params file:"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         x:Name="TxtSpPath"
                         Style="{StaticResource BaReadOnlyTextBox}"/>

                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Width="90"
                        Style="{StaticResource BaSecondaryButton}"
                        Content="Browse..."
                        Click="BtnBrowseSp_Click"/>
            </Grid>

            <!-- Selection summary + action buttons row -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="TxtSelectionSummary"
                           Style="{StaticResource BaMutedTextDark}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="170"
                            Margin="0,0,8,0"
                            Style="{StaticResource BaPrimaryButton}"
                            Content="Create / Bind Shared"
                            Click="BtnAddShared_Click"/>
                    <Button Width="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource BaSecondaryButton}"
                            Content="Edit Binding"
                            Click="BtnEdit_Click"/>
                    <Button Width="110"
                            Margin="0,0,8,0"
                            Style="{StaticResource BaSecondaryButton}"
                            Content="Remove Binding"
                            Click="BtnRemove_Click"/>
                    <Button Width="90"
                            Style="{StaticResource BaSecondaryButton}"
                            IsCancel="True"
                            Content="Close"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>