<Window x:Class="BA.UI.Sheets.DateSheetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Updater"
        Width="980" Height="560"
        MinWidth="900" MinHeight="520"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DarkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1A1A1D"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#222226"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#17171A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="#11151C"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="RowBackground" Value="#11151C"/>
                <Setter Property="AlternatingRowBackground" Value="#16161A"/>
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#2C3440"/>
                <Setter Property="VerticalGridLinesBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowHeight" Value="28"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            </Style>

            <Style x:Key="DarkColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#16161A"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="DarkRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2A3A"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DarkCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="OK" Width="100" Margin="0,0,8,0"
                    IsDefault="True"
                    Style="{StaticResource DarkButtonStyle}"
                    Click="Apply_Click"/>
            <Button Content="Cancel" Width="100"
                    IsCancel="True"
                    Style="{StaticResource DarkButtonStyle}"/>
        </StackPanel>

        <DataGrid x:Name="SheetsGrid"
                  Style="{StaticResource BaDataGrid}"
                  ColumnHeaderStyle="{StaticResource DarkColumnHeaderStyle}"
                  RowStyle="{StaticResource DarkRowStyle}"
                  CellStyle="{StaticResource DarkCellStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False"
                  ColumnWidth="*">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Number" Binding="{Binding SheetNumber}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Name" Binding="{Binding SheetName}" IsReadOnly="True" Width="3*"/>
                <DataGridTextColumn Header="Issue Date (current)" Binding="{Binding IssueDate}" IsReadOnly="True" Width="180"/>
                <DataGridTextColumn Header="Revision (current)" Binding="{Binding CurrentRevision}" IsReadOnly="True" Width="150"/>
                <DataGridCheckBoxColumn Header="Update Date" Binding="{Binding UpdateDate}" Width="110"/>
                <DataGridCheckBoxColumn Header="Update Revision" Binding="{Binding UpdateRevision}" Width="130"/>
                <DataGridCheckBoxColumn Header="Update Both" Binding="{Binding UpdateBoth}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>