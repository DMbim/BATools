<Window x:Class="BA.UI.Views.BASuperSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BA.UI.Views" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        Title="BA | Super Selector"
        Height="820" Width="920"
        MinHeight="680" MinWidth="800"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="SsCard"        Color="#141416"/>
            <SolidColorBrush x:Key="SsCard2"       Color="#101012"/>
            <SolidColorBrush x:Key="SsMuted"       Color="#B7B7BC"/>
            <SolidColorBrush x:Key="SsBorder"      Color="#2A2A2E"/>
            <SolidColorBrush x:Key="SsText"        Color="#F2F2F2"/>
            <SolidColorBrush x:Key="SsCheckFill"   Color="#4A8FE0"/>

            <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="SsDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background"           Value="{StaticResource SsCard2}"/>
                <Setter Property="Foreground"           Value="{StaticResource SsText}"/>
                <Setter Property="RowBackground"        Value="{StaticResource SsCard2}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource SsCard}"/>
                <Setter Property="GridLinesVisibility"  Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SsBorder}"/>
                <Setter Property="BorderBrush"          Value="{StaticResource SsBorder}"/>
                <Setter Property="BorderThickness"      Value="1"/>
                <Setter Property="RowHeaderWidth"       Value="0"/>
                <Setter Property="RowHeight"            Value="34"/>
                <Setter Property="ColumnHeaderHeight"   Value="34"/>
                <Setter Property="HeadersVisibility"    Value="Column"/>
                <Setter Property="SelectionMode"        Value="Single"/>
                <Setter Property="CanUserAddRows"       Value="False"/>
                <Setter Property="CanUserDeleteRows"    Value="False"/>
                <Setter Property="CanUserResizeRows"    Value="False"/>
                <Setter Property="AutoGenerateColumns"  Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGrid}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="DG_ScrollViewer"
                                              Focusable="False"
                                              Background="{TemplateBinding Background}">
                                    <ScrollViewer.Template>
                                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                            <Grid Background="{TemplateBinding Background}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                                                 Grid.Row="0" Grid.Column="0"/>

                                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                        Grid.Row="1" Grid.Column="0"
                                                                        CanContentScroll="{TemplateBinding CanContentScroll}"/>

                                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                                           Grid.Row="1" Grid.Column="1"
                                                           Orientation="Vertical"
                                                           Maximum="{TemplateBinding ScrollableHeight}"
                                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                                           Grid.Row="2" Grid.Column="0"
                                                           Orientation="Horizontal"
                                                           Maximum="{TemplateBinding ScrollableWidth}"
                                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                                           Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SsHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background"      Value="{StaticResource SsCard}"/>
                <Setter Property="Foreground"      Value="{StaticResource SsMuted}"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="BorderBrush"     Value="{StaticResource SsBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding"         Value="10,0"/>
            </Style>

            <Style x:Key="SsRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{StaticResource SsText}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2A3A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SsCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground"      Value="{StaticResource SsText}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="10,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Left pane (All Categories): plain multi-select highlight,
                 no checkbox. IsSelected two-way binds to IsSelectedForMove
                 so the arrow button knows what to move without wrestling
                 ListBox.SelectedItems binding. -->
            <Style x:Key="SsSourceListBoxItem" TargetType="ListBoxItem">
                <Setter Property="IsSelected" Value="{Binding IsSelectedForMove, Mode=TwoWay}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Foreground" Value="{StaticResource SsText}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A5A9E"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1E2A3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Right pane (Frequent Categories) row. Rooted in a Button so
                 the click reliably registers (see VfLegendCheckTemplate's
                 comment in BAViewFilterColorManager.xaml for why a bare
                 clickable Border inside a list item is unreliable). The
                 remove "X" is a second, nested Button revealed on hover via
                 ControlTemplate.Triggers - its own Click is handled and does
                 not bubble to the outer Button's Command. -->
            <DataTemplate x:Key="SsFrequentRowTemplate">
                <Button Command="{Binding DataContext.ToggleFrequentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="4">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chip"
                                    Background="{StaticResource SsCard}"
                                    BorderBrush="{StaticResource SsBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,5"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource SsText}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="RemoveBtn"
                                            Content="&#x2715;"
                                            FontSize="10"
                                            Visibility="Collapsed"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource SsMuted}"
                                            Padding="6,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Send back to All Categories"
                                            Command="{Binding DataContext.MoveToAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource SsCheckFill}"/>
                                    <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource SsCheckFill}"/>
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource SsCheckFill}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="290"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Move categories to the right with the arrow. Click a category on the right to mark it for use; hover to send it back."
                   Foreground="{StaticResource SsMuted}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SsCard2}"
                    BorderBrush="{StaticResource SsBorder}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="All Categories"
                               Foreground="{StaticResource SsMuted}"
                               FontWeight="SemiBold"
                               Padding="8,6"
                               Background="{StaticResource SsCard}"/>
                    <ListBox ItemsSource="{Binding AllCategories}"
                             SelectionMode="Extended"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource SsSourceListBoxItem}"
                             TextSearch.TextPath="Name"
                             ToolTip="Type a letter to jump to a category. Ctrl/Shift click to multi-select.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Button Grid.Column="1"
                    Style="{StaticResource BaSecondaryButton}"
                    Command="{Binding MoveToFrequentCommand}"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    Width="32" Height="32"
                    Padding="0"
                    ToolTip="Move selected categories to the frequent list">
                <Path Data="M 3,3 L 10,10 L 3,17"
                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
            </Button>

            <Border Grid.Column="2"
                    Background="{StaticResource SsCard2}"
                    BorderBrush="{StaticResource SsBorder}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Frequent Categories"
                               Foreground="{StaticResource SsMuted}"
                               FontWeight="SemiBold"
                               Padding="8,6"
                               Background="{StaticResource SsCard}"/>
                    <ListBox ItemsSource="{Binding FrequentCategories}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4"
                             ItemTemplate="{StaticResource SsFrequentRowTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="Combine rows with:"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SsMuted}"
                       Margin="0,0,8,0"/>
            <RadioButton Content="AND"
                         Style="{StaticResource BaRadioButton}"
                         IsChecked="{Binding UseAnd}"
                         GroupName="SuperSelectorLogic"
                         ToolTip="An element must satisfy every row to be selected"/>
            <RadioButton Content="OR"
                         Style="{StaticResource BaRadioButton}"
                         IsChecked="{Binding UseOr}"
                         GroupName="SuperSelectorLogic"
                         ToolTip="An element satisfying any one row will be selected"
                         Margin="16,0,0,0"/>
            <Button Content="Add Row"
                    Style="{StaticResource BaSecondaryButton}"
                    Command="{Binding AddRowCommand}"
                    Margin="24,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Rows}"
                  Style="{StaticResource SsDataGridStyle}"
                  IsReadOnly="False"
                  ColumnHeaderStyle="{StaticResource SsHeaderStyle}"
                  RowStyle="{StaticResource SsRowStyle}"
                  CellStyle="{StaticResource SsCellStyle}">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Parameter" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource BaDarkComboBox}"
                                      ItemsSource="{Binding AvailableParameters}"
                                      SelectedItem="{Binding SelectedParameter, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Modifier" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource BaDarkComboBox}"
                                      ItemsSource="{Binding AvailableModifiers}"
                                      SelectedItem="{Binding SelectedModifier, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Value" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource BaDarkTextBox}"
                                         Text="{Binding ValueA, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding NeedsSingleValue, Converter={StaticResource BoolToVis}}"
                                         Width="100"/>
                                <TextBox Style="{StaticResource BaDarkTextBox}"
                                         Text="{Binding ValueA, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding NeedsRangeValues, Converter={StaticResource BoolToVis}}"
                                         ToolTip="Lower bound"
                                         Width="70"/>
                                <TextBlock Text=" to "
                                           VerticalAlignment="Center"
                                           Visibility="{Binding NeedsRangeValues, Converter={StaticResource BoolToVis}}"/>
                                <TextBox Style="{StaticResource BaDarkTextBox}"
                                         Text="{Binding ValueB, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding NeedsRangeValues, Converter={StaticResource BoolToVis}}"
                                         ToolTip="Upper bound"
                                         Width="70"/>
                                <TextBox Style="{StaticResource BaDarkTextBox}"
                                         Text="{Binding ValueList, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding NeedsListValue, Converter={StaticResource BoolToVis}}"
                                         ToolTip="Comma separated values"
                                         Width="180"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="40" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="&#x2715;"
                                    Style="{StaticResource BaSecondaryButton}"
                                    Command="{Binding DataContext.RemoveRowCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Width="28"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Select in Model"
                    Style="{StaticResource BaPrimaryButton}"
                    Command="{Binding RunCommand}"
                    MinWidth="140"
                    Margin="0,0,8,0"/>
            <Button Content="Close"
                    Style="{StaticResource BaSecondaryButton}"
                    Command="{Binding CloseCommand}"
                    MinWidth="110"/>
        </StackPanel>

        <Border Grid.Row="5"
                Margin="0,10,0,0"
                BorderBrush="{StaticResource SsBorder}"
                BorderThickness="0,1,0,0"
                Padding="2,10,2,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource SsMuted}"
                       FontSize="12"/>
        </Border>

    </Grid>
</Window>