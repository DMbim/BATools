<Window x:Class="BA.UI.AddSharedParamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Add Shared Parameters"
        Height="560" Width="960"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="SpBorder" Color="#2C3440"/>
            <SolidColorBrush x:Key="SpPanel"  Color="#11151C"/>
            <SolidColorBrush x:Key="SpAlt"    Color="#16161A"/>

            <Style x:Key="SpDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background"               Value="{StaticResource SpPanel}"/>
                <Setter Property="Foreground"               Value="#F2F2F2"/>
                <Setter Property="RowBackground"            Value="{StaticResource SpPanel}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource SpAlt}"/>
                <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SpBorder}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource SpBorder}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="RowHeaderWidth"           Value="0"/>
                <Setter Property="RowHeight"                Value="28"/>
                <Setter Property="HeadersVisibility"        Value="Column"/>
                <Setter Property="SelectionMode"            Value="Extended"/>
                <Setter Property="AutoGenerateColumns"      Value="False"/>
                <Setter Property="CanUserAddRows"           Value="False"/>
                <Setter Property="EnableRowVirtualization"  Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            </Style>

            <Style x:Key="SpHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background"      Value="#16161A"/>
                <Setter Property="Foreground"      Value="#F2F2F2"/>
                <Setter Property="BorderBrush"     Value="{StaticResource SpBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding"         Value="10,6"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
            </Style>

            <Style x:Key="SpRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2A3A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SpCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground"       Value="#F2F2F2"/>
                <Setter Property="BorderThickness"  Value="0"/>
                <Setter Property="Padding"          Value="8,2"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ TOP BAR: search + set buttons ════════════════════════════════ -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <TextBox x:Name="TxtSearch"
                     Style="{StaticResource BaDarkTextBox}"
                     Width="260"
                     Margin="0,0,8,0"/>
            <Button Content="Search"
                    Style="{StaticResource BaSecondaryButton}"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="BtnSearch_Click"/>
            <Button Content="Load Set"
                    Style="{StaticResource BaSecondaryButton}"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="BtnLoadSet_Click"/>
            <Button Content="Save Set"
                    Style="{StaticResource BaSecondaryButton}"
                    Width="90"
                    Click="BtnSaveSet_Click"/>
        </StackPanel>

        <!-- ══ MAIN CONTENT: two DataGrids side by side ══════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Available shared parameters (read-only) ─────────── -->
            <Border Grid.Column="0"
                    Style="{StaticResource BaDarkPanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Available Shared Parameters"
                               Foreground="#A0A8B4"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <DataGrid x:Name="DgShared"
                              Grid.Row="1"
                              Style="{StaticResource SpDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource SpHeaderStyle}"
                              RowStyle="{StaticResource SpRowStyle}"
                              CellStyle="{StaticResource SpCellStyle}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Shared Name"
                                                Binding="{Binding Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Spec"
                                                Binding="{Binding Spec}"
                                                Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ── MIDDLE: Add / Remove buttons ─────────────────────────── -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8,0">
                <Button Content="Add →"
                        Style="{StaticResource BaPrimaryButton}"
                        Width="90"
                        Margin="0,0,0,8"
                        Click="BtnAdd_Click"/>
                <Button Content="← Remove"
                        Style="{StaticResource BaSecondaryButton}"
                        Width="90"
                        Click="BtnRemove_Click"/>
            </StackPanel>

            <!-- ── RIGHT: Selected parameters to add (editable) ──────────── -->
            <Border Grid.Column="2"
                    Style="{StaticResource BaDarkPanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Parameters to Add"
                               Foreground="#A0A8B4"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <DataGrid x:Name="DgSelected"
                              Grid.Row="1"
                              Style="{StaticResource SpDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource SpHeaderStyle}"
                              RowStyle="{StaticResource SpRowStyle}"
                              CellStyle="{StaticResource SpCellStyle}"
                              IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Shared Name"
                                                Binding="{Binding SharedName}"
                                                IsReadOnly="True"
                                                Width="*"/>
                            <DataGridComboBoxColumn Header="Group"
                                                    SelectedItemBinding="{Binding Group, Mode=TwoWay}"
                                                    Width="160"/>
                            <DataGridCheckBoxColumn Header="Instance"
                                                    Binding="{Binding IsInstance}"
                                                    Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ BOTTOM BAR ════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Apply to Family"
                    Style="{StaticResource BaPrimaryButton}"
                    Width="150"
                    Margin="0,0,8,0"
                    Click="BtnApply_Click"/>
            <Button Content="Close"
                    Style="{StaticResource BaSecondaryButton}"
                    Width="90"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
