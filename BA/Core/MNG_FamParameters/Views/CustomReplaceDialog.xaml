<Window x:Class="BA.UI.CustomReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Replace"
        Width="800" Height="250"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="CrBorder" Color="#2C3440"/>
            <SolidColorBrush x:Key="CrPanel"  Color="#11151C"/>
            <SolidColorBrush x:Key="CrAlt"    Color="#16161A"/>
            <SolidColorBrush x:Key="CrMapped" Color="#2A2F33"/>

            <Style x:Key="CrDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background"               Value="{StaticResource CrPanel}"/>
                <Setter Property="Foreground"               Value="#F2F2F2"/>
                <Setter Property="RowBackground"            Value="{StaticResource CrPanel}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource CrAlt}"/>
                <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CrBorder}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource CrBorder}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="RowHeaderWidth"           Value="0"/>
                <Setter Property="RowHeight"                Value="28"/>
                <Setter Property="HeadersVisibility"        Value="Column"/>
                <Setter Property="SelectionMode"            Value="Single"/>
                <Setter Property="AutoGenerateColumns"      Value="False"/>
                <Setter Property="CanUserAddRows"           Value="False"/>
            </Style>

            <Style x:Key="CrHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background"      Value="#16161A"/>
                <Setter Property="Foreground"      Value="#F2F2F2"/>
                <Setter Property="BorderBrush"     Value="{StaticResource CrBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding"         Value="8,4"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
            </Style>

            <Style x:Key="CrCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground"       Value="#F2F2F2"/>
                <Setter Property="BorderThickness"  Value="0"/>
                <Setter Property="Padding"          Value="8,2"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Row style with mapped highlight + selection -->
            <Style x:Key="CrFamilyRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMapped}" Value="True">
                        <Setter Property="Background" Value="{StaticResource CrMapped}"/>
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2A3A"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CrRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2A3A"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- ══ TOP SEARCH BAR ════════════════════════════════════════════════ -->
        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Top"
                    Margin="0,0,0,6">
            <TextBox x:Name="TxtSearch"
                     Width="250" Margin="0,0,8,0"
                     Style="{StaticResource BaDarkTextBox}"/>
            <Button Content="Search"
                    Width="80"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="BtnSearch_Click"/>
        </StackPanel>

        <!-- ══ MAIN CONTENT ══════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Left grid: Family parameters ───────────────────────────── -->
            <DataGrid x:Name="DgFamily"
                      Grid.Row="0" Grid.Column="0"
                      Style="{StaticResource CrDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource CrHeaderStyle}"
                      RowStyle="{StaticResource CrFamilyRowStyle}"
                      CellStyle="{StaticResource CrCellStyle}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Family Param"
                                        Binding="{Binding Name}"
                                        IsReadOnly="True"
                                        Width="*"/>
                    <DataGridTextColumn Header="Spec"
                                        Binding="{Binding Spec}"
                                        IsReadOnly="True"
                                        Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── Right grid: Shared parameters ──────────────────────────── -->
            <DataGrid x:Name="DgShared"
                      Grid.Row="0" Grid.Column="2"
                      Style="{StaticResource CrDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource CrHeaderStyle}"
                      RowStyle="{StaticResource CrRowStyle}"
                      CellStyle="{StaticResource CrCellStyle}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Shared Name"
                                        Binding="{Binding Name}"
                                        IsReadOnly="True"
                                        Width="*"/>
                    <DataGridTextColumn Header="Spec"
                                        Binding="{Binding Spec}"
                                        IsReadOnly="True"
                                        Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── Bottom buttons ──────────────────────────────────────────── -->
            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Map"
                        Width="100" Margin="0,0,10,0"
                        Style="{StaticResource BaPrimaryButton}"
                        Click="BtnMap_Click"/>
                <Button Content="Close"
                        Width="100"
                        Style="{StaticResource BaSecondaryButton}"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
