<Window x:Class="BA.UI.Overhead.OverheadConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overhead Auto-Dash – Settings"
        Width="560" Height="520"
        MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{DynamicResource BaWindow}"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Dynamically created CheckBox items in CategoryList (see PopulateCategories
                 in the code-behind) never set an explicit Style, so they need an implicit
                 (unkeyed) CheckBox style in this window's scope to pick up dark theming. -->
            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaCheckBox}"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Presets:" Style="{StaticResource BaLabelText}" Margin="0,0,8,0"/>
            <Button Content="Architecture"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="PresetArchitecture_Click"
                    Margin="0,0,6,0"/>
            <Button Content="MEP"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="PresetMEP_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Categories" Style="{StaticResource BaGroupBox}" Margin="0,0,8,0">
                <DockPanel>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource BaTextBox}"
                             DockPanel.Dock="Top" Margin="0,0,0,6"
                             ToolTip="Type to filter categories..."/>
                    <ListBox x:Name="CategoryList"
                             Style="{StaticResource BaListBox}"
                             ItemContainerStyle="{StaticResource BaListBoxItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"/>
                </DockPanel>
            </GroupBox>

            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <GroupBox Header="Overhead Band" Style="{StaticResource BaGroupBox}" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <RadioButton x:Name="UseNextLevelRadio"
                                     Style="{StaticResource BaRadioButton}"
                                     Content="Top = next level above (clamped)"
                                     Margin="0,0,0,4"/>
                        <RadioButton x:Name="UseViewTopRadio"
                                     Style="{StaticResource BaRadioButton}"
                                     Content="Top = view top"/>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Fallback Cut (mm)" Style="{StaticResource BaLabelText}" Width="140"/>
                            <TextBox x:Name="FallbackCutBox" Style="{StaticResource BaTextBox}" Width="90"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Other" Style="{StaticResource BaGroupBox}">
                    <StackPanel Margin="8">
                        <DockPanel>
                            <TextBlock Text="Tiny threshold (mm)" Style="{StaticResource BaLabelText}" Width="140"/>
                            <TextBox x:Name="TinyThresholdBox" Style="{StaticResource BaTextBox}" Width="90"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Overhead Enable / Disable" Style="{StaticResource BaGroupBox}" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <DockPanel>
                            <Button x:Name="TurnOffButton"
                                    Style="{StaticResource BaSecondaryButton}"
                                    Content="Turn off Overhead lines"
                                    Width="150" Margin="0,0,0,6"
                                    Click="TurnOff_Click"/>
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="TurnOnButton"
                                    Style="{StaticResource BaSecondaryButton}"
                                    Content="Turn on Overhead lines"
                                    Width="150"
                                    Click="TurnOn_Click"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel"
                        Style="{StaticResource BaSecondaryButton}"
                        Width="90" Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="OK"
                        Style="{StaticResource BaPrimaryButton}"
                        Width="120"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>