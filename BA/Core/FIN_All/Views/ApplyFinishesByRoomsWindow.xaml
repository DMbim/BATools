<Window x:Class="BA.UI.Finishes.ApplyFinishesByRoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:BA.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Apply Finishes by Rooms"
        Height="880" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- GroupBox header in dark theme -->
            <Style TargetType="GroupBox">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.DarkPanelBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource Brush.DarkPanelBg}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="6,6,0,0"
                                        Padding="10,6">
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.Foreground="#F2F2F2"
                                                      TextBlock.FontWeight="SemiBold"/>
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource Brush.DarkPanelBg}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1,0,1,1"
                                        CornerRadius="0,0,6,6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark ListBox -->
            <Style TargetType="ListBox" BasedOn="{StaticResource BaDarkListBox}"/>
            <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="Padding" Value="4,2"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.HoverDark}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Plain text in panels -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F2F2F2"/>
            </Style>

            <!-- Radio buttons in panels -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="#F2F2F2"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- ══ TOP BAR ═══════════════════════════════════════════════════════ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnRefreshRooms"
                    Content="Refresh rooms"
                    Width="140" Margin="0,0,8,0"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="BtnRefreshRooms_Click"/>
            <Button x:Name="BtnPickRooms"
                    Content="Pick in model (Rooms/Tags)"
                    Width="220" Margin="0,0,8,0"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="BtnPickRooms_Click"/>
            <TextBlock Text="Search:"
                       VerticalAlignment="Center"
                       Foreground="#A0A8B4"
                       Margin="8,0,6,0"/>
            <TextBox x:Name="TxtSearch"
                     Width="240"
                     VerticalAlignment="Center"
                     Style="{StaticResource BaDarkTextBox}"
                     TextChanged="TxtSearch_TextChanged"/>
        </StackPanel>

        <!-- ══ MAIN CONTENT ═════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Rooms list ──────────────────────────────────────────────── -->
            <GroupBox Header="Rooms" Grid.Column="0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Foreground="#A0A8B4"
                               Text="Select one or more rooms. Use Ctrl/Shift for multi-select."/>
                    <ListBox x:Name="ListRooms"
                             SelectionMode="Extended"
                             DisplayMemberPath="Display"/>
                </DockPanel>
            </GroupBox>

            <!-- ── Options ─────────────────────────────────────────────────── -->
            <GroupBox Header="Finish Options" Grid.Column="2" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Apply to:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkWalls"    Content="Walls"    IsChecked="True"  Margin="0,0,16,0" Style="{StaticResource BaDarkPanelCheckBox}"/>
                            <CheckBox x:Name="ChkFloors"   Content="Floors"   IsChecked="False" Margin="0,0,16,0" Style="{StaticResource BaDarkPanelCheckBox}"/>
                            <CheckBox x:Name="ChkCeilings" Content="Ceilings" IsChecked="False" Style="{StaticResource BaDarkPanelCheckBox}"/>
                        </StackPanel>

                        <Separator Margin="0,2,0,10"/>

                        <TextBlock Text="Finish Type Source:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <RadioButton x:Name="RadioFixedType"
                                     Content="Fixed type (chosen below)"
                                     GroupName="FinishTypeSource"
                                     IsChecked="True"
                                     Margin="0,0,0,4"
                                     Checked="FinishTypeSource_Changed"/>
                        <RadioButton x:Name="RadioRoomDefinedType"
                                     Content="Defined by room"
                                     GroupName="FinishTypeSource"
                                     Margin="0,0,0,4"
                                     Checked="FinishTypeSource_Changed"/>
                        <TextBlock Text="Reads the Type Name from each room's BA.Tls_RoomFinish_Wall / _Floor / _Ceiling parameter. If a room has no value, or the value doesn't match a loaded type, that category is skipped for that room."
                                   Foreground="#A0A8B4" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Finish Types:" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <TextBlock Text="Finish wall type" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbWallType"
                                  MinWidth="260" Margin="0,0,0,10"
                                  Style="{StaticResource BaDarkComboBox}"/>

                        <TextBlock Text="Finish floor type" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbFloorType"
                                  MinWidth="260" Margin="0,0,0,10"
                                  Style="{StaticResource BaDarkComboBox}"/>

                        <TextBlock Text="Finish ceiling type" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbCeilingType"
                                  MinWidth="260" Margin="0,0,0,10"
                                  Style="{StaticResource BaDarkComboBox}"/>

                        <Separator Margin="0,2,0,10"/>

                        <TextBlock Text="Wall height controls:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkUseTopOffset"
                                  Content="Use top offset (subtract from room height)"
                                  IsChecked="True"
                                  Margin="0,0,0,6"
                                  Style="{StaticResource BaDarkPanelCheckBox}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Top offset (mm)" Width="160" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTopOffsetMm" Width="120" Text="100"
                                     Style="{StaticResource BaDarkTextBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Base offset (mm)" Width="160" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtBaseOffsetMm" Width="120" Text="0"
                                     Style="{StaticResource BaDarkTextBox}"/>
                        </StackPanel>

                        <Separator Margin="0,2,0,10"/>

                        <TextBlock Text="Ceiling height controls:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkCeilingUseRoomHeightOffset"
                                  Content="Use room height minus offset (like walls)"
                                  IsChecked="True"
                                  Margin="0,0,0,6"
                                  Style="{StaticResource BaDarkPanelCheckBox}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Ceiling top offset (mm)" Width="160" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCeilingTopOffsetMm" Width="120" Text="100"
                                     Style="{StaticResource BaDarkTextBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Ceiling height above level (mm)" Width="160" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCeilingHeightAboveLevelMm" Width="120" Text="2400"
                                     Style="{StaticResource BaDarkTextBox}"/>
                        </StackPanel>
                        <TextBlock Text="Above field is used only when the checkbox is unchecked."
                                   Foreground="#A0A8B4" Margin="0,0,0,12"/>

                        <Separator Margin="0,2,0,10"/>

                        <TextBlock Text="Created element parameters:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="This tool writes:" Foreground="#A0A8B4" Margin="0,0,0,4"/>
                        <TextBlock Text="• BA_Room_Number = Room Number" Foreground="#A0A8B4" Margin="0,0,0,2"/>
                        <TextBlock Text="• BA_Room_Name = Room Name" Foreground="#A0A8B4" Margin="0,0,0,2"/>
                        <TextBlock Text="Parameters are auto-bound to Walls/Floors/Ceilings from the BA shared parameter file if not already present in the project."
                                   Foreground="#A0A8B4" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Button x:Name="BtnRun"
                                Content="Create finishes"
                                Height="42"
                                Style="{StaticResource BaPrimaryButton}"
                                Click="BtnRun_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
