<Window x:Class="BA.Commands.Rooms.RoomHostFinishTransferWindow"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room ⇄ Floor/Ceiling Transfer"
        Width="1700" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F10" Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#2D6CDF"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#2D6CDF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Neutral button (Load/Save/Add/Remove) -->
            <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#1A1A1D"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2A2A2D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#222226"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#17171A"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Combo items -->
            <x:Array x:Key="SourceCategoryItems" Type="{x:Type sys:String}">
                <sys:String>Ceiling</sys:String>
                <sys:String>Floor</sys:String>
            </x:Array>

            <!-- DataGrid header style -->
            <Style x:Key="DarkDataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#16161A"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2A2A2D"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- DataGrid cell style -->
            <Style x:Key="DarkDataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2A2A2D"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- ComboBox inside DataGridComboBoxColumn -->


            <Style x:Key="DarkComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Background" Value="#141416"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
            </Style>

            <!-- Room picker ListBox -->
            <Style x:Key="DarkListBoxStyle" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="#141416"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2A2A2D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>

            <Style x:Key="DarkListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E1E22"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2D6CDF"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Load Settings" Width="120" Margin="0,0,8,0" Click="BtnLoad_Click"
        Style="{StaticResource SecondaryButtonStyle}"/>

            <Button Content="Save Settings" Width="120" Margin="0,0,16,0" Click="BtnSave_Click"
        Style="{StaticResource SecondaryButtonStyle}"/>

            <Button Content="Add Mapping" Width="120" Margin="0,0,8,0" Click="BtnAdd_Click"
        Style="{StaticResource SecondaryButtonStyle}"/>

            <Button Content="Remove Selected" Width="140" Margin="0,0,16,0" Click="BtnRemove_Click"
        Style="{StaticResource SecondaryButtonStyle}"/>

            <Border BorderBrush="#2A2A2D" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Run Transfer" Width="140" Height="32" Click="BtnRun_Click"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    <TextBlock x:Name="TxtStatus" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.85"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Room picker panel -->
            <Border Grid.Column="0" BorderBrush="#2A2A2D" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Rooms" FontWeight="SemiBold" Margin="2,0,0,8" Foreground="#F2F2F2"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Load Rooms" Width="104" Margin="0,0,6,0" Click="BtnLoadRooms_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="All" Width="60" Margin="0,0,6,0" Click="BtnSelectAllRooms_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="None" Width="60" Click="BtnSelectNoneRooms_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>

                    <TextBox Grid.Row="2" x:Name="TxtRoomFilter"
                             Margin="0,0,0,8" Padding="6,4"
                             Background="#1A1A1D" Foreground="#F2F2F2" BorderBrush="#2A2A2D"
                             TextChanged="TxtRoomFilter_TextChanged"
                             ToolTip="Filter by Number or Name"/>

                    <ListBox Grid.Row="3" x:Name="ListRooms"
                             Style="{StaticResource DarkListBoxStyle}"
                             ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                             DisplayMemberPath="Display"
                             SelectionChanged="ListRooms_SelectionChanged"/>

                    <TextBlock Grid.Row="4" x:Name="TxtRoomCount" Margin="2,8,0,0" Opacity="0.8"
                               Foreground="#F2F2F2" Text="No rooms loaded."/>
                </Grid>
            </Border>

            <!-- Mappings panel -->
            <Border Grid.Column="2" BorderBrush="#2A2A2D" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Mappings (Source: Floor/Ceiling parameter → Target: Room parameter)"
                               FontWeight="SemiBold" Margin="2,0,0,8"
                               Foreground="#F2F2F2"/>

                    <DataGrid Grid.Row="1"
                              x:Name="GridMappings"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="#141416"
                              BorderBrush="#2A2A2D"
                              RowBackground="#141416"
                              AlternatingRowBackground="#16161A"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Extended"
                              Foreground="#F2F2F2"
                              ColumnHeaderStyle="{StaticResource DarkDataGridHeaderStyle}"
                              CellStyle="{StaticResource DarkDataGridCellStyle}">

                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Source Category"
                                                Width="160"
                                                SelectedItemBinding="{Binding SourceCategory, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{StaticResource SourceCategoryItems}" />
                            <DataGridTextColumn Header="Source Parameter Name (Floor/Ceiling)"
                                                Width="260"
                                                Binding="{Binding SourceParameterName, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Target Room Parameter Name"
                                                Width="260"
                                                Binding="{Binding TargetRoomParameterName, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="Write If Target Empty Only"
                                                    Width="180"
                                                    Binding="{Binding WriteOnlyIfEmpty}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>

    </DockPanel>
</Window>
