<Window x:Class="BATools.Zoom.Views.ZoomToRoomSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zoom to Room Settings"
        Height="320" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#161B22"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="CaretBrush" Value="#F2F2F2"/>
            </Style>

            <Style x:Key="DarkRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="DarkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1A1A1D"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#222226"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#17171A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Link label -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Link combo -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Room ID header -->
            <RowDefinition Height="Auto"/>
            <!-- 3: RbBuiltIn -->
            <RowDefinition Height="Auto"/>
            <!-- 4: RbByName + name textbox -->
            <RowDefinition Height="Auto"/>
            <!-- 5: RbShared + guid textbox -->
            <RowDefinition Height="*"/>
            <!-- 6: spacer -->
            <RowDefinition Height="Auto"/>
            <!-- 7: OK/Cancel -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Revit Link Instance (used by 'Zoom to Room (Link)' only):"
                   Foreground="#A0A8B4"
                   Margin="0,0,0,4"
                   TextWrapping="Wrap"/>
        <ComboBox x:Name="LinksComboBox"
                  Grid.Row="1"
                  Style="{StaticResource BaDarkComboBox}"
                  Margin="0,0,0,14"
                  DisplayMemberPath="Name"/>

        <TextBlock Grid.Row="2"
                   Text="Room ID Parameter:"
                   Foreground="#A0A8B4"
                   Margin="0,0,0,6"/>

        <RadioButton x:Name="RbBuiltIn"
                     Grid.Row="3"
                     GroupName="RoomIdMode"
                     Style="{StaticResource DarkRadioButtonStyle}"
                     Content="Built-in (Number)"
                     Checked="ModeRadio_Checked"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
            <RadioButton x:Name="RbByName"
                         GroupName="RoomIdMode"
                         Style="{StaticResource DarkRadioButtonStyle}"
                         Content="By Name:"
                         Width="110"
                         Checked="ModeRadio_Checked"/>
            <TextBox x:Name="NameTextBox"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Width="280"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <RadioButton x:Name="RbShared"
                         GroupName="RoomIdMode"
                         Style="{StaticResource DarkRadioButtonStyle}"
                         Content="Shared GUID:"
                         Width="110"
                         Checked="ModeRadio_Checked"/>
            <TextBox x:Name="GuidTextBox"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Width="280"/>
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0"
                    Content="OK"
                    IsDefault="True"
                    Style="{StaticResource DarkButtonStyle}"
                    Click="OkButton_Click"/>
            <Button Width="90"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource DarkButtonStyle}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
