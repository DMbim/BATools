<Window x:Class="BA.Views.Export.BookletWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BA.Views.Converters"
        Style="{DynamicResource BaWindow}"
        Title="BA Tools - Type Booklet Generator"
        Width="1100" Height="740"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <Style x:Key="BookletHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#16161A"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="BookletRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2A3A"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding HasPlacedInstance}" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BookletCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Left: grouping + type picker -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Group By" FontWeight="Bold" Margin="0,0,0,6" />

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Content="Revit Category" IsChecked="{Binding IsCategoryMode}" Foreground="#F2F2F2" Margin="0,0,16,0"
                             ToolTip="Groups by an actual Revit category, Windows, Doors, Casework, and similar." />
                <RadioButton Content="Parameter Value" IsChecked="{Binding IsParameterMode}" Foreground="#F2F2F2"
                             ToolTip="Groups by any parameter carrying a value, useful for a custom classification that isn't a Revit category at all, like a shop drawing grouping." />
            </StackPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}"
                          Style="{DynamicResource BaDarkComboBox}"
                          Visibility="{Binding IsCategoryMode, Converter={StaticResource BoolToVis}}" />

                <TextBox Grid.Column="0" Text="{Binding GroupingParameterName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource BaDarkTextBox}"
                         Visibility="{Binding IsParameterMode, Converter={StaticResource BoolToVis}}"
                         ToolTip="The parameter name to group by, e.g. a shared classification parameter. Any type carrying a non-empty value on this parameter is included, regardless of category." />

                <Button Grid.Column="2" Content="Load Types" Style="{DynamicResource BaSecondaryButton}"
                        Command="{Binding LoadTypesCommand}" />
            </Grid>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource BaDarkTextBox}"
                         ToolTip="Filters the list below by type or family name as you type." />
                <Button Grid.Column="2" Content="Select All" Style="{DynamicResource BaSecondaryButton}"
                        Command="{Binding SelectAllCommand}"
                        ToolTip="Selects every currently visible type that has at least one placed instance. Types with no placed instance can't be selected, there's nothing to cut an elevation or section through." />
                <Button Grid.Column="4" Content="Select None" Style="{DynamicResource BaSecondaryButton}"
                        Command="{Binding SelectNoneCommand}" />
            </Grid>

            <DataGrid ItemsSource="{Binding FilteredTypes}"
                      Style="{DynamicResource BaDataGrid}"
                      ColumnHeaderStyle="{StaticResource BookletHeaderStyle}"
                      RowStyle="{StaticResource BookletRowStyle}"
                      CellStyle="{StaticResource BookletCellStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      ColumnWidth="*">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Include" Binding="{Binding IsSelected}" Width="60"/>
                    <DataGridTextColumn Header="Family" Binding="{Binding FamilyName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" IsReadOnly="True" Width="1.5*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" IsReadOnly="True" Width="2.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Right: info fields + sheet settings + run -->
        <Border Grid.Column="2" Style="{DynamicResource BaDarkPanelBorder}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding IsBusy, Converter={conv:InverseBooleanConverter}}">
                    <TextBlock Text="Generation Method" FontWeight="Bold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="Real Views" IsChecked="{Binding IsRealViewMode}" Foreground="#F2F2F2" Margin="0,0,16,0"
                                 ToolTip="Creates genuine elevation and floor plan views per type, cut through an actual placed instance. Needs at least one placed instance of the type in the model." />
                        <RadioButton Content="Legend Components" IsChecked="{Binding IsLegendMode}" Foreground="#F2F2F2"
                                 ToolTip="Duplicates an existing seed Legend view per type and retargets its components, a lighter, symbolic 2D representation. Needs no placed instance, only a manually pre-built seed Legend view." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsLegendMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                        <TextBlock Text="Seed Legend View" />
                        <ComboBox ItemsSource="{Binding AvailableLegendViews}" SelectedItem="{Binding SelectedLegendView}"
                              Style="{DynamicResource BaDarkComboBox}" Margin="0,2,0,0"
                              ToolTip="The existing Legend view containing your manually placed placeholder component(s), duplicated once per selected type. Must already exist, there is no way to create one from this tool." />
                    </StackPanel>

                    <TextBlock Text="Title Block Field Mappings" FontWeight="Bold" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding TitleBlockFieldMappings}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SourceField.DisplayName}" VerticalAlignment="Center"
                                           ToolTip="The source parameter, read from the selected types." />
                                    <TextBox Grid.Column="2" Text="{Binding TitleBlockParameterName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BaDarkTextBox}"
                                         ToolTip="The exact instance parameter name on your title block family this value gets written into." />
                                    <Button Grid.Column="3" Content="Remove" Style="{DynamicResource BaSecondaryButton}"
                                        Command="{Binding DataContext.RemoveFieldMappingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add Field Mapping..." Style="{DynamicResource BaSecondaryButton}"
                        Command="{Binding AddFieldMappingCommand}" Margin="0,0,0,10"
                        ToolTip="Pick a parameter from the currently selected types, then type the matching title block parameter name into the row. Select types in the list on the left first, the parameter list comes from them." />

                    <TextBlock Text="Item Mark Title Block Parameter" />
                    <TextBox Text="{Binding ItemMarkTitleBlockParameterName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource BaDarkTextBox}" Margin="0,2,0,10"
                         ToolTip="The title block parameter name to receive an auto numbered item mark, e.g. 'OZN'. Leave blank to skip setting one. Not a field mapping, this is a running number, not a value pulled from the type." />

                    <TextBlock Text="Item Mark Prefix" />
                    <TextBox Text="{Binding ItemMarkPrefix, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource BaDarkTextBox}" Margin="0,2,0,10"
                         ToolTip="Text placed before the running number, e.g. 'Z ' produces 'Z 01', 'Z 02', and so on, one per generated sheet in order." />

                    <TextBlock Text="Title Block" />
                    <ComboBox ItemsSource="{Binding AvailableTitleBlocks}" SelectedItem="{Binding SelectedTitleBlock}"
                          Style="{DynamicResource BaDarkComboBox}" Margin="0,2,0,10" />

                    <StackPanel Visibility="{Binding IsRealViewMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Crop Margin (mm)" />
                        <TextBox Text="{Binding CropMarginMm, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaDarkTextBox}" Margin="0,2,0,10"
                             ToolTip="Extra space added around the instance on all sides in the elevation and floor plan crop, so the graphic isn't cropped flush against the frame edge." />

                        <TextBlock Text="View Scale (1:N)" />
                        <TextBox Text="{Binding ViewScale, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaDarkTextBox}" Margin="0,2,0,10" />

                        <TextBlock Text="Detail Level" />
                        <ComboBox ItemsSource="{Binding AvailableDetailLevels}" SelectedItem="{Binding DetailLevel}"
                              Style="{DynamicResource BaDarkComboBox}" Margin="0,2,0,10" />
                    </StackPanel>

                    <TextBlock Text="Sheet Number Prefix" />
                    <TextBox Text="{Binding OutputSheetNumberPrefix, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaDarkTextBox}" Margin="0,2,0,10" />

                    <Button Content="Generate Booklets" Style="{DynamicResource BaPrimaryButton}"
                        Command="{Binding RunCommand}" Margin="0,4,0,10"
                        ToolTip="Creates one sheet per checked type, with a real elevation, a real section, and the info block above. One type failing does not stop the rest." />

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.85" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
