<Window x:Class="BA.Views.Export.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BA.Views.Converters"
        Style="{DynamicResource BaWindow}"
        Title="BA Tools - Export Settings"
        Width="880" Height="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Job list -->
        <Border Grid.Column="0" Grid.Row="0" Style="{DynamicResource BaDarkPanelBorder}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                    <Button Content="+ PDF" Style="{DynamicResource BaSecondaryButton}"
                            Command="{Binding AddPdfJobCommand}" Margin="0,0,4,0" />
                    <Button Content="+ DWG" Style="{DynamicResource BaSecondaryButton}"
                            Command="{Binding AddDwgJobCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Jobs}"
                         SelectedItem="{Binding SelectedJob}"
                         DisplayMemberPath="JobName"
                         Margin="4" />
            </DockPanel>
        </Border>

        <!-- Job editor -->
        <Border Grid.Column="2" Grid.Row="0" Style="{DynamicResource BaDarkPanelBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          DataContext="{Binding SelectedJob}">
                <StackPanel Margin="12" IsEnabled="{Binding IsBusy, Converter={conv:InverseBooleanConverter}}">
                    <TextBlock Text="Job Name" />
                    <TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaDarkTextBox}" Margin="0,2,0,10" />

                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Style="{DynamicResource BaDarkPanelCheckBox}" Margin="0,0,0,10" />

                    <TextBlock Text="Sheet Set" />
                    <ComboBox ItemsSource="{Binding AvailableSheetSets}"
                              SelectedItem="{Binding SheetSetName}"
                              Style="{DynamicResource BaDarkComboBox}" Margin="0,2,0,10" />

                    <TextBlock Text="Naming Template" />
                    <TextBox Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaDarkTextBox}" Margin="0,2,0,10" />

                    <TextBlock Text="Date Format (.NET custom format, e.g. yyyyMMdd)" />
                    <TextBox Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaDarkTextBox}" Margin="0,2,0,10" />

                    <TextBlock Text="Output Folder Template" />
                    <TextBox Text="{Binding OutputFolderTemplate, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaDarkTextBox}" Margin="0,2,0,10" />

                    <StackPanel Visibility="{Binding IsDwg, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DWG Export Setup" />
                        <ComboBox ItemsSource="{Binding AvailableDwgExportSetups}"
                                  SelectedItem="{Binding ExportSetupName}"
                                  Style="{DynamicResource BaDarkComboBox}" Margin="0,2,0,10" />
                    </StackPanel>

                    <CheckBox Content="Schedule Enabled" IsChecked="{Binding ScheduleEnabled}" Style="{DynamicResource BaDarkPanelCheckBox}" Margin="0,0,0,6" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Time of Day (HH:mm)" />
                            <TextBox Text="{Binding ScheduledTimeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource BaDarkTextBox}" Width="80" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Catch-up Window (minutes)" />
                            <TextBox Text="{Binding CatchUpMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource BaDarkTextBox}" Width="80" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Scheduled Days (none selected = every day)" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                          Style="{DynamicResource BaDarkPanelCheckBox}" Margin="0,0,10,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <Button Content="Preview Naming" Style="{DynamicResource BaSecondaryButton}"
                                Command="{Binding PreviewCommand}" Margin="0,0,8,0" />
                        <Button Content="Run Now" Style="{DynamicResource BaSecondaryButton}"
                                Command="{Binding RunNowCommand}" />
                    </StackPanel>

                    <TextBlock Text="Preview file name:" FontWeight="Bold" />
                    <TextBlock Text="{Binding PreviewFileName}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="Preview folder:" FontWeight="Bold" />
                    <TextBlock Text="{Binding PreviewFolder}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom bar -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.8" />
            <Button Content="Remove Selected" Style="{DynamicResource BaSecondaryButton}"
                    Command="{Binding RemoveSelectedJobCommand}" Margin="0,0,8,0" />
            <Button Content="Save All" Style="{DynamicResource BaPrimaryButton}"
                    Command="{Binding SaveAllCommand}" />
        </StackPanel>
    </Grid>
</Window>
