<Window x:Class="BA.Views.Export.SheetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource BaWindow}"
        Title="Pick Sheets"
        Width="600" Height="640"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Column header/row/cell styles copied from the confirmed working
                 pattern in BA.UI.Sheets.DateSheetsWindow: BaDataGrid alone does
                 not cover header/row/cell dark styling there either, these are
                 required alongside it, not decorative. -->

            <ContextMenu x:Key="ColumnHeaderContextMenu">
                <MenuItem Header="Add Parameter Column..." Click="AddParameterColumn_Click"/>
                <MenuItem Header="Remove This Column" Click="RemoveThisColumn_Click"/>
                <Separator/>
                <MenuItem Header="Reset Columns" Click="ResetColumns_Click"/>
                <MenuItem Header="Save Column Layout" Click="SaveColumnLayout_Click"/>
            </ContextMenu>

            <Style x:Key="PickerColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#16161A"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="ContextMenu" Value="{StaticResource ColumnHeaderContextMenu}"/>
            </Style>

            <Style x:Key="PickerRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2A3A"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PickerCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="OK" Width="100" Margin="0,0,8,0"
                    IsDefault="True"
                    Style="{DynamicResource BaPrimaryButton}"
                    Click="Ok_Click"/>
            <Button Content="Cancel" Width="100"
                    IsCancel="True"
                    Style="{DynamicResource BaSecondaryButton}"/>
        </StackPanel>

        <DataGrid x:Name="SheetsGrid"
                  Style="{DynamicResource BaDataGrid}"
                  ColumnHeaderStyle="{StaticResource PickerColumnHeaderStyle}"
                  RowStyle="{StaticResource PickerRowStyle}"
                  CellStyle="{StaticResource PickerCellStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False"
                  ColumnWidth="*"
                  ContextMenuOpening="SheetsGrid_ContextMenuOpening">
            <DataGrid.Columns>
                <!-- Was DataGridCheckBoxColumn. Converted to an explicit
                     template column because DataGridCheckBoxColumn generates
                     its CheckBox from an internal template with no
                     accessible Click hook, there is no way to detect
                     Shift+click on it otherwise. -->
                <DataGridTemplateColumn Header="Select" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Click="SelectCheckBox_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Number" Binding="{Binding SheetNumber}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Name" Binding="{Binding SheetName}" IsReadOnly="True" Width="3*"/>
                <DataGridTextColumn Header="Paper Size" Binding="{Binding PaperSizeDisplay}" IsReadOnly="True" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>