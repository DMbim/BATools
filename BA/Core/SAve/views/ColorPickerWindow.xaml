<Window x:Class="BA.Subcategories.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Color"
        Width="300" Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="14">

        <!-- Red -->
        <TextBlock Text="Red:" Foreground="#A0A8B4" Margin="0,0,0,2"/>
        <Slider x:Name="SliderR" Minimum="0" Maximum="255"
                ValueChanged="Slider_ValueChanged" Margin="0,0,0,10"/>

        <!-- Green -->
        <TextBlock Text="Green:" Foreground="#A0A8B4" Margin="0,0,0,2"/>
        <Slider x:Name="SliderG" Minimum="0" Maximum="255"
                ValueChanged="Slider_ValueChanged" Margin="0,0,0,10"/>

        <!-- Blue -->
        <TextBlock Text="Blue:" Foreground="#A0A8B4" Margin="0,0,0,2"/>
        <Slider x:Name="SliderB" Minimum="0" Maximum="255"
                ValueChanged="Slider_ValueChanged" Margin="0,0,0,14"/>

        <!-- Preview swatch -->
        <Border x:Name="PreviewBorder"
                Height="44" CornerRadius="6"
                BorderBrush="#2C3440" BorderThickness="1"
                Margin="0,0,0,8"/>

        <!-- Hex label -->
        <TextBlock x:Name="TxtHex"
                   Foreground="#A0A8B4"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <!-- Preset swatches -->
        <WrapPanel x:Name="PresetPanel" Margin="0,0,0,16"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0"
                    Style="{StaticResource BaSecondaryButton}"
                    Click="BtnCancel_Click"/>
            <Button Content="OK" Width="80"
                    Style="{StaticResource BaPrimaryButton}"
                    Click="BtnOk_Click"/>
        </StackPanel>

    </StackPanel>
</Window>