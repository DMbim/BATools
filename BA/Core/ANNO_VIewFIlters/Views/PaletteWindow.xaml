<Window x:Class="BA.UI.Views.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA | Palette"
        Height="420" Width="380"
        MinHeight="320" MinWidth="320"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Same small local brush set as BAViewFilterColorManager.xaml. Not worth
                 factoring into a shared dictionary for two windows this small, but flagged
                 as a follow-up if a third window ever needs this palette look. -->
            <SolidColorBrush x:Key="VfCard2"  Color="#101012"/>
            <SolidColorBrush x:Key="VfMuted"  Color="#B7B7BC"/>
            <SolidColorBrush x:Key="VfBorder" Color="#2A2A2E"/>
            <SolidColorBrush x:Key="VfText"   Color="#F2F2F2"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Palette"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{StaticResource VfText}"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource VfBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10"
                Background="{StaticResource VfCard2}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Click a swatch to edit it"
                           Foreground="{StaticResource VfMuted}"
                           Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Palette}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="46" Height="46"
                                        Margin="6"
                                        Command="{Binding DataContext.EditPaletteColorCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Swatch"
                                                    CornerRadius="6"
                                                    BorderBrush="{StaticResource VfBorder}"
                                                    BorderThickness="1"
                                                    Background="{Binding Brush}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Swatch" Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}"/>
                                                    <Setter TargetName="Swatch" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Swatch" Property="BorderThickness" Value="3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Auto-Assign to Filters"
                    Style="{StaticResource BaPrimaryButton}"
                    Command="{Binding AutoAssignCommand}"
                    Margin="0,0,8,0"/>
            <Button Content="Import JSON"
                    Style="{StaticResource BaSecondaryButton}"
                    Command="{Binding ImportPaletteCommand}"
                    Margin="0,0,8,0"/>
            <Button Content="Export JSON"
                    Style="{StaticResource BaSecondaryButton}"
                    Command="{Binding ExportPaletteCommand}"/>
        </WrapPanel>
    </Grid>
</Window>