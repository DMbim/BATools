<Window x:Class="BA.UI.Views.BAViewFilterColorManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA | View Filter Color Manager"
        Height="760" Width="1100"
        MinHeight="620" MinWidth="980"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="VfCard"   Color="#141416"/>
            <SolidColorBrush x:Key="VfCard2"  Color="#101012"/>
            <SolidColorBrush x:Key="VfMuted"  Color="#B7B7BC"/>
            <SolidColorBrush x:Key="VfBorder" Color="#2A2A2E"/>
            <SolidColorBrush x:Key="VfText"   Color="#F2F2F2"/>
            <SolidColorBrush x:Key="VfCheckFill" Color="#4A8FE0"/>

            <Style TargetType="TabItem">
                <Setter Property="Margin"     Value="0,0,8,0"/>
                <Setter Property="Padding"    Value="12,8"/>
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource VfMuted}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="10,10,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource VfCard}"/>
                                    <Setter Property="Foreground" Value="{StaticResource VfText}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource VfText}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="VfDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background"           Value="{StaticResource VfCard2}"/>
                <Setter Property="Foreground"           Value="{StaticResource VfText}"/>
                <Setter Property="RowBackground"        Value="{StaticResource VfCard2}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource VfCard}"/>
                <Setter Property="GridLinesVisibility"  Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource VfBorder}"/>
                <Setter Property="BorderBrush"          Value="{StaticResource VfBorder}"/>
                <Setter Property="BorderThickness"      Value="1"/>
                <Setter Property="RowHeaderWidth"       Value="0"/>
                <Setter Property="RowHeight"            Value="34"/>
                <Setter Property="ColumnHeaderHeight"   Value="34"/>
                <Setter Property="HeadersVisibility"    Value="Column"/>
                <Setter Property="SelectionMode"        Value="Single"/>
                <Setter Property="CanUserAddRows"       Value="False"/>
                <Setter Property="CanUserDeleteRows"    Value="False"/>
                <Setter Property="CanUserResizeRows"    Value="False"/>
                <Setter Property="IsReadOnly"           Value="True"/>
                <Setter Property="AutoGenerateColumns"  Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            </Style>
            <Style TargetType="{x:Type ScrollViewer}">
                <Setter Property="Background" Value="{StaticResource VfCard2}"/>
            </Style>
            <Style x:Key="VfHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background"      Value="{StaticResource VfCard}"/>
                <Setter Property="Foreground"      Value="{StaticResource VfMuted}"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="BorderBrush"     Value="{StaticResource VfBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding"         Value="10,0"/>
            </Style>

            <Style x:Key="VfRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{StaticResource VfText}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A5A9E"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2A3A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="VfCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground"      Value="{StaticResource VfText}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="10,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Legend "checkbox" column cell. Deliberately a Button, not a CheckBox.
                 A CheckBox inside a DataGridTemplateColumn cell unreliably eats its
                 first click for the DataGrid's own cell/row selection before the
                 ToggleButton logic underneath ever sees it, which is exactly what
                 caused checked filters to silently not register. A Button routes
                 its Click event through the DataGrid cleanly, same as the Cut/Proj
                 swatch buttons below, which never had this problem. Checked state
                 is read via a DataTrigger against the bound row's IsCheckedForLegend,
                 the actual toggle happens in the VM's ToggleLegendCheckCommand. -->
            <DataTemplate x:Key="VfLegendCheckTemplate">
                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip="Include this filter when building a legend or saving a combined filter group"
                        Command="{Binding DataContext.ToggleLegendCheckCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Box"
                                    Width="16" Height="16"
                                    CornerRadius="3"
                                    BorderBrush="{StaticResource VfBorder}"
                                    BorderThickness="1"
                                    Background="{StaticResource VfCard2}">
                                <Path x:Name="Check"
                                      Data="M 2,7 L 6,11 L 13,3"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCheckedForLegend}" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource VfCheckFill}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource VfCheckFill}"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource VfCheckFill}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="VfCutSwatchTemplate">
                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        ToolTip="Set the Cut Line and Cut Fill color for this filter"
                        Command="{Binding DataContext.PickCutColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Border CornerRadius="6"
                            BorderBrush="{StaticResource VfBorder}"
                            BorderThickness="1"
                            Padding="6"
                            Background="{Binding CutBrush}">
                        <TextBlock Text=" "/>
                    </Border>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="VfProjSwatchTemplate">
                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        ToolTip="Set the Projection Line and Surface Fill color for this filter"
                        Command="{Binding DataContext.PickProjColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Border CornerRadius="6"
                            BorderBrush="{StaticResource VfBorder}"
                            BorderThickness="1"
                            Padding="6"
                            Background="{Binding ProjectionBrush}">
                        <TextBlock Text=" "/>
                    </Border>
                </Button>
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="BA"
                           FontWeight="Bold" FontSize="26"
                           Foreground="#F2F2F2"
                           Margin="0,0,10,0"/>
                <TextBlock Text="View Filter Color Manager"
                           FontSize="18"
                           Foreground="{StaticResource VfMuted}"
                           VerticalAlignment="Bottom"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Auto-Assign Palette"
                        Style="{StaticResource BaSecondaryButton}"
                        Command="{Binding AutoAssignCommand}"
                        ToolTip="Assign the Palette colors to the loaded filters in order, as a preview. Click Apply to write it to the template."
                        Margin="0,0,8,0"/>
                <Button Content="Palette"
                        Style="{StaticResource BaSecondaryButton}"
                        Command="{Binding OpenPaletteCommand}"
                        ToolTip="Open the color palette used by Auto-Assign"
                        Margin="0,0,8,0"/>
                <Button Content="Help"
                        Style="{StaticResource BaSecondaryButton}"
                        Command="{Binding HelpCommand}"
                        ToolTip="Show a quick walkthrough of this window"
                        Margin="0,0,8,0"/>
                <Button Content="Close"
                        Style="{StaticResource BaSecondaryButton}"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource VfCard}"
                BorderBrush="{StaticResource VfBorder}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid Margin="12">
                <TabControl>

                    <TabItem Header="View Template">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: template picker -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource BaDarkComboBox}"
                                          ItemsSource="{Binding ViewTemplates}"
                                          SelectedItem="{Binding SelectedViewTemplate}"
                                          DisplayMemberPath="Name"
                                          ToolTip="View template to load and edit filters for"
                                          Margin="0,0,8,0"/>

                                <Button Grid.Column="1"
                                        Content="Load Filters"
                                        Style="{StaticResource BaPrimaryButton}"
                                        Command="{Binding LoadFiltersCommand}"
                                        ToolTip="Load this template's filters into the two panes below"
                                        Margin="0,0,8,0"/>

                                <Button Grid.Column="2"
                                        Content="Reload Templates"
                                        Style="{StaticResource BaSecondaryButton}"
                                        Command="{Binding LoadTemplatesCommand}"
                                        ToolTip="Refresh the list of view templates from the model"/>
                            </Grid>

                            <!-- Row 1: saved scheme picker -->
                            <Border Grid.Row="1"
                                    Margin="0,0,0,10"
                                    BorderBrush="{StaticResource VfBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Saved Color Scheme"
                                               Foreground="{StaticResource VfMuted}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,4"/>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  Style="{StaticResource BaDarkComboBox}"
                                                  ItemsSource="{Binding SavedSchemes}"
                                                  SelectedItem="{Binding SelectedSavedScheme}"
                                                  DisplayMemberPath="SchemeName"
                                                  ToolTip="A named color scheme saved from the Parameter Colors tab"/>

                                        <Button Grid.Column="2"
                                                Content="Apply Scheme to Template"
                                                Style="{StaticResource BaPrimaryButton}"
                                                Command="{Binding AddSchemeToTemplateCommand}"
                                                ToolTip="Generate BA managed filters on the selected template from this saved scheme"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Row 2: split pane, native filters left, BA managed filters right -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource VfCard2}"
                                        BorderBrush="{StaticResource VfBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="Native Revit Filters"
                                                   Foreground="{StaticResource VfText}"
                                                   FontWeight="SemiBold"
                                                   ToolTip="Filters that already exist on this template through Revit's own V/G Overrides dialog"
                                                   Margin="2,0,0,6"/>
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding NativeFilterRows}"
                                                  SelectedItem="{Binding SelectedNativeFilterRow}"
                                                  Style="{StaticResource VfDataGridStyle}"
                                                  ColumnHeaderStyle="{StaticResource VfHeaderStyle}"
                                                  RowStyle="{StaticResource VfRowStyle}"
                                                  CellStyle="{StaticResource VfCellStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Legend" Width="55" IsReadOnly="True"
                                                                         CellTemplate="{StaticResource VfLegendCheckTemplate}"/>
                                                <DataGridTextColumn Header="Filter Name" Binding="{Binding FilterName}" Width="*"/>
                                                <DataGridTextColumn Header="Category" Binding="{Binding CategorySummary}" Width="150"/>
                                                <DataGridTextColumn Header="Visible" Binding="{Binding VisibleText}" Width="60"/>
                                                <DataGridTemplateColumn Header="Cut" Width="50" IsReadOnly="True"
                                                                         CellTemplate="{StaticResource VfCutSwatchTemplate}"/>
                                                <DataGridTemplateColumn Header="Proj" Width="50" IsReadOnly="True"
                                                                         CellTemplate="{StaticResource VfProjSwatchTemplate}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <GridSplitter Grid.Column="1"
                                              Width="6"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Background="{StaticResource VfBorder}"
                                              ShowsPreview="True"/>

                                <Border Grid.Column="2"
                                        Background="{StaticResource VfCard2}"
                                        BorderBrush="{StaticResource VfBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="BA Managed Filters"
                                                   Foreground="{StaticResource VfText}"
                                                   FontWeight="SemiBold"
                                                   ToolTip="Filters created by BA Tools, either from Create View Filters or Apply Scheme to Template"
                                                   Margin="2,0,0,6"/>

                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding BaManagedFilterRows}"
                                                  SelectedItem="{Binding SelectedBaManagedFilterRow}"
                                                  Style="{StaticResource VfDataGridStyle}"
                                                  ColumnHeaderStyle="{StaticResource VfHeaderStyle}"
                                                  RowStyle="{StaticResource VfRowStyle}"
                                                  CellStyle="{StaticResource VfCellStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Legend" Width="55" IsReadOnly="True"
                                                                         CellTemplate="{StaticResource VfLegendCheckTemplate}"/>
                                                <DataGridTextColumn Header="Filter Name" Binding="{Binding FilterName}" Width="*"/>
                                                <DataGridTextColumn Header="Category" Binding="{Binding CategorySummary}" Width="150"/>
                                                <DataGridTextColumn Header="Visible" Binding="{Binding VisibleText}" Width="60"/>
                                                <DataGridTemplateColumn Header="Cut" Width="50" IsReadOnly="True"
                                                                         CellTemplate="{StaticResource VfCutSwatchTemplate}"/>
                                                <DataGridTemplateColumn Header="Proj" Width="50" IsReadOnly="True"
                                                                         CellTemplate="{StaticResource VfProjSwatchTemplate}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Row 3: actions on whatever is checked above -->
                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Selected Filter Actions"
                                           Foreground="{StaticResource VfMuted}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,4"/>

                                <WrapPanel Grid.Row="1">
                                    <Button Content="Preview Selected Filter"
                                            Style="{StaticResource BaSecondaryButton}"
                                            Command="{Binding PreviewFilterCommand}"
                                            ToolTip="Show details for the single filter currently highlighted in either pane"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Create Legend From Selected"
                                            Style="{StaticResource BaPrimaryButton}"
                                            Command="{Binding CreateLegendFromSelectedCommand}"
                                            ToolTip="Build a legend from every filter checked in the Legend column, native or BA managed"/>
                                </WrapPanel>
                            </Grid>

                            <!-- Row 4: combined filter groups, built from whatever is checked above -->
                            <Border Grid.Row="4"
                                    Margin="0,10,0,0"
                                    Background="{StaticResource VfCard2}"
                                    BorderBrush="{StaticResource VfBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Combined Filter Groups"
                                               Foreground="{StaticResource VfText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,2"/>

                                    <TextBlock Grid.Row="1"
                                               Text="Check filters above, name the group, and save it. Show/Hide toggles that group's filters on the current template, from any view."
                                               Foreground="{StaticResource VfMuted}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource BaDarkTextBox}"
                                                 Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Group name for the checked filters above..."
                                                 ToolTip="Name for the new combined filter group"/>

                                        <Button Grid.Column="2"
                                                Content="Save Group From Selected"
                                                Style="{StaticResource BaPrimaryButton}"
                                                Command="{Binding SaveGroupFromSelectedCommand}"
                                                ToolTip="Save every filter checked in the Legend column, native or BA managed, as a named group"/>
                                    </Grid>

                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  Style="{StaticResource BaDarkComboBox}"
                                                  ItemsSource="{Binding FilterGroups}"
                                                  SelectedItem="{Binding SelectedFilterGroup}"
                                                  DisplayMemberPath="GroupName"
                                                  ToolTip="A previously saved combined filter group"/>

                                        <Button Grid.Column="2"
                                                Content="Show on Template"
                                                Style="{StaticResource BaSecondaryButton}"
                                                Command="{Binding ShowGroupOnTemplateCommand}"
                                                ToolTip="Turn on every filter in this group that exists on the selected template"/>

                                        <Button Grid.Column="4"
                                                Content="Hide on Template"
                                                Style="{StaticResource BaSecondaryButton}"
                                                Command="{Binding HideGroupOnTemplateCommand}"
                                                ToolTip="Turn off every filter in this group that exists on the selected template"/>

                                        <Button Grid.Column="6"
                                                Content="Create Legend From Group"
                                                Style="{StaticResource BaPrimaryButton}"
                                                Command="{Binding CreateLegendFromGroupCommand}"
                                                ToolTip="Build a legend from this group's filters, using their live colors on the selected template"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Parameter Colors">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource BaDarkComboBox}"
                                          ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding SelectedCategory}"
                                          DisplayMemberPath="Name"
                                          ToolTip="Category to build a color rule for"
                                          Margin="0,0,8,0"/>

                                <Button Grid.Column="1"
                                        Content="Load Categories"
                                        Style="{StaticResource BaSecondaryButton}"
                                        Command="{Binding LoadCategoriesCommand}"
                                        ToolTip="Refresh the list of filterable categories from the model"
                                        Margin="0,0,8,0"/>

                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource BaDarkComboBox}"
                                          ItemsSource="{Binding Parameters}"
                                          SelectedItem="{Binding SelectedParameter}"
                                          DisplayMemberPath="Name"
                                          ToolTip="Parameter to color-code elements by"/>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton Content="Value"
                                         Style="{StaticResource BaRadioButton}"
                                         IsChecked="{Binding IsValueMethod}"
                                         GroupName="ProcessMethod"
                                         ToolTip="One bucket per distinct parameter value found in the model"/>
                                <RadioButton Content="Range"
                                         Style="{StaticResource BaRadioButton}"
                                         IsChecked="{Binding IsRangeMethod}"
                                         GroupName="ProcessMethod"
                                         ToolTip="Numeric parameters only, buckets by value range"
                                         Margin="16,0,0,0"/>
                                <CheckBox Content="Scope to Active View"
                                      Style="{StaticResource BaDarkPanelCheckBox}"
                                      IsChecked="{Binding ScopeBucketsToActiveView}"
                                      ToolTip="On: only scans elements visible in the current view. Off: scans the whole model."
                                      Margin="24,0,0,0"
                                      VerticalAlignment="Center"/>
                            </StackPanel>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding Buckets}"
                                      Style="{StaticResource VfDataGridStyle}"
                                      IsReadOnly="False"
                                      ColumnHeaderStyle="{StaticResource VfHeaderStyle}"
                                      RowStyle="{StaticResource VfRowStyle}"
                                      CellStyle="{StaticResource VfCellStyle}">
                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="Color" Width="60" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="34" Height="24"
                                                        ToolTip="Click to change this bucket's color"
                                                        Command="{Binding DataContext.EditBucketColorCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border x:Name="Swatch"
                                                                    CornerRadius="4"
                                                                    BorderBrush="{StaticResource VfBorder}"
                                                                    BorderThickness="1"
                                                                    Background="{Binding Swatch}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Swatch" Property="BorderBrush" Value="{StaticResource Brush.SelectedBorder}"/>
                                                                    <Setter TargetName="Swatch" Property="BorderThickness" Value="2"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>


                                    <DataGridTemplateColumn Header="Pattern" Width="120" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource BaDarkComboBox}"
                                                  ItemsSource="{Binding DataContext.Patterns,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding SelectedPattern}"
                                                  DisplayMemberPath="Name"
                                                  Height="26"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="140"/>
                                    <DataGridTextColumn Header="Range Min" Binding="{Binding RangeMin}" Width="90"/>
                                    <DataGridTextColumn Header="Range Max" Binding="{Binding RangeMax}" Width="90"/>

                                    <DataGridTemplateColumn Header="" Width="70" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove"
                                                        Style="{StaticResource BaSecondaryButton}"
                                                        Height="24"
                                                        FontSize="10"
                                                        ToolTip="Remove this bucket"
                                                        Command="{Binding DataContext.RemoveBucketCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource BaDarkTextBox}"
                                             Text="{Binding NewSchemeName, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Scheme name to save as..."
                                             ToolTip="Name to save this bucket configuration under"/>

                                    <ComboBox Grid.Column="2"
                                              Style="{StaticResource BaDarkComboBox}"
                                              ItemsSource="{Binding SavedSchemes}"
                                              SelectedItem="{Binding SelectedSavedScheme}"
                                              DisplayMemberPath="SchemeName"
                                              ToolTip="A previously saved color scheme"/>
                                </Grid>

                                <WrapPanel Grid.Row="1">
                                    <Button Content="Add Bucket"
                                            Style="{StaticResource BaSecondaryButton}"
                                            Command="{Binding AddBucketCommand}"
                                            ToolTip="Add a manual bucket not derived from the model"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Random Colors"
                                            Style="{StaticResource BaSecondaryButton}"
                                            Command="{Binding RandomColorsCommand}"
                                            ToolTip="Reassign distinct random colors to every bucket"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Gradient"
                                            Style="{StaticResource BaSecondaryButton}"
                                            Command="{Binding GradientCommand}"
                                            ToolTip="Blend colors from the first to the last bucket"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Save Scheme"
                                            Style="{StaticResource BaSecondaryButton}"
                                            Command="{Binding SaveSchemeCommand}"
                                            ToolTip="Save this bucket configuration to the named scheme library"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Load Scheme"
                                            Style="{StaticResource BaSecondaryButton}"
                                            Command="{Binding LoadSchemeCommand}"
                                            ToolTip="Load the selected saved scheme into the bucket editor"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Create View Filters"
                                            Style="{StaticResource BaPrimaryButton}"
                                            Command="{Binding CreateViewFiltersCommand}"
                                            ToolTip="Generate real Revit filters on the selected template from these buckets"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Create Legend"
                                            Style="{StaticResource BaPrimaryButton}"
                                            Command="{Binding CreateLegendCommand}"
                                            ToolTip="Create a legend view directly from these buckets"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Apply to Selection"
                                            Style="{StaticResource BaPrimaryButton}"
                                            Command="{Binding ApplyToSelectionCommand}"
                                            ToolTip="Apply these colors as element overrides to the current selection in the active view"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Apply to All in View"
                                            Style="{StaticResource BaPrimaryButton}"
                                            Command="{Binding ApplyToAllInViewCommand}"
                                            ToolTip="Apply these colors as element overrides to every matching element visible in the active view"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Tip: View Template > Load Filters > pick native or BA managed filters > Apply. Check filters and save them as a group to toggle a combined filter on and off across different views."
                       Foreground="{StaticResource VfMuted}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Apply"
                        Style="{StaticResource BaPrimaryButton}"
                        Command="{Binding ApplyToTemplateCommand}"
                        ToolTip="Write all Cut/Projection color changes shown in either pane to the selected template"
                        MinWidth="110"
                        Margin="0,0,8,0"/>
                <Button Content="Close"
                        Style="{StaticResource BaSecondaryButton}"
                        Command="{Binding CloseCommand}"
                        MinWidth="110"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                BorderBrush="{StaticResource VfBorder}"
                BorderThickness="0,1,0,0"
                Padding="2,10,2,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource VfMuted}"
                       FontSize="12"/>
        </Border>

    </Grid>
</Window>