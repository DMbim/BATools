<Window x:Class="BA.UI.Rooms.AreaTransferSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Area Transfer Settings"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Background" Value="#161B22"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="Padding" Value="6,3"/>
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="#2C3440"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DarkComboStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="#161B22"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"
                                                                      Margin="6,4"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center"/>
                                                    <Path Grid.Column="1"
                                                          Data="M0,0 L4,4 L8,0"
                                                          Stroke="#A0A8B4"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="8,4,28,4"
                                                  VerticalAlignment="Center"/>
                                <TextBox x:Name="PART_EditableTextBox"
                                         Visibility="Hidden"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         Margin="6,4,28,4"
                                         Background="Transparent"
                                         Foreground="#F2F2F2"
                                         CaretBrush="#F2F2F2"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"/>
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border Background="#161B22"
                                                BorderBrush="#2C3440"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <ScrollViewer>
                                                <StackPanel IsItemsHost="True"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1A1A1D"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#222226"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#17171A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Room Number Parameter (String):" Foreground="#A0A8B4" Margin="0,0,0,4"/>
        <ComboBox x:Name="RoomNumberParamBox" Grid.Row="1"
                  Style="{StaticResource DarkComboStyle}"
                  Margin="0,0,0,10" MaxDropDownHeight="200"/>

        <TextBlock Grid.Row="2" Text="Area Number Parameter (String):" Foreground="#A0A8B4" Margin="0,0,0,4"/>
        <ComboBox x:Name="AreaNumberParamBox" Grid.Row="3"
                  Style="{StaticResource DarkComboStyle}"
                  Margin="0,0,0,10" MaxDropDownHeight="200"/>

        <TextBlock Grid.Row="4" Text="Area Type Parameter (String):" Foreground="#A0A8B4" Margin="0,0,0,4"/>
        <ComboBox x:Name="AreaTypeParamBox" Grid.Row="5"
                  Style="{StaticResource DarkComboStyle}"
                  Margin="0,0,0,10" MaxDropDownHeight="200"
                  SelectionChanged="AreaTypeParamBox_SelectionChanged"/>

        <TextBlock Grid.Row="6" Text="Room Area UP Parameter (Double write target):" Foreground="#A0A8B4" Margin="0,0,0,4"/>
        <ComboBox x:Name="RoomAreaUpParamBox" Grid.Row="7"
                  Style="{StaticResource DarkComboStyle}"
                  Margin="0,0,0,10" MaxDropDownHeight="200"/>

        <TextBlock Grid.Row="8" Text="Room Area PP Parameter (Double write target):" Foreground="#A0A8B4" Margin="0,0,0,4"/>
        <ComboBox x:Name="RoomAreaPpParamBox" Grid.Row="9"
                  Style="{StaticResource DarkComboStyle}"
                  Margin="0,0,0,10" MaxDropDownHeight="200"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                <TextBlock Text="UP value:" Foreground="#A0A8B4" Margin="0,0,0,4"/>
                <ComboBox x:Name="AreaTypeUpValueBox"
                          Style="{StaticResource DarkComboStyle}"
                          IsEditable="True" Width="180"
                          MaxDropDownHeight="160"/>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="PP value:" Foreground="#A0A8B4" Margin="0,0,0,4"/>
                <ComboBox x:Name="AreaTypePpValueBox"
                          Style="{StaticResource DarkComboStyle}"
                          IsEditable="True" Width="180"
                          MaxDropDownHeight="160"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="12"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0"
                    Content="OK"
                    IsDefault="True"
                    Style="{StaticResource DarkButtonStyle}"
                    Click="OkButton_Click"/>
            <Button Width="90"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource DarkButtonStyle}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>