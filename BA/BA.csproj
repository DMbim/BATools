<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<Configurations>;Debug R26</Configurations>
		<Configurations>$(Configurations);Release R26</Configurations>
		<RootNamespace>BA.UI</RootNamespace>
	</PropertyGroup>


	<PropertyGroup Condition="$(Configuration.Contains('R26'))">
		<RevitVersion>2026</RevitVersion>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>

	<PropertyGroup>
		<StartAction>Program</StartAction>
		<StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
		<StartArguments>/language ENG</StartArguments>
		<IsRepackable>false</IsRepackable>
		<DeployRevitAddin>true</DeployRevitAddin>
	</PropertyGroup>

	<!-- RevitAPIIFC — jedna reference, správná cesta -->
	<ItemGroup>
		<Reference Include="RevitAPIIFC">
			<HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPIIFC.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<!-- NuGet packages — jeden blok -->
	<ItemGroup>
		<PackageReference Include="Clipper2" Version="2.0.0" />
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Nice3point.Revit.Build.Tasks" Version="3.0.1" />
		<PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Extensions" Version="2026.0.2-preview.1.20251113" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	<!-- Compile excludes -->
	<ItemGroup>
		<Compile Remove="Keyplan\New\**" />
		<Compile Remove="Keyplan\Update\**" />
		<Compile Remove="Keyplan\Utils§\**" />
		<Compile Remove="Commands\Anno\Cmd_GenerateKeyplanDraftingView .cs" />
		<Compile Remove="Commands\Anno\Cmd_UpdateKeyplansOnSheets.CS" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Remove="Keyplan\New\**" />
		<EmbeddedResource Remove="Keyplan\Update\**" />
		<EmbeddedResource Remove="Keyplan\Utils§\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Keyplan\New\**" />
		<None Remove="Keyplan\Update\**" />
		<None Remove="Keyplan\Utils§\**" />
		<!-- ... zbytek None Remove beze změny ... -->
	</ItemGroup>

	<ItemGroup>
		<Page Remove="Keyplan\New\**" />
		<Page Remove="Keyplan\Update\**" />
		<Page Remove="Keyplan\Utils§\**" />
	</ItemGroup>

	<!-- Resources — beze změny, ponech jak máš -->
	<ItemGroup>
		<!-- ... všechny Resource Include beze změny ... -->
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Models" />
		<Folder Include="Bridge\" />
		<Folder Include="NewFolder\" />
		<Folder Include="ViewModels\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Ribbon\RibbonExtensions.cs">
			<Generator>MSBuild:Compile</Generator>
		</Compile>
	</ItemGroup>

</Project>