<Window x:Class="BA.QA.FamilyVersioning.Dashboard.CoordinationDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BA.QA.FamilyVersioning.Converters"
        Title="BA Tools - Family Versioning Dashboard"
        Height="820" Width="1100"
        MinHeight="540" MinWidth="700"
        ResizeMode="CanResizeWithGrip"
        Background="#FF1E1E1E"
        Foreground="#FFE0E0E0">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3E3E42" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashboardGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FF1E1E1E" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="#FF252526" />
            <Setter Property="AlternatingRowBackground" Value="#FF2A2A2B" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FF3F3F46" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMismatch}" Value="True">
                    <Setter Property="Background" Value="#3D9B2335" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" MinHeight="100" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header row -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Family Versioning Dashboard"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock Text="{Binding StatusSummary}"
                           Foreground="#FF808080" FontSize="11" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Review Selected"
                        Command="{Binding ReviewFamilyCommand}"
                        ToolTip="Creates a temporary 3D view in the coordination model for each building link, with a section box around the first instance of the selected family. Views are coloured per building for easy visual comparison. All created views are deleted when the dashboard is closed." />
                <Button Content="Set Canonical"
                        Command="{Binding PromoteToCanonicalCommand}"
                        ToolTip="Promotes the selected family's current version to the office-standard canonical version. All non-excepted buildings must have the same version loaded before this action is available. Once set, the Canonical column reflects this version and it becomes the baseline for future drift detection." />
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        ToolTip="Reload all family and building state data from the catalog database. Use after another team member has confirmed or overridden a family version in their session." />
                <Button Content="Close" Command="{Binding CloseCommand}" Margin="0"
                        ToolTip="Close the dashboard. Any temporary review views created during this session will be deleted from the coordination model." />
            </StackPanel>
        </Grid>

        <!-- Filter row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox IsChecked="{Binding ShowMismatchesOnly}"
                      Content="Show mismatches only"
                      Margin="0,0,16,0"
                      ToolTip="When checked, only families where at least two non-excepted buildings have different versions are shown. Uncheck to see all tracked families including those that are consistent." />
            <TextBlock Text="{Binding MismatchCount, StringFormat='{}{0} mismatch(es) found'}"
                       Foreground="#FFCE9178" VerticalAlignment="Center"
                       Visibility="{Binding ShowMismatchesOnly,
                           Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- Family grid with context menu -->
        <DataGrid x:Name="FamilyGrid"
                  Grid.Row="2"
                  Style="{StaticResource DashboardGridStyle}"
                  ItemsSource="{Binding VisibleRows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Review Selected Family"
                              Command="{Binding ReviewFamilyCommand}"
                              ToolTip="Create temporary 3D review views per building link with section boxes around this family." />
                    <MenuItem Header="Set as Canonical Version"
                              Command="{Binding PromoteToCanonicalCommand}"
                              ToolTip="Promote the current agreed version of this family to the office canonical standard." />
                    <Separator />
                    <MenuItem Header="Refresh"
                              Command="{Binding RefreshCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Family" Width="200"
                                    Binding="{Binding FamilyName}" />
                <DataGridTextColumn Header="Category" Width="140"
                                    Binding="{Binding CategoryName}" />
                <DataGridTextColumn Width="90"
                                    Binding="{Binding CanonicalVersion}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Canonical"
                                   ToolTip="The office-standard version designated by a BIM lead. Shown for reference; mismatch detection compares per-building versions against each other, not against canonical. Use 'Set Canonical' to update this." />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Splitter -->
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                      Background="#FF3F3F46" Margin="0,4" />

        <!-- Audit history panel -->
        <Grid Grid.Row="4"
              Visibility="{Binding HasAuditHistory,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding AuditHistoryTitle}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="#FF808080" Margin="0,0,0,4"
                       ToolTip="Complete audit history for the selected family across all buildings, most recent first. Hover over the Comment cell for individual entries to see the full structural diff." />

            <DataGrid Grid.Row="1"
                      Style="{StaticResource DashboardGridStyle}"
                      ItemsSource="{Binding AuditHistory}"
                      FontSize="11">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Building" Width="100"
                                        Binding="{Binding BuildingName}" />
                    <DataGridTextColumn Header="Event" Width="110"
                                        Binding="{Binding EventType}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="Confirmed: user accepted the version. Overridden: user changed the suggested version. ExceptionMarked: user flagged this as an approved variant. Detected: dialog was dismissed without confirming." />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="By" Width="100"
                                        Binding="{Binding EventUser}" />
                    <DataGridTextColumn Header="When" Width="130"
                                        Binding="{Binding EventLocalTimeDisplay}" />
                    <DataGridTextColumn Header="Comment" Width="*"
                                        Binding="{Binding Comment}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Foreground" Value="#FFCECECE" />
                                <Setter Property="ToolTip" Value="{Binding DiffSummary}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="User comment entered in the confirmation dialog. Hover over any row to see the full structural diff (types added/removed, parameters changed) in the tooltip." />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status message -->
        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   Foreground="#FFCE9178"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasStatusMessage,
                       Converter={StaticResource BoolToVisibilityConverter}}"
                   Margin="0,6,0,0" />
    </Grid>
</Window>
