<Window x:Class="BA.QA.FamilyVersioning.Views.FamilyVersioningConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BA.QA.FamilyVersioning.Converters"
        Title="BA Tools - Family Change Detected"
        Height="540" Width="640"
        MinHeight="440" MinWidth="500"
        ResizeMode="CanResizeWithGrip"
        Background="#FF1E1E1E"
        Foreground="#FFE0E0E0">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF252526" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,3" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3E3E42" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Family Change Detected"
                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"
                       ToolTip="A family was loaded or reloaded into this building model. Review the changes below and confirm the version to record in the catalog." />
            <TextBlock>
                <Run Text="{Binding FamilyName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text=" · " Foreground="#FF808080" />
                <Run Text="{Binding CategoryName, Mode=OneWay}" Foreground="#FF808080" />
                <Run Text=" · " Foreground="#FF808080" />
                <Run Text="{Binding BuildingName, Mode=OneWay}" Foreground="#FF808080" />
            </TextBlock>
        </StackPanel>

        <!-- Bump kind badge -->
        <Border Grid.Row="1" Margin="0,0,0,10" Padding="8,4"
                HorizontalAlignment="Left" CornerRadius="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FF2D6A4F" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBreaking}" Value="True">
                            <Setter Property="Background" Value="#FF9B2335" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal"
                        ToolTip="MAJOR: breaking change (type removed, parameter removed or changed). MINOR: additive change (new type or parameter). PATCH: cosmetic change (parameter group reassignment only). UNKNOWN: no structural difference detected, likely the same version reloaded.">
                <TextBlock Text="{Binding InferredBumpLabel}"
                           FontWeight="SemiBold" FontSize="11" Foreground="White" />
                <TextBlock Text=" CHANGE" FontSize="11" Foreground="White" />
                <TextBlock Text="  ·  " Foreground="#AAFFFFFF" FontSize="11" />
                <TextBlock Text="{Binding CurrentVersion, StringFormat='was {0}'}"
                           FontSize="11" Foreground="#CCFFFFFF" />
                <TextBlock Text="  →  " Foreground="#AAFFFFFF" FontSize="11" />
                <TextBlock Text="{Binding FinalVersion, StringFormat='suggested {0}'}"
                           FontSize="11" Foreground="#CCFFFFFF" />
            </StackPanel>
        </Border>

        <!-- Diff summary -->
        <Border Grid.Row="2" Background="#FF1A1A1B" BorderBrush="#FF3F3F46"
                BorderThickness="1" CornerRadius="3" Margin="0,0,0,10" Padding="8"
                ToolTip="Structural changes detected in this family load: types added or removed, shared parameters added, removed, or modified. This is generated automatically and does not include your comment.">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding DiffSummary}"
                           FontFamily="Consolas" FontSize="11"
                           TextWrapping="Wrap" Foreground="#FFCECECE" />
            </ScrollViewer>
        </Border>

        <!-- Version override -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Version to record:"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="The version string that will be saved to the catalog for this family in this building. Format: MAJOR.MINOR.PATCH. MAJOR is incremented for breaking changes (removed types/parameters), MINOR for additive changes (new types/parameters), PATCH for cosmetic changes. You can override the suggested value." />
            <TextBox Grid.Column="1" Text="{Binding FinalVersion, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="MAJOR.MINOR.PATCH format required. Edit to override the suggested version." />
            <TextBlock Grid.Column="2"
                       Text="(overridden)" Foreground="#FFE5C07B"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Visibility="{Binding Overridden, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <!-- Comment -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Comment (optional):"
                       VerticalAlignment="Top" Margin="0,4,8,0"
                       ToolTip="Your comment explaining the reason for this load or the nature of the change. Stored separately from the structural diff and visible in the dashboard audit history panel." />
            <TextBox Grid.Column="1" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="52" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <!-- Options -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <CheckBox IsChecked="{Binding MarkedAsException}"
                      ToolTip="Mark this family as an approved intentional variant for this specific building. Future loads of this family in this building will be auto-confirmed without showing this dialog. The exception is visible in the dashboard with an asterisk (*) and can be revoked at any time. Use this when a family legitimately differs between buildings (e.g. different fire rating, different size standard).">
                <TextBlock Text="Mark as intentional variant for this building (suppress future alerts here)"
                           TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox IsChecked="{Binding SetAsCanonical}"
                      ToolTip="Designates this version as the office-standard canonical version. Use this when you are the BIM lead and this load represents the agreed correct state that all buildings should match. The Canonical column in the dashboard will update to reflect this version.">
                <TextBlock Text="Set this as the canonical office-standard version (BIM lead only)"
                           TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>

        <!-- Action buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Dismiss" Command="{Binding DismissCommand}"
                    Margin="0,0,8,0"
                    ToolTip="Dismiss without recording. The family state in the catalog is NOT updated. The next time this family is loaded, this dialog will appear again." />
            <Button Content="Confirm" Command="{Binding ConfirmCommand}"
                    Background="#FF0E639C" BorderBrush="#FF1177BB"
                    ToolTip="Record the version shown above in the catalog for this family in this building. If no structural changes were detected, confirming simply re-stamps the current version with a new audit entry." />
        </StackPanel>
    </Grid>
</Window>
