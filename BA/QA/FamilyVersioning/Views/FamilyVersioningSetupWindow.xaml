<Window x:Class="BA.QA.FamilyVersioning.Views.FamilyVersioningSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BA.QA.FamilyVersioning.Converters"
        Title="BA Tools - Family Versioning Setup"
        Height="580" Width="860"
        MinHeight="460" MinWidth="660"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E"
        Foreground="#FFE0E0E0">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:EnabledToToggleLabelConverter x:Key="EnabledToToggleLabelConverter" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3E3E42" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF252526" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SetupGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FF252526" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="RowBackground" Value="#FF252526" />
            <Setter Property="AlternatingRowBackground" Value="#FF2A2A2B" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FF3F3F46" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Catalog database location -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Catalog database:" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Path to the SQLite catalog file (.db) that stores version history for this project. All building models in the project share one catalog file, typically stored on the shared drive alongside the .rvt files." />
            <TextBox Grid.Column="1" Text="{Binding CatalogDatabasePath, Mode=OneWay}"
                     IsReadOnly="True" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseCatalogDatabasePathCommand}"
                    Margin="8,0,0,0"
                    ToolTip="Select an existing catalog or create a new one. The path is saved next to the active .rvt file and used by all team members who open this model." />
        </Grid>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="#FF1E1E1E" BorderBrush="#FF3F3F46">

            <!-- Buildings tab -->
            <TabItem Header="Buildings"
                     ToolTip="Configure which central model files are registered as buildings in this project. Each building must have a unique name and the correct path to its central .rvt file.">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" Style="{StaticResource SetupGridStyle}"
                              ItemsSource="{Binding Buildings}"
                              SelectedItem="{Binding SelectedBuilding, Mode=TwoWay}"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Building Name" Width="180"
                                                Binding="{Binding BuildingName, UpdateSourceTrigger=PropertyChanged}"
                                                HeaderStyle="{StaticResource {x:Type DataGridColumnHeader}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFE0E0E0" />
                                        <Setter Property="ToolTip" Value="Unique display name for this building. Used as a column header in the coordination dashboard." />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Central Model Path" Width="*"
                                                Binding="{Binding CentralModelPath, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFE0E0E0" />
                                        <Setter Property="ToolTip" Value="Full path to this building's central .rvt file on the shared server. Must be the central file path, not a local copy. Used by the detection hook to identify which building a session belongs to." />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Enabled" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  IsHitTestVisible="False"
                                                  HorizontalAlignment="Center" Margin="0,4"
                                                  ToolTip="When disabled, this building is excluded from detection but its history is preserved. Re-enable at any time." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="NEW" Foreground="#FFE5C07B" FontWeight="SemiBold"
                                                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   VerticalAlignment="Center" Margin="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="Add Building" Command="{Binding AddBuildingCommand}"
                                ToolTip="Add a new building row. Set the name and central model path, then click Save." />
                        <Button Content="Browse Path..." Command="{Binding BrowseCentralModelPathCommand}"
                                ToolTip="Browse for the selected building's central .rvt file." />
                        <Button Content="Save" Command="{Binding SaveBuildingCommand}"
                                ToolTip="Persist name and path changes for the selected building to the catalog." />
                        <Button Content="{Binding SelectedBuilding.Enabled, Converter={StaticResource EnabledToToggleLabelConverter}}"
                                Command="{Binding ToggleEnabledCommand}"
                                ToolTip="Enable or disable the selected building. Disabled buildings are excluded from detection; history is preserved." />
                        <Button Content="Remove Unsaved Row" Command="{Binding DeleteBuildingCommand}"
                                ToolTip="Remove this row before it has been saved. Only available for rows not yet persisted to the catalog." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Categories tab -->
            <TabItem Header="Tracked Categories"
                     ToolTip="Control which Revit family categories trigger version detection. Families outside the tracked category list are silently ignored. If no categories are configured, all categories are tracked.">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Currently tracked -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Currently tracked"
                                       FontWeight="SemiBold" Margin="0,0,0,4"
                                       ToolTip="Families in these categories will trigger the version detection dialog when loaded into a registered building model." />

                            <DataGrid Grid.Row="1" Style="{StaticResource SetupGridStyle}"
                                      ItemsSource="{Binding TrackedCategories}"
                                      SelectedItem="{Binding SelectedTrackedCategory, Mode=TwoWay}"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Width="*"
                                                        Binding="{Binding CategoryLabel}" />
                                    <DataGridTemplateColumn Header="Active" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          IsHitTestVisible="False"
                                                          HorizontalAlignment="Center" Margin="0,4"
                                                          ToolTip="Uncheck to temporarily pause detection for this category without removing it." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Arrows column -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                            <Button Content="Add" Command="{Binding AddSelectedCategoryCommand}"
                                    Margin="0,0,0,8" Width="60"
                                    ToolTip="Add the selected available category to the tracked list." />
                            <Button Content="Remove" Command="{Binding RemoveCategoryCommand}"
                                    Width="60"
                                    ToolTip="Remove the selected tracked category. Families in this category will no longer trigger detection." />
                        </StackPanel>

                        <!-- Available to add -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Available to add"
                                       FontWeight="SemiBold" Margin="0,0,0,4"
                                       ToolTip="Revit model categories not currently tracked. Select one and click Add to start tracking families in that category." />

                            <DataGrid Grid.Row="1" Style="{StaticResource SetupGridStyle}"
                                      ItemsSource="{Binding AvailableCategories}"
                                      SelectedItem="{Binding SelectedAvailableCategory, Mode=TwoWay}"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Width="*"
                                                        Binding="{Binding Label}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <!-- Category action buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{Binding SelectedTrackedCategory.Enabled, Converter={StaticResource EnabledToToggleLabelConverter}}"
                                Command="{Binding ToggleCategoryEnabledCommand}"
                                ToolTip="Temporarily pause or resume detection for the selected category without removing it from the tracked list." />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status message -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="#FFCE9178"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                   Margin="0,8,0,8" />

        <!-- Close -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Command="{Binding CloseCommand}" MinWidth="80" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
