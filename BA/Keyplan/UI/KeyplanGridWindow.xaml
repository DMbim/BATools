<Window x:Class="BA.UI.KeyplanGrid.KeyplanGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BA.UI.KeyplanGrid"
        Title="BA Keyplan Grid Generator"
        Width="1480"
        Height="900"
        MinWidth="1280"
        MinHeight="780"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPanel" Color="#11161F"/>
        <SolidColorBrush x:Key="BgInput" Color="#0F141C"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#2A3442"/>
        <SolidColorBrush x:Key="FgMain" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="FgMuted" Color="#B7C0CD"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A2330"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="#11161F"/>
            <Setter Property="AlternatingRowBackground" Value="#141A24"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,10,10">
            <local:KeyplanInteractiveCanvas x:Name="PreviewCanvas"/>
        </Border>

        <ScrollViewer Grid.Column="1"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,10">
            <StackPanel>
                <Border Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="General" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Source View"/>
                        <TextBox Text="{Binding SourceViewName}" IsReadOnly="True"/>
                        <TextBlock Text="Target Drafting View"/>
                        <TextBox Text="{Binding TargetDraftingViewName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Target View Template"/>
                        <TextBox Text="{Binding TargetViewTemplateName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Filled Region Type"/>
                        <TextBox Text="{Binding FilledRegionTypeName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Grid" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="X Divisions"
                                     Margin="0,4,0,4"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="-"
                                    Click="BtnXDivisionMinus_Click"/>

                            <TextBox Grid.Column="1"
                                     Margin="6,0,6,0"
                                     Text="{Binding XDivisionCount, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Column="2"
                                    Content="+"
                                    Click="BtnXDivisionPlus_Click"/>
                        </Grid>

                        <TextBlock Text="Y Divisions"
                                    Margin="0,4,0,4"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                Content="-"
                                Click="BtnYDivisionMinus_Click"/>

                            <TextBox Grid.Column="1"
                                 Margin="6,0,6,0"
                                 Text="{Binding YDivisionCount, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Column="2"
                                Content="+"
                                Click="BtnYDivisionPlus_Click"/>
                        </Grid>

                        <CheckBox Content="Clear target view first" IsChecked="{Binding ClearTargetViewFirst}"/>
                        <CheckBox Content="Copy source view-specific elements" IsChecked="{Binding CopySourceViewSpecificElements}"/>
                        <CheckBox Content="Draw grid lines" IsChecked="{Binding DrawGridLines}"/>
                        <CheckBox Content="Create filled regions" IsChecked="{Binding CreateFilledRegions}"/>
                    </StackPanel>
                </Border>

                <Border>
                    <StackPanel>
                        <TextBlock Text="Filled Regions" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Fill Mode"
                        Margin="0,8,0,4"/>

                        <ComboBox ItemsSource="{Binding FillModeValues}"
                          SelectedItem="{Binding FillMode}"
                          Margin="0,0,0,8"/>

                        <TextBlock Text="Minimum Occupancy Ratio"
                        Margin="0,4,0,4"/>

                        <TextBox Text="{Binding MinimumOccupancyRatio, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,8"/>

                        <CheckBox Content="Draw outline"
                          IsChecked="{Binding DrawOutline}"
                          Margin="0,4,0,0"/>

                        <CheckBox Content="Use outline as primary fill"
                                  IsChecked="{Binding UseOutlineAsPrimaryFill}"
                                  Margin="0,4,0,8"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Exclude selected"
            Width="120"
            Margin="0,0,8,0"
            Click="BtnExcludeSelected_Click"/>

                    <Button Content="Include selected"
            Width="120"
            Margin="0,0,8,0"
            Click="BtnIncludeSelected_Click"/>

                    <Button Content="Include all"
            Width="100"
            Margin="0,0,8,0"
            Click="BtnIncludeAll_Click"/>

                    <Button Content="Clear selection"
            Width="110"
            Click="BtnClearSelection_Click"/>
                </StackPanel>
                <Border Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel/>
                </Border>

                <Border Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        Padding="10">
                    <StackPanel/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="1"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                Padding="10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Refresh Preview" Click="BtnRefreshPreview_Click"/>
                    <Button Content="Generate" Click="BtnGenerate_Click"/>
                    <Button Content="Cancel" Click="BtnCancel_Click"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource FgMuted}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>