<Window x:Class="BA.UI.KeyplanGrid.KeyplanGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BA.UI.KeyplanGrid"
        mc:Ignorable="d"
        Title="Keyplan Grid Generator"
        Width="1520"
        Height="1460"
        MinWidth="1320"
        MinHeight="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBg}"
        Foreground="{DynamicResource Brush.WindowFg}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TopShellBorder" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource Brush.WindowBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.DarkPanelBorder}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="14,10" />
            </Style>

            <Style x:Key="BottomShellBorder" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource Brush.WindowBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.DarkPanelBorder}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <Style x:Key="ShellTitleText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource BaLabelText}">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PanelCaptionText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource BaMutedTextPanel}">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="PanelLabelText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource BaPanelText}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="InfoValueText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource BaPanelText}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SmallPanelButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource BaPanelButton}">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="PreviewHostBorder" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Panel}" />
                <Setter Property="Padding" Value="8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource TopShellBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Keyplan Grid Generator"
                               Style="{StaticResource ShellTitleText}" />
                    <TextBlock Text="Create and preview a keyplan with editable split lines, scalable output, filled regions, and outline/grid graphics."
                               Style="{StaticResource BaMutedTextDark}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Refresh Preview"
                            Style="{StaticResource BaPanelButton}"
                            Width="120"
                            Margin="0,0,8,0"
                            Click="BtnRefreshPreview_Click" />
                    <Button Content="Generate"
                            Style="{StaticResource BaPrimaryButton}"
                            Width="120"
                            Margin="0,0,8,0"
                            Click="BtnGenerate_Click" />
                    <Button Content="Cancel"
                            Style="{StaticResource BaSecondaryButton}"
                            Width="100"
                            Click="BtnCancel_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom status -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource BottomShellBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource BaMutedTextDark}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Selected cells:"
                               Style="{StaticResource BaMutedTextDark}"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SelectedCellCount}"
                               Style="{StaticResource BaLabelText}"
                               FontWeight="SemiBold" />

                    <TextBlock Text="   V splits:"
                               Style="{StaticResource BaMutedTextDark}"
                               Margin="14,0,6,0" />
                    <TextBlock Text="{Binding SelectedVerticalSplitCount}"
                               Style="{StaticResource BaLabelText}"
                               FontWeight="SemiBold" />

                    <TextBlock Text="   H splits:"
                               Style="{StaticResource BaMutedTextDark}"
                               Margin="14,0,6,0" />
                    <TextBlock Text="{Binding SelectedHorizontalSplitCount}"
                               Style="{StaticResource BaLabelText}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Margin="{StaticResource Thickness.WindowMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- Preview -->
            <Border Grid.Column="0"
                    Style="{StaticResource PreviewHostBorder}"
                    Margin="0,0,8,0">
                <local:KeyplanInteractiveCanvas x:Name="PreviewCanvas" />
            </Border>

            <!-- Right panel -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- General -->
                    <Border Style="{StaticResource BaPanelBorder}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="1. General"
                                       Style="{StaticResource BaSectionTitleText}" />
                            <TextBlock Text="View, template, and filled-region destination settings."
                                       Style="{StaticResource PanelCaptionText}" />

                            <TextBlock Text="Source View" Style="{StaticResource PanelLabelText}" />
                            <TextBox Text="{Binding SourceViewName}"
                                     IsReadOnly="True"
                                     Style="{StaticResource BaTextBox}" />

                            <TextBlock Text="Target Drafting View"
                                       Style="{StaticResource PanelLabelText}"
                                       Margin="0,8,0,4" />
                            <TextBox Text="{Binding TargetDraftingViewName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaTextBox}" />

                            <TextBlock Text="Target View Template"
                                       Style="{StaticResource PanelLabelText}"
                                       Margin="0,8,0,4" />
                            <TextBox Text="{Binding TargetViewTemplateName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaTextBox}" />

                            <TextBlock Text="Filled Region Type"
                                       Style="{StaticResource PanelLabelText}"
                                       Margin="0,8,0,4" />
                            <TextBox Text="{Binding FilledRegionTypeName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaTextBox}" />
                        </StackPanel>
                    </Border>

                    <!-- Grid + Output -->
                    <Border Style="{StaticResource BaPanelBorder}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="2. Grid + Output"
                                       Style="{StaticResource BaSectionTitleText}" />
                            <TextBlock Text="Control split lines, output graphics, and scale."
                                       Style="{StaticResource PanelCaptionText}" />

                            <TextBlock Text="Global Scale Factor"
                                       Style="{StaticResource PanelLabelText}" />
                            <TextBox Text="{Binding GlobalScaleFactor, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaTextBox}" />

                            <TextBlock Text="Examples: 1.0 = original size, 0.01 = 100× smaller, 0.003333333333 = 300× smaller."
                                       Style="{StaticResource BaMutedTextPanel}"
                                       Margin="0,4,0,8"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="1:1"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="70"
                                        Margin="0,0,8,0"
                                        Click="BtnPresetScale1_Click" />
                                <Button Content="1:100"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="80"
                                        Margin="0,0,8,0"
                                        Click="BtnPresetScale100_Click" />
                                <Button Content="1:300"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="80"
                                        Click="BtnPresetScale300_Click" />
                            </StackPanel>

                            <TextBlock Text="{Binding GlobalScaleFactorDisplay, StringFormat=Current factor: {0}}"
                                       Style="{StaticResource InfoValueText}"
                                       Margin="0,0,0,10" />

                            <CheckBox Content="Draw grid lines"
                                      IsChecked="{Binding DrawGridLines}"
                                      Style="{StaticResource BaPanelCheckBox}" />
                            <CheckBox Content="Draw outline"
                                      IsChecked="{Binding DrawOutline}"
                                      Style="{StaticResource BaPanelCheckBox}" />
                            <CheckBox Content="Create filled regions"
                                      IsChecked="{Binding CreateFilledRegions}"
                                      Style="{StaticResource BaPanelCheckBox}" />
                            <CheckBox Content="Use outline as primary fill"
                                      IsChecked="{Binding UseOutlineAsPrimaryFill}"
                                      Style="{StaticResource BaPanelCheckBox}" />
                            <CheckBox Content="Clear target view first"
                                      IsChecked="{Binding ClearTargetViewFirst}"
                                      Style="{StaticResource BaPanelCheckBox}"
                                      Margin="0,8,0,0" />
                            <CheckBox Content="Copy source view-specific elements"
                                      IsChecked="{Binding CopySourceViewSpecificElements}"
                                      Style="{StaticResource BaPanelCheckBox}" />
                        </StackPanel>
                    </Border>

                    <!-- Filled Regions -->
                    <Border Style="{StaticResource BaPanelBorder}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="3. Filled Regions"
                                       Style="{StaticResource BaSectionTitleText}" />
                            <TextBlock Text="Choose how cells are evaluated and filled."
                                       Style="{StaticResource PanelCaptionText}" />

                            <TextBlock Text="Fill Mode"
                                       Style="{StaticResource PanelLabelText}" />
                            <ComboBox ItemsSource="{Binding FillModeValues}"
                                      SelectedItem="{Binding FillMode}"
                                      Style="{StaticResource BaComboBox}" />

                            <TextBlock Text="Minimum Occupancy Ratio"
                                       Style="{StaticResource PanelLabelText}"
                                       Margin="0,8,0,4" />
                            <TextBox Text="{Binding MinimumOccupancyRatio, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaTextBox}" />
                        </StackPanel>
                    </Border>

                    <!-- Free Split Lines -->
                    <Border Style="{StaticResource BaPanelBorder}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="4. Free Split Lines"
                                       Style="{StaticResource BaSectionTitleText}" />
                            <TextBlock Text="Independent split lines behave like curtain-grid guides. Select, drag, nudge, add, and remove them freely."
                                       Style="{StaticResource PanelCaptionText}" />

                            <!-- Vertical -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedVerticalSplitCount, StringFormat=Vertical splits selected: {0}}"
                                           Style="{StaticResource BaPanelText}" />

                                <Button Grid.Column="1"
                                        Content="Add V"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="70"
                                        Margin="8,0,8,0"
                                        Click="BtnAddVerticalSplit_Click" />

                                <Button Grid.Column="2"
                                        Content="Remove V"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="90"
                                        Click="BtnRemoveVerticalSplit_Click" />
                            </Grid>

                            <!-- Horizontal -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedHorizontalSplitCount, StringFormat=Horizontal splits selected: {0}}"
                                           Style="{StaticResource BaPanelText}" />

                                <Button Grid.Column="1"
                                        Content="Add H"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="70"
                                        Margin="8,0,8,0"
                                        Click="BtnAddHorizontalSplit_Click" />

                                <Button Grid.Column="2"
                                        Content="Remove H"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="90"
                                        Click="BtnRemoveHorizontalSplit_Click" />
                            </Grid>

                            <!-- Split editing -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Delete Split"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="120"
                                        Margin="0,0,8,0"
                                        Click="BtnDeleteSplit_Click" />

                                <Button Content="◀"
                                        Style="{StaticResource SmallPanelButton}"
                                        Width="40"
                                        Margin="0,0,8,0"
                                        Click="BtnNudgeLeft_Click" />

                                <Button Content="▶"
                                        Style="{StaticResource SmallPanelButton}"
                                        Width="40"
                                        Click="BtnNudgeRight_Click" />
                            </StackPanel>

                            <Separator Margin="0,6,0,10" />

                            <!-- Zone labels -->
                            <TextBlock Text="Zone Labels"
                                       Style="{StaticResource BaSectionTitleText}" />
                            <TextBlock Text="Start a zone-pick session, assign labels to regions, and commit them to generated elements."
                                       Style="{StaticResource PanelCaptionText}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnBeginZoneLabels"
                                        Grid.Column="0"
                                        Content="Assign Zone Labels"
                                        Click="BtnBeginZoneLabels_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource BaPanelButton}"
                                        Margin="0,0,8,0" />

                                <Button x:Name="BtnCommitZoneLabels"
                                        Grid.Column="1"
                                        Content="Commit Labels"
                                        Click="BtnCommitZoneLabels_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource BaPrimaryButton}"
                                        Margin="0,0,8,0" />

                                <Button x:Name="BtnCancelZoneLabels"
                                        Grid.Column="2"
                                        Content="Cancel"
                                        Click="BtnCancelZoneLabels_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource BaSecondaryButton}"
                                        Margin="0,0,8,0" />

                                <TextBlock Grid.Column="3"
                                           Text="{Binding ZoneSessionStateLabel}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource InfoValueText}" />
                            </Grid>

                            <TextBlock Text="Zone Label Style"
                                       Style="{StaticResource PanelLabelText}" />
                            <ComboBox ItemsSource="{Binding ZoneLabelStyleValues}"
                                      SelectedItem="{Binding ZoneLabelStyle}"
                                      Style="{StaticResource BaComboBox}" />
                        </StackPanel>
                    </Border>

                    <!-- Cell Editing -->
                    <Border Style="{StaticResource BaPanelBorder}">
                        <StackPanel>
                            <TextBlock Text="5. Cell Editing"
                                       Style="{StaticResource BaSectionTitleText}" />
                            <TextBlock Text="Selected preview cells can be excluded or restored before generation."
                                       Style="{StaticResource PanelCaptionText}" />

                            <TextBlock Text="{Binding SelectedCellCount, StringFormat=Selected cells: {0}}"
                                       Style="{StaticResource InfoValueText}"
                                       Margin="0,0,0,8" />

                            <WrapPanel>
                                <Button Content="Exclude selected"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="120"
                                        Margin="0,0,8,8"
                                        Click="BtnExcludeSelected_Click" />

                                <Button Content="Include selected"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="120"
                                        Margin="0,0,8,8"
                                        Click="BtnIncludeSelected_Click" />

                                <Button Content="Include all"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="100"
                                        Margin="0,0,8,8"
                                        Click="BtnIncludeAll_Click" />

                                <Button Content="Clear selection"
                                        Style="{StaticResource BaPanelButton}"
                                        Width="110"
                                        Margin="0,0,0,8"
                                        Click="BtnClearSelection_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>