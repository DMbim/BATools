<Window x:Class="BA.UI.Views.Warnings.FamilyImportWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA | Family Standards Guard"
        Height="420" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0B0D"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#121216"/>
        <SolidColorBrush x:Key="Border" Color="#2A2A33"/>
        <SolidColorBrush x:Key="Muted" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="Danger" Color="#FF2A2A"/>
        <SolidColorBrush x:Key="DangerHot" Color="#FFFF4D4D"/>

        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#16161B"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
            <Setter Property="Foreground" Value="#0B0B0D"/>
            <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF2A2A" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="14">
            <StackPanel>
                <TextBlock Text="Family load detected"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource DangerHot}"/>
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap">
                    You’re about to load a family into the project. This guard checks BA standards and flags suspicious “downloaded monsters”.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Analysis -->
            <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Analysis" FontSize="14" FontWeight="SemiBold"/>

                    <Border Height="1" Background="{StaticResource Border}" Margin="0,10,0,10"/>

                    <TextBlock Foreground="{StaticResource Muted}" Text="File:"/>
                    <TextBlock x:Name="txtFile" Text="-" TextWrapping="Wrap" Margin="0,2,0,10"/>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Foreground="{StaticResource Muted}" Text="Size"/>
                            <TextBlock x:Name="txtSize" Text="-"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Muted}" Text="Family name"/>
                            <TextBlock x:Name="txtFamName" Text="-" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Foreground="{StaticResource Muted}" Text="Types"/>
                            <TextBlock x:Name="txtTypes" Text="-"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Muted}" Text="CAD inside family"/>
                            <TextBlock x:Name="txtCadInside" Text="-"/>
                        </StackPanel>
                    </UniformGrid>

                    <Border Height="1" Background="{StaticResource Border}" Margin="0,10,0,10"/>

                    <TextBlock Text="Flags" FontSize="14" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="lstFlags" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#33FF2A2A" Padding="10" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Options -->
            <Border Grid.Column="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="14">
                <StackPanel>
                    <TextBlock Text="Fix options" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,10" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                        Choose optional fixes. We never modify your library file — fixes are applied on a temp copy.
                    </TextBlock>

                    <CheckBox x:Name="chkAddPrefix" Content="Enforce BA_ prefix (rename in project)"/>
                    <CheckBox x:Name="chkCreateType" Content="Create default type if none exist"/>
                    <CheckBox x:Name="chkSuppressSession" Content="Don’t show again this session"/>

                    <Border Height="1" Background="{StaticResource Border}" Margin="0,14,0,14"/>

                    <TextBlock Text="Recommended threshold" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="txtThreshold" Text="-" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource BtnGhost}" Content="Cancel" IsCancel="True" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Style="{StaticResource BtnGhost}" Content="Load anyway" Margin="0,0,10,0" Click="LoadAnyway_Click"/>
            <Button Style="{StaticResource BtnDanger}" Content="Fix and Load" IsDefault="True" Click="FixAndLoad_Click"/>
        </StackPanel>
    </Grid>
</Window>
