<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="BA.UI.Views.Warnings.ImportCadWarningWindow"
        Title="BA | Avoid Import CAD"
        Height="360" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Core palette -->
        <SolidColorBrush x:Key="Bg" Color="#0B0B0D"/>
        <SolidColorBrush x:Key="Card" Color="#121216"/>
        <SolidColorBrush x:Key="Border" Color="#2A2A33"/>
        <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Muted" Color="#B8B8B8"/>

        <!-- Danger palette -->
        <SolidColorBrush x:Key="Danger" Color="#FF2A2A"/>
        <SolidColorBrush x:Key="DangerHot" Color="#FFFF4D4D"/>

        <!-- Subtle hazard stripes (tile) -->
        <DrawingBrush x:Key="HazardStripes"
                      TileMode="Tile"
                      Viewport="0,0,24,24"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,24,24"
                      ViewboxUnits="Absolute"
                      Opacity="0.18">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00000000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,24"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="{StaticResource Danger}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M -12,24 L 0,24 24,0 12,0 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="{StaticResource Danger}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M 0,24 L 12,24 36,0 24,0 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Buttons -->
        <Style x:Key="BtnBase" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#16161B"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        
        <Style x:Key="BtnCure" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="ForestGreen"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        
        <Style x:Key="BtnDanger" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF2A2A" Offset="0"/>
                        <GradientStop Color="#FFFF4D4D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#0B0B0D"/>
            <Setter Property="BorderBrush" Value="#FF2A2A"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF2A2A" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
    </Window.Resources>

    <!-- Outer shell + glow -->
    <Border CornerRadius="18"
            Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Danger}"
            BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect x:Name="OuterGlow"
                              Color="#FF2A2A"
                              BlurRadius="24"
                              ShadowDepth="0"
                              Opacity="0.38"/>
        </Border.Effect>

        <Border.Triggers>
            <!-- pulsing neon glow -->
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="OuterGlow"
                                         Storyboard.TargetProperty="BlurRadius"
                                         From="18" To="30" Duration="0:0:1.1"/>
                        <DoubleAnimation Storyboard.TargetName="OuterGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.28" To="0.55" Duration="0:0:1.1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ⭐ Custom title bar (the look you liked) -->
            <Grid Grid.Row="0" Background="#08080A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="BA | " Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                    <TextBlock Text="AVOID IMPORT CAD" Foreground="{StaticResource DangerHot}" FontWeight="Bold"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Width="34" Height="28"
                        Margin="0,0,10,0"
                        Style="{StaticResource BtnGhost}"
                        Content="✕"
                        FontWeight="Bold"
                        Click="Close_Click"/>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left danger card -->
                <Border Grid.Column="0"
                        CornerRadius="14"
                        Background="{StaticResource Card}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,14,0">
                    <Grid>
                        <Border Background="{StaticResource HazardStripes}" CornerRadius="12"/>
                        <TextBlock Text="WARNING"
                                        HorizontalAlignment="Center"
                                        FontSize="22"
                                        FontWeight="Black"
                                        Foreground="{StaticResource DangerHot}"/>
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Height="60" Margin="0,6,0,10">
                                <Grid>
                                    <Path Fill="Transparent"
                                          Stroke="{StaticResource DangerHot}"
                                          StrokeThickness="10"
                                          Data="M 50,5 L 95,90 L 5,90 Z"/>
                                    <Path Fill="{StaticResource DangerHot}"
                                          Data="M 50,28 L 56,28 55,62 45,62 Z"/>
                                    <Ellipse Fill="{StaticResource DangerHot}" Width="10" Height="10"
                                             Margin="0,66,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                </Grid>
                            </Viewbox>

                            <TextBlock Text="IMPORT"
                                       HorizontalAlignment="Center"
                                       FontSize="22"
                                       FontWeight="Black"
                                       Foreground="{StaticResource DangerHot}"/>

                            <TextBlock Text="PROHIBITED"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Muted}"/>

                            <Border Margin="0,12,0,0"
                                    CornerRadius="12"
                                    BorderBrush="#33FF2A2A"
                                    BorderThickness="1"
                                    Background="#08080A"/>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right content card -->
                <Border Grid.Column="1"
                        CornerRadius="14"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        Padding="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#121216" Offset="0"/>
                            <GradientStop Color="#0E0E12" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Import CAD detected"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Text}"/>

                            <Border Height="3" Margin="0,10,0,0" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF2A2A" Offset="0"/>
                                        <GradientStop Color="#00FF2A2A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}"><Run Text="Importing DWG/DXF embeds geometry into the model. This increases file size, slows performance, and creates cleanup problems."/></TextBlock>

                        <Border Grid.Row="2"
                                Margin="0,14,0,0"
                                Padding="12"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="#33FF2A2A">
                            <Grid>
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1A1012" Offset="0"/>
                                        <GradientStop Color="#0F0B0D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="RECOMMENDED"
                                           Foreground="{StaticResource DangerHot}"
                                           FontWeight="Black"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Top"/>

                                <TextBlock Grid.Column="1"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Muted}"><Run Text="Use “Link CAD” instead — keeps the file external, allows updates, and keeps layers controllable."/></TextBlock>
                            </Grid>
                        </Border>

                        <CheckBox x:Name="chkSuppress"
                                  Grid.Row="3"
                                  VerticalAlignment="Top"
                                  Content="Don’t show again this session (Selecting this will notify BIM Manager)" BorderBrush="#FFF10909"/>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button Style="{StaticResource BtnDanger}"
                                    Content="Continue import"
                                    Margin="0,0,10,0"
                                    Click="Continue_Click"/>
                            <Button Style="{StaticResource BtnGhost}"
                                    Content="Cancel import"
                                    IsCancel="True"
                                    Margin="0,0,10,0"
                                    Click="Cancel_Click"/>
                            <Button Style="{StaticResource BtnCure}"
                                    Content="Use Link CAD"
                                    IsDefault="True"
                                    Click="UseLinkCad_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
