<Window x:Class="BA.UI.Views.Warnings.ImportCadWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA | Avoid Import CAD"
        Height="320" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DarkButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#222226"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#17171A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
                <Setter Property="Background" Value="#1C6EA4"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#1C6EA4"/>
            </Style>

            <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
                <Setter Property="Background" Value="#1A1A1D"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#2C3440"/>
            </Style>

            <Style x:Key="BtnWarning" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
                <Setter Property="Background" Value="#3A2020"/>
                <Setter Property="Foreground" Value="#E07070"/>
                <Setter Property="BorderBrush" Value="#5A3030"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: photo panel -->
        <Border Grid.Column="0"
                Background="#0E0E12"
                BorderBrush="#2C3440"
                BorderThickness="0,0,1,0">
            <Grid>
                <Image x:Name="WarningPhoto"
                       Stretch="UniformToFill"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Center"/>
                <Border VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="10"
                        Background="#1A1A1D"
                        BorderBrush="#2C3440"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4">
                    <TextBlock Text="BA Standards Guard"
                               Foreground="#A0A8B4"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Right: content -->
        <Grid Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Import CAD detected"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#F2F2F2"/>
                <Border Height="1"
                        Background="#2C3440"
                        Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Warning message -->
            <Border Grid.Row="1"
                    Background="#161B22"
                    BorderBrush="#2C3440"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Foreground="#A0A8B4"
                               TextWrapping="Wrap"
                               FontSize="12">
                        Importing DWG/DXF embeds geometry directly into the model. This inflates file size, degrades performance, and creates cleanup problems down the line.
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#7EB8D4"
                               FontSize="12"
                               FontWeight="SemiBold">
                        Use "Link CAD" instead — keeps the file external, allows updates, and keeps layers controllable.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Suppress checkbox -->
            <CheckBox x:Name="chkSuppress"
                      Grid.Row="3"
                      Foreground="#A0A8B4"
                      FontSize="11"
                      Margin="0,0,0,14"
                      Content="Don't show again this session (BIM Manager will be notified)"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnWarning}"
                        Content="Continue import"
                        Margin="0,0,8,0"
                        Click="Continue_Click"/>
                <Button Style="{StaticResource BtnGhost}"
                        Content="Cancel"
                        IsCancel="True"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Style="{StaticResource BtnPrimary}"
                        Content="Use Link CAD"
                        IsDefault="True"
                        Click="UseLinkCad_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>