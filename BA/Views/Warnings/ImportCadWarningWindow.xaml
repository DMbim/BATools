<Window x:Class="BA.UI.Views.Warnings.ImportCadWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA | Avoid Import CAD"
        Height="360" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F0F0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0F0F0F"/>
        <SolidColorBrush x:Key="Card" Color="#161616"/>
        <SolidColorBrush x:Key="Border" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Muted" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="Accent" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentText" Color="#0F0F0F"/>

        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left image card -->
        <Border Grid.Column="0"
                Background="{StaticResource Card}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,14,0">
            <Image Stretch="Uniform"
                   Source="pack://application:,,,/BA.UI;component/Resources/NoImportCad.png"/>
        </Border>

        <!-- Right content -->
        <Border Grid.Column="1"
                Background="{StaticResource Card}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Import CAD detected"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text}"/>

                <TextBlock Grid.Row="1"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}">
                    Importing DWG/DXF embeds geometry into the model. This increases file size, slows performance,
                    and creates cleanup problems.
                </TextBlock>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="Recommended"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"/>
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}">
                        Use “Link CAD” instead — keeps the file external and allows updates and layer control.
                    </TextBlock>
                </StackPanel>

                <CheckBox x:Name="chkSuppress"
                          Grid.Row="3"
                          VerticalAlignment="Top"
                          Content="Don’t show again this session"/>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Style="{StaticResource BtnGhost}"
                            Content="Cancel import"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}"
                            Content="Use Link CAD"
                            IsDefault="True"
                            Click="UseLinkCad_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
