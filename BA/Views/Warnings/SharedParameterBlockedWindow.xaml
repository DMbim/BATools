<Window x:Class="BA.UI.Views.Warnings.SharedParameterBlockedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA | Shared Parameters Restricted"
        Height="290" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0C0F"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DarkButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#222226"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#17171A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
                <Setter Property="Background" Value="#1C6EA4"/>
                <Setter Property="Foreground" Value="#F2F2F2"/>
                <Setter Property="BorderBrush" Value="#1C6EA4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Shared parameter editing is restricted"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#F2F2F2"/>
            <Border Height="1"
                    Background="#2C3440"
                    Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#161B22"
                BorderBrush="#2C3440"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtMessage"
                           Foreground="#A0A8B4"
                           TextWrapping="Wrap"
                           FontSize="12"/>
                <TextBlock Text="Contact BIM Manager or Revit Leader."
                           Margin="0,8,0,0"
                           Foreground="#7EB8D4"
                           FontSize="12"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="TxtUser"
                   Grid.Row="2"
                   Foreground="#A0A8B4"
                   FontSize="11"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{StaticResource BtnPrimary}"
                    Content="OK"
                    IsDefault="True"
                    IsCancel="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>