<Window x:Class="BA_Tools.ScheduleExporter.Views.SchedulePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA Schedule Import — Select Schedule"
        Width="460" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Arial"
        FontSize="12">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F497D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A0A0A0"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#17365D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F2840"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header band -->
        <Border Grid.Row="0" Background="#1F497D">
            <TextBlock Text="Select Target Schedule"
                       Foreground="White"
                       FontFamily="Arial Narrow"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="14,0"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="18,14,18,0" VerticalAlignment="Top">

            <!-- Mismatch explanation -->
            <Border Background="#FFF8E0"
                    BorderBrush="#E0C040"
                    BorderThickness="1"
                    Padding="10,8"
                    Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="#806000">
                    <Run Text="Schedule "/>
                    <Run Text="{Binding MissingScheduleName, Mode=OneWay}"
                         FontWeight="Bold"/>
                    <Run Text=" was not found in the current document. Select the schedule to import into:"/>
                </TextBlock>
            </Border>

            <!-- Schedule picker -->
            <ComboBox ItemsSource="{Binding AvailableSchedules}"
                      SelectedItem="{Binding SelectedSchedule}"
                      DisplayMemberPath="Name"
                      FontFamily="Arial"
                      FontSize="12"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#F0F0F0"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="14,8">
                <Button Content="OK"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Margin="0,0,8,0"/>
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
