<Window x:Class="BA_Tools.ScheduleExporter.Views.ExportScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BA_Tools.ScheduleExporter.Helpers"
        Title="BA Schedule Exporter"
        Width="520" Height="318"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.WindowBg}"
        Foreground="{DynamicResource Brush.WindowFg}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BA;component/UI/Resources/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanConverter x:Key="InverseBool"/>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Title bar — hardcoded blue, no AccentPrimary brush in BA resources -->
        <Border DockPanel.Dock="Top"
                Background="#1F497D"
                BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <TextBlock Text="Export Schedule to Excel"
                       Style="{StaticResource BaLabelText}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="White"/>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource Brush.WindowBg}"
                BorderBrush="{StaticResource Brush.DarkPanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Export"
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource BaPrimaryButton}"
                        Width="90"
                        IsDefault="True"
                        Margin="0,0,8,0"/>
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource BaSecondaryButton}"
                        Width="80"
                        IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <StackPanel Margin="{StaticResource Thickness.WindowMargin}"
                    VerticalAlignment="Top">

            <!-- Schedule source -->
            <TextBlock Text="SCHEDULE SOURCE"
                       Style="{StaticResource BaMutedTextPanel}"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

            <!-- RadioButtons: BaPanelCheckBox has TargetType=CheckBox and cannot be
                 applied to RadioButton. Inherit window font; no explicit style needed. -->
            <RadioButton Content="{Binding ActiveScheduleLabel}"
                         IsChecked="{Binding UseActiveSchedule}"
                         IsEnabled="{Binding HasActiveSchedule}"
                         Foreground="{DynamicResource Brush.WindowFg}"
                         Margin="0,0,0,5"/>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton Grid.Column="0"
                             Content="Select schedule:"
                             IsChecked="{Binding UseActiveSchedule,
                                         Converter={StaticResource InverseBool}}"
                             Foreground="{DynamicResource Brush.WindowFg}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableSchedules}"
                          SelectedItem="{Binding SelectedSchedule}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding UseActiveSchedule,
                                      Converter={StaticResource InverseBool}}"
                          Style="{StaticResource BaComboBox}"
                          VerticalAlignment="Center"/>
            </Grid>

            <Separator Margin="0,14,0,12"
                       Background="{StaticResource Brush.PanelBorder}"/>

            <!-- Output file -->
            <TextBlock Text="OUTPUT FILE"
                       Style="{StaticResource BaMutedTextPanel}"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding OutputFilePath, Mode=OneWay}"
                         IsReadOnly="True"
                         Style="{StaticResource BaTextBox}"
                         ToolTip="{Binding OutputFilePath}"
                         Margin="0,0,6,0"/>

                <Button Grid.Column="1"
                        Content="Browse..."
                        Command="{Binding BrowseOutputFileCommand}"
                        Style="{StaticResource BaPanelButton}"/>
            </Grid>

            <!-- Status message -->
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource BaMutedTextPanel}"
                       Foreground="#CC4444"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasStatusMessage,
                                    Converter={StaticResource BoolVis}}"/>
        </StackPanel>
    </DockPanel>
</Window>
