<Window x:Class="BA_Tools.ScheduleExporter.Views.ImportResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA Schedule Import — Result"
        Width="580" Height="400"
        MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Arial"
        FontSize="12">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial Narrow"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header band -->
        <Border Grid.Row="0" Background="#1F497D">
            <TextBlock Text="Import Result"
                       Foreground="White"
                       FontFamily="Arial Narrow"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="14,0"/>
        </Border>

        <!-- Summary area -->
        <StackPanel Grid.Row="1" Margin="18,14,18,0">

            <!-- Summary message -->
            <Border Padding="10,8" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#EDF7ED"/>
                        <Setter Property="BorderBrush" Value="#80C080"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                <Setter Property="Background" Value="#FFF0F0"/>
                                <Setter Property="BorderBrush" Value="#FFBBBB"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="16" Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#x2713;"/>
                                <Setter Property="Foreground" Value="#267326"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                        <Setter Property="Text" Value="&#x26A0;"/>
                                        <Setter Property="Foreground" Value="#CC0000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding SummaryMessage}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#267326"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                        <Setter Property="Foreground" Value="#CC0000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Stat counters -->
            <Border Background="#F7F7F7"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="12,10"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Written"   Style="{StaticResource StatCaption}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Failed"    Style="{StaticResource StatCaption}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Skipped"   Style="{StaticResource StatCaption}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding SuccessCount}"
                               Style="{StaticResource StatValue}"
                               Foreground="#1F7D1F"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
           Text="{Binding FailureCount}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                <Setter Property="Foreground" Value="#777777"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                        <Setter Property="Foreground" Value="#CC0000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="{Binding SkippedCount}"
                               Style="{StaticResource StatValue}"
                               Foreground="#888888"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Error DataGrid (visible only when HasErrors = true) -->
        <Grid Grid.Row="2"
              Margin="18,0,18,8"
              Visibility="{Binding HasErrors, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="WRITE ERRORS"
                       FontFamily="Arial Narrow"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#555555"
                       Margin="0,0,0,5"/>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Errors}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      RowBackground="White"
                      AlternatingRowBackground="#FBF4F4"
                      BorderBrush="#DDDDDD"
                      BorderThickness="1"
                      HorizontalGridLinesBrush="#EEEEEE"
                      FontSize="11">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F0F0F0"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontFamily" Value="Arial Narrow"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="BorderBrush" Value="#DDDDDD"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ElementId"
                                        Binding="{Binding ElementId}"
                                        Width="80"/>
                    <DataGridTextColumn Header="Parameter"
                                        Binding="{Binding ParameterName}"
                                        Width="140"/>
                    <DataGridTextColumn Header="Attempted Value"
                                        Binding="{Binding AttemptedValue}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Error"
                                        Binding="{Binding ErrorMessage}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#CC0000"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="#F0F0F0"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="14,8">
                <Button Content="Close"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource SecondaryButton}"
                        IsDefault="True"
                        IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
