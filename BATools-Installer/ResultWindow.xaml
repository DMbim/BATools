<Window x:Class="BATools_Installer.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BATools Installer" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Black" Foreground="White">

    <StackPanel Margin="24">
        <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold"
                   Foreground="White" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Margin="0,12,0,0"
                   Foreground="White" Opacity="0.85" TextWrapping="Wrap"/>
        <Button x:Name="CloseButton" Width="110" Height="32" Margin="0,24,0,0"
                HorizontalAlignment="Right" IsDefault="True" Click="Close_Click"
                Background="#FF0A0A0A" BorderBrush="White" Foreground="#FFFFFCFC"/>
    </StackPanel>
</Window>